
{%- assign b = block.settings -%}
{%- case block.type -%}
  {%- when 'newsletter' -%}
    {%- liquid
      assign form_id = 'GadNewsletter-' | append: block.id
      assign input_id = 'GadNewsletterEmail-' | append: block.id
      assign button_label = 'newsletter.button_label' | t
      if b.button_label != blank
        assign button_label = b.button_label
      endif
    -%}
    <div class="footer-block__details-content gad-foot-news gad-foot-news--{{ b.button_style }}">
      {%- if b.text != blank -%}
        <div class="rte gad-foot-news__text">{{ b.text }}</div>
      {%- endif -%}
      {%- form 'customer', id: form_id, class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter-form__field-wrapper">
          <div class="field">
            <input
              id="{{ input_id }}"
              type="email"
              name="contact[email]"
              class="field__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="{{ form_id }}-error"
              {% elsif form.posted_successfully? %}
                aria-describedby="{{ form_id }}-success"
              {% endif %}
              placeholder="{{ 'newsletter.label' | t }}"
              required
            >
            <label class="field__label" for="{{ input_id }}">{{ 'newsletter.label' | t }}</label>
            {%- if b.button_style == 'arrow' -%}
              <button
                type="submit"
                class="newsletter-form__button field__button"
                name="commit"
                aria-label="{{ 'newsletter.button_label' | t }}"
              >
                <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
              </button>
            {%- endif -%}
          </div>
          {%- if b.button_style == 'filled' -%}
            <button type="submit" class="button gad-foot-news__button" name="commit">
              {{- button_label | escape -}}
            </button>
          {%- endif -%}
        </div>
        {%- if form.errors -%}
          <small class="newsletter-form__message form__message" id="{{ form_id }}-error">
            <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
            {{- form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email -}}
          </small>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <p class="newsletter-form__message newsletter-form__message--success form__message" id="{{ form_id }}-success" tabindex="-1">
            <span class="svg-wrapper">{{- 'icon-success.svg' | inline_asset_content -}}</span>
            {{- 'newsletter.success' | t }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>

  {%- when 'product' -%}
    {{ 'component-card.css' | asset_url | stylesheet_tag }}
    {{ 'component-price.css' | asset_url | stylesheet_tag }}
    <div class="footer-block__details-content gad-foot-card">
      {%- if b.product != blank or request.design_mode -%}
        {%- render 'card-product', card_product: b.product, media_aspect_ratio: 'square', show_secondary_image: false, placeholder_image: 'product-1' -%}
      {%- endif -%}
    </div>

  {%- when 'collection' -%}
    {{ 'component-card.css' | asset_url | stylesheet_tag }}
    <div class="footer-block__details-content gad-foot-card">
      {%- if b.collection != blank or request.design_mode -%}
        {%- render 'card-collection', card_collection: b.collection, media_aspect_ratio: 'square', columns: 1, placeholder_image: 'collection-1' -%}
      {%- endif -%}
    </div>
{%- endcase -%}
