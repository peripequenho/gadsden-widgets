      <defs>
        <linearGradient id="gad-soc-like-{{ key }}" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#18a9fe"/>
          <stop offset="1" stop-color="#0266e0"/>
        </linearGradient>
      </defs>
      <circle cx="8" cy="8" r="8" fill="url(#gad-soc-like-{{ key }})"/>
      <rect x="3.4" y="7.1" width="2.1" height="5.3" rx="0.5" fill="#fff"/>
