      <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" d="M13.6,4.8 L13.6,8.6 C7.8,9.2 4.4,13 3.4,19.4 C5.4,16.2 8.6,14.6 13.6,14.5 L13.6,18.3 L20.8,11.5 Z"/>
    </svg>
  {%- when 'dots' -%}
    <svg class="gad-soc__dots" viewBox="0 0 14 16" aria-hidden="true" focusable="false">
      <circle cx="1.75" cy="8" r="1.75"/>
      <circle cx="7" cy="8" r="1.75"/>
      <circle cx="12.25" cy="8" r="1.75"/>
    </svg>
  {%- when 'avatar' -%}
    <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id="gad-soc-avatar-{{ key }}"><circle cx="20" cy="20" r="20"/></clipPath>
      </defs>
      <g clip-path="url(#gad-soc-avatar-{{ key }})">
        <rect width="40" height="40" fill="#c9ccd1"/>
        <circle cx="20.4" cy="17.6" r="7.6" fill="#fdfdfe"/>
        <ellipse cx="20.2" cy="39.4" rx="14.8" ry="11.8" fill="#fdfdfe"/>
      </g>
    </svg>
{%- endcase -%}
