      <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" d="M7.2,10.2 L7.2,20.2 L4,20.2 C3.4,20.2 3,19.8 3,19.2 L3,11.2 C3,10.6 3.4,10.2 4,10.2 Z M7.2,10.2 L11.4,3.2 C12.7,3.2 13.6,4.4 13.3,5.7 L12.6,9.2 L18.6,9.2 C19.9,9.2 20.8,10.4 20.5,11.6 L19.1,18.6 C18.9,19.5 18.1,20.2 17.1,20.2 L7.2,20.2"/>
    </svg>
  {%- when 'cta-comment' -%}
    <svg class="gad-soc__cta-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" d="M12,4 C7,4 3,7.4 3,11.5 C3,13.6 4,15.5 5.7,16.8 L5,20.6 L8.9,18.6 C9.9,18.9 10.9,19 12,19 C17,19 21,15.6 21,11.5 C21,7.4 17,4 12,4 Z"/>
