
{%- liquid
  assign h_lh = settings.heading_line_height | default: 1.3
  assign h_ls = settings.heading_letter_spacing | default: 0.6
  assign b_lh = settings.body_line_height | default: 1.8
  assign b_ls = settings.body_letter_spacing | default: 0.6
  assign h_changed = false
  if h_lh != 1.3 or h_ls != 0.6
    assign h_changed = true
  endif
  assign b_changed = false
  if b_lh != 1.8 or b_ls != 0.6
    assign b_changed = true
  endif
-%}
{%- if h_changed or b_changed -%}
  <style>
    {%- if h_changed %}
      h1, h2, h3, h4, h5, .h0, .h1, .h2, .h3, .h4, .h5, .hxl {
        line-height: {{ h_lh }};
        letter-spacing: calc(var(--font-heading-scale) * {{ h_ls | divided_by: 10.0 }}rem);
      }
    {%- endif -%}
    {%- if b_changed %}
      body, .text-body {
        line-height: {{ b_lh }};
        letter-spacing: {{ b_ls | divided_by: 10.0 }}rem;
      }
    {%- endif %}
  </style>
{%- endif -%}
