
{%- liquid
  assign s = section.settings
  assign p = s.product
  if p == blank and request.page_type == 'product'
    assign p = product
  endif
  assign v = p.selected_or_first_available_variant
  assign img = s.image | default: p.featured_media.preview_image
-%}
{%- render 'gad-colors', s: s, key: section.id -%}
<div
  class="gad-offer gad-pad {% render 'gad-scheme', s: s, key: section.id %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="page-width">
    <div class="gad-offer__box gad-offer__box--{{ s.layout }} color-{{ s.box_scheme }}">
      <div class="gad-offer__media">
        {%- if img != blank -%}
          {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', alt: p.title, sizes: '(min-width: 990px) 45vw, 100vw', widths: '500, 800, 1200' }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'gad-offer__ph' }}
        {%- endif -%}
        {%- if s.badge != blank -%}<span class="gad-offer__badge">{{ s.badge | escape }}</span>{%- endif -%}
      </div>
      <div class="gad-offer__info">
        {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="gad-offer__points list-unstyled" role="list">
            {%- for block in section.blocks -%}
              <li class="gad-offer__point" {{ block.shopify_attributes }}>
                {%- render 'gad-icon', name: block.settings.icon, filled: true, class: 'gad-offer__tick' -%}
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <div class="gad-offer__price">
          {%- if s.price_text != blank -%}
            <span class="gad-offer__amount h2">{{ s.price_text | escape }}</span>
          {%- elsif v != blank -%}
            {%- if v.compare_at_price > v.price -%}<s class="gad-offer__compare">{{ v.compare_at_price | money }}</s>{%- endif -%}
            <span class="gad-offer__amount h2">{{ v.price | money }}</span>
          {%- endif -%}
          {%- if s.installments != blank -%}<span class="gad-offer__inst">{{ s.installments }}</span>{%- endif -%}
        </div>
        <div class="gad-offer__cta">
          {%- if p != blank -%}
            {%- render 'gad-atc-button', label: s.button_label, product: p, skip_cart: s.skip_cart -%}
          {%- elsif request.design_mode -%}
            <p class="gad-offer__note">{{ 'gadsden.offer.pick' | t }}</p>
          {%- endif -%}
        </div>
        {%- if s.guarantee_title != blank or s.guarantee_text != blank -%}
          <div class="gad-offer__guarantee">
            {%- render 'gad-icon', name: s.guarantee_icon, class: 'gad-offer__g-icon' -%}
            <div>
              {%- if s.guarantee_title != blank -%}<strong>{{ s.guarantee_title | escape }}</strong>{%- endif -%}
              {%- if s.guarantee_text != blank -%}<div class="rte">{{ s.guarantee_text }}</div>{%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .gad-offer__box {
    display: grid;
    gap: 2.4rem;
    padding: 2rem;
    border-radius: 1.6rem;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  @media screen and (min-width: 750px) {
    .gad-offer__box {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 4rem;
      padding: 3.2rem;
    }

    .gad-offer__box--image_right .gad-offer__media {
      order: 2;
    }
  }

  .gad-offer__media {
    position: relative;
  }

  .gad-offer__media img,
  .gad-offer__ph {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.2rem;
  }

  .gad-offer__ph {
    aspect-ratio: 1;
    background: rgba(var(--color-foreground), 0.06);
  }

  .gad-offer__badge {
    position: absolute;
    top: 1.2rem;
    left: 1.2rem;
    padding: 0.5rem 1.2rem;
    border-radius: 99rem;
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    font-size: 1.3rem;
    font-weight: 700;
  }

  .gad-offer__info {
    display: grid;
    gap: 1.6rem;
  }

  .gad-offer__info .gad-heading {
    margin: 0;
  }

  .gad-offer__points {
    display: grid;
    gap: 0.8rem;
    margin: 0;
  }

  .gad-offer__point {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .gad-offer__tick {
    flex: 0 0 auto;
    font-size: 2.2rem;
  }

  .gad-offer__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
  }

  .gad-offer__amount {
    margin: 0;
  }

  .gad-offer__compare {
    opacity: 0.6;
  }

  .gad-offer__inst {
    flex-basis: 100%;
    font-size: 1.4rem;
  }

  .gad-offer__cta .button {
    width: 100%;
  }

  .gad-offer__note {
    margin: 0;
    padding: 1rem;
    border: 0.1rem dashed rgba(var(--color-foreground), 0.3);
    font-size: 1.3rem;
  }

  .gad-offer__guarantee {
    display: flex;
    gap: 1rem;
    padding-top: 1.6rem;
    border-top: 0.1rem solid rgba(var(--color-foreground), 0.12);
    font-size: 1.4rem;
  }

  .gad-offer__g-icon {
    flex: 0 0 auto;
    font-size: 2.8rem;
  }

  .gad-offer__guarantee p {
    margin: 0.2rem 0 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Oferta del producto",
  "tag": "section",
  "class": "section gad-section",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Volanta",
      "info": "Texto chico arriba del título. Vacío: no se muestra."
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Color de la volanta",
      "info": "Vacío: el color del texto."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Llevalo <strong>hoy</strong>",
      "info": "Marcá en negrita las palabras que querés resaltar."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        {
          "value": "h2",
          "label": "Chico"
        },
        {
          "value": "h1",
          "label": "Mediano"
        },
        {
          "value": "h0",
          "label": "Grande"
        }
      ],
      "default": "h1"
    },
    {
      "type": "color",
      "id": "heading_accent",
      "label": "Color de las palabras resaltadas",
      "info": "Vacío: el acento de la combinación de colores."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto",
      "info": "En una ficha, vacío usa el de la página."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen",
      "info": "Vacía: la foto principal del producto."
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Etiqueta sobre la imagen",
      "info": "Ej. Envío gratis."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Imagen",
      "options": [
        {
          "value": "image_left",
          "label": "A la izquierda"
        },
        {
          "value": "image_right",
          "label": "A la derecha"
        }
      ],
      "default": "image_left"
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "Texto en lugar del precio",
      "info": "Vacío: el precio del producto. Útil mientras el precio no está definido."
    },
    {
      "type": "inline_richtext",
      "id": "installments",
      "label": "Cuotas",
      "default": "Hasta <strong>3 cuotas</strong> sin interés"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Agregar al carrito"
    },
    {
      "type": "checkbox",
      "id": "skip_cart",
      "label": "Ir directo al pago",
      "default": false
    },
    {
      "type": "header",
      "content": "Garantía"
    },
    {
      "type": "text",
      "id": "guarantee_icon",
      "label": "Ícono",
      "default": "verified_user",
      "info": "Nombre en inglés de Material Symbols."
    },
    {
      "type": "text",
      "id": "guarantee_title",
      "label": "Título",
      "default": "Garantía de satisfacción"
    },
    {
      "type": "richtext",
      "id": "guarantee_text",
      "label": "Texto",
      "default": "<p>Si no te convence, te devolvemos el dinero.</p>"
    },
    {
      "type": "color_scheme",
      "id": "box_scheme",
      "label": "Combinación de la caja",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Combinación de colores",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Colores propios"
    },
    {
      "type": "checkbox",
      "id": "custom_colors",
      "label": "Usar colores propios",
      "default": false,
