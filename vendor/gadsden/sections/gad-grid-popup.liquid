
{%- assign s = section.settings -%}
{%- render 'gad-colors', s: s, key: section.id -%}
<div
  class="gad-gp gad-pad {% render 'gad-scheme', s: s, key: section.id %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --gp-d: {{ s.columns_d }}; --gp-m: {{ s.columns_m }};"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="page-width">
    {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: s.heading_align, align_m: s.heading_align_m -%}
    <div class="gad-gp__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <button type="button" class="gad-gp__item" data-gad-dialog="GadGp-{{ block.id }}" {{ block.shopify_attributes }}>
          <span class="gad-gp__icon">
            {%- if b.thumb_image != blank -%}
              {{ b.thumb_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 80, height: 80 }}
            {%- else -%}
              {%- render 'gad-icon', name: b.thumb_icon, filled: true -%}
            {%- endif -%}
          </span>
          <span class="gad-gp__text">{{ b.thumb_text | escape }}</span>
        </button>
      {%- endfor -%}
    </div>
  </div>
  {%- for block in section.blocks -%}
    {%- liquid
      assign b = block.settings
      assign embed = ''
      if b.popup_video.type == 'youtube'
        assign embed = 'https://www.youtube-nocookie.com/embed/' | append: b.popup_video.id | append: '?autoplay=1&rel=0&playsinline=1'
      elsif b.popup_video.type == 'vimeo'
        assign embed = 'https://player.vimeo.com/video/' | append: b.popup_video.id | append: '?autoplay=1&dnt=1'
      endif
    -%}
    <dialog id="GadGp-{{ block.id }}" class="gad-gp__dialog color-{{ s.popup_scheme }}" aria-labelledby="GadGpTitle-{{ block.id }}">
      <button type="button" class="gad-gp__close" data-gad-dialog-close aria-label="{{ 'accessibility.close' | t }}">
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
      {%- if embed != '' -%}
        <div class="gad-gp__media gad-gp__media--video">
          <iframe data-src="{{ embed }}" title="{{ b.popup_title | escape }}" allow="autoplay; encrypted-media; fullscreen" allowfullscreen></iframe>
        </div>
      {%- elsif b.popup_image != blank -%}
        <div class="gad-gp__media">
          {{ b.popup_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: '', sizes: '(min-width: 800px) 800px, 100vw', widths: '400, 800, 1200' }}
        </div>
      {%- endif -%}
      <div class="gad-gp__body">
        <p id="GadGpTitle-{{ block.id }}" class="gad-gp__title h3">{{ b.popup_title | default: b.thumb_text | escape }}</p>
        {%- if b.popup_desc != blank -%}<div class="rte">{{ b.popup_desc }}</div>{%- endif -%}
      </div>
    </dialog>
  {%- endfor -%}
</div>

{% stylesheet %}
  .gad-gp__grid {
    display: grid;
    grid-template-columns: repeat(var(--gp-m, 2), minmax(0, 1fr));
    gap: 1.2rem;
  }

  @media screen and (min-width: 750px) {
    .gad-gp__grid {
      grid-template-columns: repeat(var(--gp-d, 4), minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .gad-gp__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem 1.2rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.12);
    border-radius: 0.8rem;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    font: inherit;
    text-align: center;
    cursor: pointer;
    transition: transform var(--duration-short, 0.1s) ease, box-shadow var(--duration-short, 0.1s) ease;
  }

  .gad-gp__item:hover {
    transform: translateY(-0.4rem);
    box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1);
  }

  .gad-gp__icon {
    display: grid;
    place-items: center;
    min-height: 6rem;
    font-size: 4rem;
  }

  .gad-gp__icon img {
    width: 6rem;
    height: auto;
    object-fit: contain;
  }

  .gad-gp__text {
    font-weight: var(--font-body-weight-bold, 700);
    line-height: 1.3;
  }

  .gad-gp__dialog {
    width: min(80rem, calc(100vw - 3rem));
    max-height: calc(100vh - 4rem);
    padding: 0;
    overflow: auto;
    border: 0;
    border-radius: 1.2rem;
  }

  .gad-gp__dialog::backdrop {
    background: rgba(0, 0, 0, 0.7);
  }

  .gad-gp__media {
    background: rgba(var(--color-foreground), 0.05);
  }

  .gad-gp__media img {
    display: block;
    width: 100%;
    max-height: 40rem;
    object-fit: cover;
  }

  .gad-gp__media--video {
    aspect-ratio: 16 / 9;
  }

  .gad-gp__media iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .gad-gp__body {
    padding: 2.4rem 3rem 3rem;
  }

  .gad-gp__title {
    margin: 0 0 1rem;
  }

  .gad-gp__close {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    color: #121212;
    cursor: pointer;
  }

  .gad-gp__close svg {
    width: 1.6rem;
    height: 1.6rem;
  }
{% endstylesheet %}

{% schema %}
