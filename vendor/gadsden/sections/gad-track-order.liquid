
{%- liquid
  assign s = section.settings
  assign input_id = 'GadTrack-' | append: section.id
  assign error_id = 'GadTrackError-' | append: section.id
-%}
{%- render 'gad-colors', s: s, key: section.id -%}
<div
  class="gad-track gad-pad {% render 'gad-scheme', s: s, key: section.id %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="page-width page-width--narrow gad-track__inner{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: s.heading_align, align_m: s.heading_align_m -%}
    {%- if s.mode == 'account' -%}
      <div class="gad-track__account">
        <a href="{{ routes.account_url }}" class="button{% if s.button_full_width %} button--full-width{% endif %}">
          {{- s.account_label | escape -}}
        </a>
      </div>
    {%- else -%}
      <gad-track-order data-url="{{ s.tracking_url | escape }}" data-new-tab="{{ s.new_tab }}">
        <form class="gad-track__form{% if s.button_full_width %} gad-track__form--stack{% endif %}" novalidate>
          <div class="field">
            <input
              class="field__input"
              type="text"
              id="{{ input_id }}"
              name="code"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              placeholder="{{ s.input_label | escape }}"
              aria-describedby="{{ error_id }}"
            >
            <label class="field__label" for="{{ input_id }}">{{ s.input_label | escape }}</label>
          </div>
          <button type="submit" class="button">{{ s.button_label | escape }}</button>
        </form>
        <p id="{{ error_id }}" class="gad-track__error" role="alert" hidden>{{ s.error | escape }}</p>
      </gad-track-order>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .gad-track__inner {
    max-width: 64rem;
    text-align: center;
  }

  .gad-track__form {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.4rem;
  }

  .gad-track__form .field {
    flex: 1 1 24rem;
    margin: 0;
  }

  .gad-track__form .button {
    flex: 0 0 auto;
  }

  .gad-track__form--stack .button {
    flex: 1 1 100%;
  }

  .gad-track__error {
    margin: 0.8rem 0 0;
    color: rgb(215, 44, 13);
    font-size: 1.3rem;
    text-align: left;
  }

  .gad-track__account {
    margin-top: 2.4rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Seguimiento de pedido",
  "tag": "section",
  "class": "section gad-section",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Volanta",
      "info": "Texto chico arriba del título. Vacío: no se muestra."
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Color de la volanta",
      "info": "Vacío: el color del texto."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Seguí tu <strong>pedido</strong>",
      "info": "Marcá en negrita las palabras que querés resaltar."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        {
          "value": "h2",
          "label": "Chico"
        },
        {
          "value": "h1",
          "label": "Mediano"
        },
        {
          "value": "h0",
          "label": "Grande"
        }
      ],
      "default": "h1"
    },
    {
      "type": "color",
      "id": "heading_accent",
      "label": "Color de las palabras resaltadas",
      "info": "Vacío: el acento de la combinación de colores."
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alineación del encabezado",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ],
      "info": "Volanta, título y texto de arriba."
    },
    {
      "type": "select",
      "id": "heading_align_m",
      "label": "Alineación del encabezado en mobile",
      "default": "same",
      "options": [
        {
          "value": "same",
          "label": "Igual que en desktop"
        },
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Ingresá el código de seguimiento que te enviamos cuando despachamos tu pedido.</p>"
    },
    {
      "type": "header",
      "content": "Cómo se sigue el pedido"
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Modo",
      "options": [
        {
          "value": "tracking",
          "label": "Código de seguimiento del envío"
        },
        {
          "value": "account",
          "label": "Cuenta de la tienda"
        }
      ],
      "default": "tracking",
      "info": "Shopify no muestra un pedido sólo con número y email: su estado está en la cuenta del cliente y en el enlace del mail de confirmación."
    },
    {
      "type": "text",
      "id": "tracking_url",
      "label": "Dirección del rastreador",
      "default": "https://t.17track.net/es#nums={codigo}",
      "info": "{codigo} se reemplaza por lo que escriba el comprador. Por ejemplo, la página de seguimiento de tu correo."
    },
    {
      "type": "checkbox",
      "id": "new_tab",
      "label": "Abrir el rastreador en otra pestaña",
      "default": true
    },
    {
      "type": "text",
      "id": "input_label",
      "label": "Texto del campo",
      "default": "Código de seguimiento"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Seguir mi pedido"
    },
    {
      "type": "text",
      "id": "error",
      "label": "Mensaje con el campo vacío",
      "default": "Ingresá tu código de seguimiento."
    },
    {
      "type": "text",
      "id": "account_label",
      "label": "Texto del botón en modo cuenta",
      "default": "Ver mis pedidos"
    },
    {
      "type": "checkbox",
      "id": "button_full_width",
      "label": "Botón a todo el ancho",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Combinación de colores",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Colores propios"
    },
    {
      "type": "checkbox",
      "id": "custom_colors",
      "label": "Usar colores propios",
      "default": false,
      "info": "Pisan a la combinación de colores elegida arriba."
    },
    {
      "type": "color",
      "id": "cc_bg",
      "label": "Fondo",
      "default": "#FFFFFF"
    },
    {
      "type": "color_background",
      "id": "cc_bg_gradient",
      "label": "Degradé de fondo",
      "info": "Si cargás un degradé, reemplaza al color de fondo."
    },
    {
      "type": "image_picker",
      "id": "cc_bg_image",
      "label": "Imagen de fondo",
      "info": "Cubre todo el fondo y le gana al degradé."
    },
    {
      "type": "image_picker",
      "id": "cc_bg_image_mobile",
      "label": "Imagen de fondo en mobile",
      "info": "Vacía: usa la de desktop."
    },
    {
      "type": "color",
      "id": "cc_text",
      "label": "Texto",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "cc_accent",
      "label": "Acento",
      "default": "#334FB4"
    },
    {
      "type": "color",
      "id": "cc_btn_bg",
      "label": "Fondo del botón lleno",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "cc_btn_text",
      "label": "Texto del botón lleno",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cc_outline",
      "label": "Botón de contorno y enlaces",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Relleno arriba",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Relleno abajo",
      "default": 36,
      "info": "En mobile se aplica el 75 %."
    },
    {
      "type": "header",
      "content": "Visibilidad y ancla"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Mostrar en",
      "options": [
        {
          "value": "all",
          "label": "Todos los dispositivos"
        },
        {
          "value": "mobile",
          "label": "Sólo mobile"
        },
        {
          "value": "desktop",
          "label": "Sólo desktop"
        }
      ],
      "default": "all",
      "info": "Desktop empieza en el ancho que se elige en Configuración del tema > Gadsden · Carruseles."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Nombre del ancla",
      "placeholder": "beneficios",
      "info": "Para que un botón lleve hasta acá: poné como enlace del botón #beneficios (el nombre que elegiste)."
    },
    {
      "type": "header",
      "content": "Tamaño de la letra"
    },
    {
      "type": "select",
      "id": "title_scale",
      "label": "Tamaño de los títulos",
      "options": [
        {
          "value": "70",
          "label": "70 %"
        },
        {
          "value": "80",
          "label": "80 %"
        },
        {
          "value": "90",
          "label": "90 %"
        },
        {
          "value": "100",
          "label": "Normal"
        },
        {
          "value": "110",
          "label": "110 %"
        },
        {
          "value": "125",
          "label": "125 %"
        },
        {
          "value": "150",
          "label": "150 %"
        },
        {
          "value": "175",
          "label": "175 %"
        },
        {
          "value": "200",
          "label": "200 %"
        }
      ],
      "default": "100"
    },
    {
      "type": "select",
      "id": "text_scale",
      "label": "Tamaño de los textos",
      "options": [
        {
          "value": "70",
          "label": "70 %"
        },
        {
          "value": "80",
          "label": "80 %"
        },
        {
          "value": "90",
          "label": "90 %"
        },
        {
          "value": "100",
          "label": "Normal"
        },
        {
          "value": "110",
          "label": "110 %"
        },
        {
          "value": "125",
          "label": "125 %"
        },
        {
          "value": "150",
          "label": "150 %"
        },
        {
          "value": "175",
          "label": "175 %"
        },
        {
          "value": "200",
          "label": "200 %"
        }
      ],
      "default": "100",
      "info": "Agranda o achica los títulos y los textos de esta sección respecto del tamaño global."
    }
  ],
  "presets": [
    {
      "name": "Seguimiento de pedido"
    }
  ]
}
{% endschema %}
