      "info": "En mobile el texto va siempre arriba."
    },
    {
      "type": "select",
      "id": "table_style",
      "label": "Estilo",
      "options": [
        {
          "value": "classic",
          "label": "Clásico"
        },
        {
          "value": "centered",
          "label": "Centrado"
        },
        {
          "value": "minimal",
          "label": "Minimalista"
        }
