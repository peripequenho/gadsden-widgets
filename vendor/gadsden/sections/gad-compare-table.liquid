
{%- liquid
  assign s = section.settings
  assign n = s.competitors | default: 1
  if s.table_style == 'minimal'
    assign n = 1
  endif
  assign own_label = s.own_label | replace: '{tienda}', shop.name
  if own_label == blank and s.own_logo == blank
    assign own_label = shop.name
  endif
  assign hl_class = ''
  if s.hl_style == 'scheme'
    assign hl_class = ' color-' | append: s.hl_scheme
  endif
  assign reg_class = ''
  if s.reg_style == 'scheme'
    assign reg_class = ' color-' | append: s.reg_scheme
  endif
-%}
{%- render 'gad-colors', s: s, key: section.id -%}
{%- capture check_icon -%}{%- render 'gad-icon', name: 'check', filled: true -%}{%- endcapture -%}
{%- capture cross_icon -%}{%- render 'gad-icon', name: 'close', filled: true -%}{%- endcapture -%}
{%- capture part_icon -%}{%- render 'gad-icon', name: 'remove', filled: true -%}{%- endcapture -%}
<style>
  #GadCompare-{{ section.id }} .gad-cmp-pad{padding-top:{{ s.padding_top | times: 0.75 | round }}px;padding-bottom:{{ s.padding_bottom | times: 0.75 | round }}px}
  @media(min-width:750px){#GadCompare-{{ section.id }} .gad-cmp-pad{padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px}}
  #cmp-{{ section.id }}{width:100%;max-width:90rem;margin:0 auto;border-collapse:separate;border-spacing:0;border-radius:{{ s.radius }}px;overflow:hidden;table-layout:fixed
    {%- if s.table_style == 'minimal' -%};border:1px solid rgba(var(--color-foreground),{{ s.min_line | divided_by: 100.0 }}){%- endif -%}}
  #cmp-{{ section.id }} th,#cmp-{{ section.id }} td{padding:1.4rem 1.2rem;border-bottom:1px solid rgba(var(--color-foreground),{{ s.reg_separator | divided_by: 100.0 }});vertical-align:middle}
  #cmp-{{ section.id }} tr:last-child td{border-bottom:0}
  #cmp-{{ section.id }} th{font-weight:700;text-align:center}
  #cmp-{{ section.id }} th:first-child,#cmp-{{ section.id }} td:first-child{text-align:{{ s.m_align | default: 'left' }};width:46%}
  #cmp-{{ section.id }} td:not(:first-child){text-align:center}
  {%- if s.hl_style == 'custom' %}
  #cmp-{{ section.id }} .cmp__us{background:{{ s.hl_bg }};color:{{ s.hl_text }}}
  {%- endif %}
  {%- if s.reg_style == 'custom' %}
  #cmp-{{ section.id }} .cmp__other{background:{{ s.reg_bg }};color:{{ s.reg_text }}}
  {%- endif %}
  #cmp-{{ section.id }} .cmp__logo{max-width:{{ s.own_logo_width_m }}px;height:auto;display:inline-block}
  #cmp-{{ section.id }} .cmp__logo--other{max-width:{{ s.c1_logo_width_m }}px}
  #cmp-{{ section.id }} .cmp__label{font-size:{{ s.own_size | times: 0.85 }}px;display:block}
  #cmp-{{ section.id }} .cmp__label--other{font-size:{{ s.c1_size | times: 0.85 }}px}
  #cmp-{{ section.id }} .cmp__ic{display:inline-grid;place-items:center;width:2.8rem;height:2.8rem;border-radius:50%}
  #cmp-{{ section.id }} .cmp__ic .gad-icon{font-size:1.8rem;font-variation-settings:'FILL' 1,'wght' 700,'GRAD' 0,'opsz' 24}
  #cmp-{{ section.id }} .cmp__ic--yes{background:{{ s.check_bg }};color:{{ s.check_color }}}
  #cmp-{{ section.id }} .cmp__ic--part{background:{{ s.partial_color | default: s.check_bg }};color:{{ s.check_color }}}
  {% if s.check_style == 'simple' %}#cmp-{{ section.id }} .cmp__ic--yes{background:transparent;color:{{ s.check_bg }}}#cmp-{{ section.id }} .cmp__ic--yes .gad-icon{font-size:2.6rem}{% endif %}
  #cmp-{{ section.id }} .cmp__us{box-shadow:inset 0 0 0 100vmax rgba(0,0,0,{{ s.hl_zebra | divided_by: 100.0 }})}
  #cmp-{{ section.id }} .cmp__other{box-shadow:inset 0 0 0 100vmax rgba(0,0,0,{{ s.reg_zebra | divided_by: 100.0 }})}
  #cmp-{{ section.id }} td.cmp__us{border-bottom-color:rgba(255,255,255,{{ s.hl_separator | divided_by: 100.0 }})}
  {% if s.table_style == 'classic' %}#cmp-{{ section.id }} thead th{border-bottom:2px solid rgba(var(--color-foreground),.2)}#cmp-{{ section.id }}{border:0}{% endif %}
  {% if s.cross_style == 'simple' %}#cmp-{{ section.id }} .cmp__ic--no{background:transparent;color:{{ s.cross_bg }}}#cmp-{{ section.id }} .cmp__ic--no .gad-icon{font-size:2.6rem}{% endif %}
  #cmp-{{ section.id }} .cmp__ic--no{background:{{ s.cross_bg }};color:{{ s.cross_color }}}
  {% if s.inverted %}
  #cmp-{{ section.id }} .cmp__other .cmp__ic--yes{background:{{ s.cross_bg }};color:{{ s.cross_color }}}
  #cmp-{{ section.id }} .cmp__other .cmp__ic--no{background:{{ s.check_bg }};color:{{ s.check_color }}}
  {% endif %}
  #cmp-{{ section.id }} .cmp__feature{font-weight:700}
  @media(min-width:750px){
    #cmp-{{ section.id }} th:first-child,#cmp-{{ section.id }} td:first-child{text-align:{{ s.align | default: 'left' }}}
    #cmp-{{ section.id }} .cmp__logo{max-width:{{ s.own_logo_width_d }}px}
    #cmp-{{ section.id }} .cmp__logo--other{max-width:{{ s.c1_logo_width_d }}px}
    #cmp-{{ section.id }} .cmp__label{font-size:{{ s.own_size }}px}
    #cmp-{{ section.id }} .cmp__label--other{font-size:{{ s.c1_size }}px}
  }
  #GadCompare-{{ section.id }} .cmp__footer{text-align:center;margin-top:2.4rem}
  #GadCompare-{{ section.id }} .cmp__footer .gad-buttons{justify-content:center}
</style>
<div id="GadCompare-{{ section.id }}" class="{% render 'gad-scheme', s: s, key: section.id %}" {% render 'gad-section-attrs', s: s %}>
  <div class="page-width gad-cmp-pad">
    {%- capture cmp_heading -%}
      {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: 'center' -%}
    {%- endcapture -%}
    {%- if s.position != 'first' -%}{{ cmp_heading }}{%- endif -%}
    <table id="cmp-{{ section.id }}" class="cmp cmp--{{ s.table_style }}">
      <thead>
        <tr>
          <th class="cmp__other{{ reg_class }}">
            {%- if s.feature_label != blank -%}<span class="cmp__feature">{{ s.feature_label | escape }}</span>{%- else -%}<span class="visually-hidden">{{ 'gadsden.compare.benefit' | t }}</span>{%- endif -%}
          </th>
          <th class="cmp__us{{ hl_class }}">
            {%- if s.own_logo != blank -%}{{ s.own_logo | image_url: width: 300 | image_tag: class: 'cmp__logo', loading: 'lazy', alt: own_label }}{%- endif -%}
            {%- if own_label != blank -%}<span class="cmp__label">{{ own_label }}</span>{%- endif -%}
          </th>
          {%- for i in (1..n) -%}
            {%- liquid
              assign k_label = 'c' | append: i | append: '_label'
              assign k_logo = 'c' | append: i | append: '_logo'
            -%}
            <th class="cmp__other{{ reg_class }}">
              {%- if s[k_logo] != blank -%}{{ s[k_logo] | image_url: width: 300 | image_tag: class: 'cmp__logo cmp__logo--other', loading: 'lazy', alt: s[k_label] }}{%- endif -%}
              {%- if s[k_label] != blank -%}<span class="cmp__label cmp__label--other">{{ s[k_label] }}</span>{%- endif -%}
            </th>
          {%- endfor -%}
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <tr {{ block.shopify_attributes }}>
            <td class="cmp__other{{ reg_class }}">{{ b.benefit }}</td>
            <td class="cmp__us{{ hl_class }}">
              {%- if b.own and b.own_partial -%}
                <span class="cmp__ic cmp__ic--part">{{ part_icon }}<span class="visually-hidden">{{ 'gadsden.compare.partial' | t }}</span></span>
              {%- elsif b.own -%}
                <span class="cmp__ic cmp__ic--yes">{{ check_icon }}<span class="visually-hidden">{{ 'gadsden.compare.yes' | t }}</span></span>
              {%- else -%}
                <span class="cmp__ic cmp__ic--no">{{ cross_icon }}<span class="visually-hidden">{{ 'gadsden.compare.no' | t }}</span></span>
              {%- endif -%}
            </td>
            {%- for i in (1..n) -%}
              {%- assign k_val = 'c' | append: i -%}
              {%- assign k_partial = 'c' | append: i | append: '_partial' -%}
              <td class="cmp__other{{ reg_class }}">
                {%- if b[k_val] and b[k_partial] -%}
                  <span class="cmp__ic cmp__ic--part">{{ part_icon }}<span class="visually-hidden">{{ 'gadsden.compare.partial' | t }}</span></span>
                {%- elsif b[k_val] -%}
                  <span class="cmp__ic cmp__ic--yes">{{ check_icon }}<span class="visually-hidden">{{ 'gadsden.compare.yes' | t }}</span></span>
                {%- else -%}
                  <span class="cmp__ic cmp__ic--no">{{ cross_icon }}<span class="visually-hidden">{{ 'gadsden.compare.no' | t }}</span></span>
                {%- endif -%}
              </td>
            {%- endfor -%}
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
    {%- if s.position == 'first' -%}<div style="margin-top:2.4rem">{{ cmp_heading }}</div>{%- endif -%}
    {%- if s.button_label != blank or s.atc_label != blank -%}
      <div class="cmp__footer">
        <div class="gad-buttons">
          {%- if s.button_label != blank -%}
            <a {% if s.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ s.button_link }}"{% endif %} class="button{% if s.button_outline %} button--secondary{% endif %}">{{ s.button_label | escape }}</a>
          {%- endif -%}
          {%- render 'gad-atc-button', label: s.atc_label, product: s.atc_product, skip_cart: s.atc_skip_cart -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Tabla comparativa",
  "tag": "section",
  "class": "section gad-section",
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Volanta",
      "info": "Texto chico arriba del título. Vacío: no se muestra."
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Color de la volanta",
      "info": "Vacío: el color del texto."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "¿Por qué elegirnos?",
      "info": "Marcá en negrita las palabras que querés resaltar."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        {
          "value": "h2",
          "label": "Chico"
        },
        {
          "value": "h1",
          "label": "Mediano"
        },
        {
          "value": "h0",
          "label": "Grande"
        }
      ],
      "default": "h1"
    },
    {
      "type": "color",
      "id": "heading_accent",
      "label": "Color de las palabras resaltadas",
      "info": "Vacío: el acento de la combinación de colores."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "info": "Sin texto, el botón no aparece."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "checkbox",
      "id": "button_outline",
      "label": "Botón con contorno",
      "default": false
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Texto del botón de agregar al carrito",
      "info": "Sin texto, el botón no aparece. En una ficha agrega ese producto con la variante y la cantidad elegidas."
    },
    {
      "type": "product",
      "id": "atc_product",
      "label": "Producto",
      "info": "Opcional. Si elegís uno, el botón agrega ése. Fuera de una ficha hace falta elegirlo."
    },
    {
      "type": "checkbox",
      "id": "atc_skip_cart",
      "label": "Ir directo al pago",
      "default": false
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alineación en desktop",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "m_align",
      "label": "Alineación en mobile",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Combinación de colores",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Colores propios"
    },
    {
      "type": "checkbox",
      "id": "custom_colors",
      "label": "Usar colores propios",
      "default": false,
      "info": "Pisan a la combinación de colores elegida arriba."
    },
    {
      "type": "color",
      "id": "cc_bg",
      "label": "Fondo",
      "default": "#FFFFFF"
    },
    {
      "type": "color_background",
      "id": "cc_bg_gradient",
      "label": "Degradé de fondo",
      "info": "Si cargás un degradé, reemplaza al color de fondo."
    },
    {
      "type": "image_picker",
      "id": "cc_bg_image",
      "label": "Imagen de fondo",
      "info": "Cubre todo el fondo y le gana al degradé."
    },
    {
      "type": "image_picker",
      "id": "cc_bg_image_mobile",
      "label": "Imagen de fondo en mobile",
      "info": "Vacía: usa la de desktop."
    },
    {
      "type": "color",
      "id": "cc_text",
      "label": "Texto",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "cc_accent",
      "label": "Acento",
      "default": "#334FB4"
    },
    {
      "type": "color",
      "id": "cc_btn_bg",
      "label": "Fondo del botón lleno",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "cc_btn_text",
      "label": "Texto del botón lleno",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cc_outline",
      "label": "Botón de contorno y enlaces",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Tabla"
    },
    {
      "type": "paragraph",
      "content": "Sin título, texto ni botones se ve sólo la tabla, centrada. En mobile el texto va siempre arriba."
    },
    {
      "type": "select",
      "id": "position",
      "label": "Posición en desktop",
      "options": [
        {
          "value": "first",
          "label": "Tabla primero"
        },
        {
          "value": "second",
          "label": "Tabla segundo"
        },
        {
          "value": "top",
