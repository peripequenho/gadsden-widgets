
{%- assign s = section.settings -%}
{%- render 'gad-colors', s: s, key: section.id -%}
<div
  class="gad-plans gad-pad {% render 'gad-scheme', s: s, key: section.id %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --plans-d: {{ section.blocks.size | at_most: s.columns_d | at_least: 1 }};"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="page-width">
    {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: s.heading_align, align_m: s.heading_align_m -%}
    <div class="gad-plans__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign p = b.product
          assign scheme = s.card_scheme
          assign outline = true
          if b.highlight
            assign scheme = s.highlight_scheme
            assign outline = false
          endif
          assign lines = b.features | newline_to_br | split: '<br />'
        -%}
        <div class="gad-plans__card color-{{ scheme }}{% if b.highlight %} gad-plans__card--hl{% endif %}" role="listitem" {{ block.shopify_attributes }}>
          {%- if b.badge != blank -%}<span class="gad-plans__badge">{{ b.badge | escape }}</span>{%- endif -%}
          {%- if b.image != blank -%}
            <div class="gad-plans__img">{{ b.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: '', sizes: '(min-width: 990px) 25vw, 80vw', widths: '300, 600' }}</div>
          {%- endif -%}
          <h3 class="gad-plans__name h4">{{ b.name | escape }}</h3>
          <p class="gad-plans__price">
            {%- if b.compare_price != blank -%}
              <s class="gad-plans__compare">{{ b.compare_price | escape }}</s>
            {%- elsif p != blank and p.compare_at_price > p.price -%}
              <s class="gad-plans__compare">{{ p.compare_at_price | money }}</s>
            {%- endif -%}
            <span class="gad-plans__amount h2">
              {%- if b.price != blank -%}{{ b.price | escape }}{%- elsif p != blank -%}{{ p.price | money }}{%- endif -%}
            </span>
            {%- if b.period != blank -%}<span class="gad-plans__period">{{ b.period | escape }}</span>{%- endif -%}
          </p>
          {%- if b.installments != blank -%}<p class="gad-plans__inst">{{ b.installments }}</p>{%- endif -%}
          {%- if b.description != blank -%}<div class="gad-plans__desc rte">{{ b.description }}</div>{%- endif -%}
          {%- if b.features != blank -%}
            <ul class="gad-plans__features list-unstyled" role="list">
              {%- for line in lines -%}
                {%- assign f = line | strip -%}
                {%- if f == blank -%}{%- continue -%}{%- endif -%}
                {%- assign first = f | slice: 0 -%}
                {%- if first == '-' -%}
                  <li class="gad-plans__feature gad-plans__feature--off">
                    {%- render 'gad-icon', name: 'close' -%}<span>{{ f | remove_first: '-' | strip }}</span>
                  </li>
                {%- else -%}
                  <li class="gad-plans__feature">{%- render 'gad-icon', name: 'check', class: 'gad-plans__check' -%}<span>{{ f }}</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <div class="gad-plans__cta">
            {%- if p != blank -%}
              {%- render 'gad-atc-button', label: b.button_label, product: p, secondary: outline -%}
            {%- elsif b.button_label != blank -%}
              <a href="{{ b.button_link | default: '#' }}" class="button{% unless b.highlight %} button--secondary{% endunless %}">{{ b.button_label | escape }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .gad-plans__grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 82%;
    gap: 1.6rem;
    align-items: stretch;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 1.6rem 0.2rem;
  }

  .gad-plans__grid::-webkit-scrollbar {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .gad-plans__grid {
      grid-auto-flow: row;
      grid-template-columns: repeat(var(--plans-d, 3), minmax(0, 1fr));
      max-width: calc(var(--plans-d, 3) * 38rem);
      margin-inline: auto;
      overflow: visible;
    }
  }

  .gad-plans__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: 2.8rem 2.4rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.15);
    border-radius: 1.2rem;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    scroll-snap-align: center;
  }

  .gad-plans__card--hl {
    border-color: rgb(var(--color-button));
    box-shadow: 0 1rem 3rem rgba(var(--color-shadow), 0.12);
  }

  @media screen and (min-width: 750px) {
    .gad-plans__card--hl {
      transform: scale(1.03);
    }
  }

  .gad-plans__badge {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% -50%;
    padding: 0.4rem 1.2rem;
    border-radius: 99rem;
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    font-size: 1.2rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .gad-plans__name,
  .gad-plans__price {
    margin: 0;
  }

  .gad-plans__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
  }

  .gad-plans__amount {
    margin: 0;
  }

  .gad-plans__compare,
  .gad-plans__period {
    font-size: 1.4rem;
    opacity: 0.7;
  }

  .gad-plans__img img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 18rem;
    object-fit: contain;
  }

  .gad-plans__inst {
    margin: -0.6rem 0 0;
    font-size: 1.3rem;
  }

  .gad-plans__desc p {
    margin: 0;
  }

  .gad-plans__features {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    font-size: 1.4rem;
  }

  .gad-plans__feature {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
  }

  .gad-plans__feature .gad-icon {
    flex: 0 0 auto;
    font-size: 2rem;
  }

  .gad-plans__check {
    color: rgb(var(--color-accent, var(--color-button)));
  }

  .gad-plans__feature--off {
    opacity: 0.5;
  }

  .gad-plans__cta {
    margin-top: auto;
    padding-top: 0.8rem;
  }

  .gad-plans__cta .button,
  .gad-plans__cta .gad-atc {
    width: 100%;
  }
{% endstylesheet %}

