
{%- assign s = section.settings -%}
{%- render 'gad-colors', s: s, key: section.id -%}
<gad-parallax
  class="gad-px gad-pad {% render 'gad-scheme', s: s, key: section.id %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --px-h: {{ s.min_height }}vh; --px-ov: {{ s.overlay | divided_by: 100.0 }};"
  data-intensity="{{ s.intensity }}"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="gad-px__stage" aria-hidden="true">
    {%- if s.bg_image != blank -%}
      <div class="gad-px__layer gad-px__bg" data-depth="1">
        {{ s.bg_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', alt: '', sizes: '100vw', widths: '750, 1100, 1500, 1900, 2400' }}
      </div>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <div
        class="gad-px__layer gad-px__item{% if b.hide_mobile %} gad-px__item--desk{% endif %}"
        data-depth="{{ b.depth }}"
        style="--x: {{ b.x }}%; --y: {{ b.y }}%; --w: {{ b.width }}%;"
        {{ block.shopify_attributes }}
      >
        {%- if b.image != blank -%}
          {{ b.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: '', sizes: '50vw', widths: '400, 800, 1200' }}
        {%- elsif request.design_mode -%}
          {{ 'image' | placeholder_svg_tag: 'gad-px__ph' }}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  <div class="gad-px__content page-width gad-px__content--{{ s.align }}">
    {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: s.align -%}
    {%- if s.button_label != blank or s.button_label_2 != blank -%}
      <div class="gad-px__buttons">
        {%- if s.button_label != blank -%}<a href="{{ s.button_link | default: '#' }}" class="button">{{ s.button_label | escape }}</a>{%- endif -%}
        {%- if s.button_label_2 != blank -%}<a href="{{ s.button_link_2 | default: '#' }}" class="button button--secondary">{{ s.button_label_2 | escape }}</a>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</gad-parallax>

{% stylesheet %}
  gad-parallax {
    position: relative;
    display: grid;
    align-items: center;
    min-height: var(--px-h, 80vh);
    overflow: hidden;
    isolation: isolate;
  }

  .gad-px__stage {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .gad-px__stage::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(var(--color-background));
    opacity: var(--px-ov, 0);
  }

  .gad-px__layer {
    position: absolute;
    transition: transform 0.2s ease-out;
    will-change: transform;
  }

  .gad-px__bg {
    inset: -4%;
  }

  .gad-px__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gad-px__item {
    top: var(--y);
    left: var(--x);
    width: var(--w);
    translate: -50% -50%;
    z-index: 1;
  }

  .gad-px__item img,
  .gad-px__ph {
    display: block;
    width: 100%;
    height: auto;
  }

  .gad-px__ph {
    aspect-ratio: 1;
    background: rgba(var(--color-foreground), 0.06);
  }

  @media screen and (max-width: 749px) {
    .gad-px__item--desk {
      display: none;
    }
  }

  .gad-px__content {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .gad-px__content--center {
    text-align: center;
  }

  .gad-px__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.4rem;
  }

  .gad-px__content--center .gad-px__buttons {
    justify-content: center;
  }
{% endstylesheet %}

{% javascript %}
  class GadParallax extends HTMLElement {
    connectedCallback() {
      if (this._ready || !window.matchMedia('(hover: hover)').matches) return;
      this._ready = true;
      this.layers = Array.from(this.querySelectorAll('.gad-px__layer'));
      this.k = parseFloat(this.dataset.intensity) || 20;
      this.addEventListener('pointermove', (e) => {
        if (window.Gadsden && Gadsden.reduceMotion()) return;
        const r = this.getBoundingClientRect();
        const nx = ((e.clientX - r.left) / r.width - 0.5) * 2;
        const ny = ((e.clientY - r.top) / r.height - 0.5) * 2;
        cancelAnimationFrame(this.raf);
        this.raf = requestAnimationFrame(() => this.move(nx, ny));
      });
      this.addEventListener('pointerleave', () => this.move(0, 0));
    }

    move(nx, ny) {
      this.layers.forEach((el) => {
        const d = (parseFloat(el.dataset.depth) || 0) / 10;
        el.style.transform = `translate3d(${(-nx * d * this.k).toFixed(1)}px, ${(-ny * d * this.k).toFixed(1)}px, 0)`;
      });
    }
  }

  if (!customElements.get('gad-parallax')) customElements.define('gad-parallax', GadParallax);
{% endjavascript %}

