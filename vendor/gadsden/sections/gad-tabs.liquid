
{%- liquid
  assign s = section.settings
  case s.width
    when 'xs'
      assign tabs_max = '60%'
    when 's'
      assign tabs_max = '80%'
    when 'm'
      assign tabs_max = '100%'
    else
      assign tabs_max = 'none'
  endcase
-%}
{%- render 'gad-colors', s: s, key: section.id -%}
<style>
  #GadTabs-{{ section.id }} .gad-tabs-pad{padding-top:{{ s.padding_top | times: 0.75 | round }}px;padding-bottom:{{ s.padding_bottom | times: 0.75 | round }}px}
  @media(min-width:750px){#GadTabs-{{ section.id }} .gad-tabs-pad{padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px}}
  #tabs-{{ section.id }}{max-width:{{ tabs_max }};margin:0 auto}
  {% if s.nav_style == 'shadow' %}#tabs-{{ section.id }} .tabs__btn{border-color:transparent;box-shadow:0 2px 10px rgba(0,0,0,.12)}{% endif %}
  {% if s.active_style == 'slide' %}#tabs-{{ section.id }} .tabs__btn.is-active{transform:translateY(-2px)}{% else %}#tabs-{{ section.id }} .tabs__btn{opacity:.55}#tabs-{{ section.id }} .tabs__btn.is-active{opacity:1}{% endif %}
  #tabs-{{ section.id }} .tabs__nav{display:flex;flex-wrap:wrap;gap:1rem;justify-content:center;margin-bottom:2.4rem}
  {% if s.layout == 'vertical' %}@media(min-width:990px){#tabs-{{ section.id }}{display:grid;grid-template-columns:22rem 1fr;gap:3rem}#tabs-{{ section.id }} .tabs__nav{flex-direction:column;margin:0}}{% endif %}
  #tabs-{{ section.id }} .tabs__btn{font-size:{{ s.font_size_m }}px;font-weight:600;padding:1rem 1.8rem;border-radius:{{ s.button_radius }}px;cursor:pointer;display:inline-flex;align-items:center;gap:.6rem;transition:background .2s,color .2s;
    --tab-bg:{% if s.custom_buttons %}{{ s.button_color }}{% else %}rgb(var(--color-button)){% endif %};--tab-fg:{% if s.custom_buttons %}{{ s.button_active_text }}{% else %}rgb(var(--color-button-text)){% endif %};
    {%- if s.nav_style == 'solid' -%}background:var(--tab-bg);color:var(--tab-fg);border:2px solid var(--tab-bg);opacity:.75{%- else -%}background:transparent;color:var(--tab-bg);border:2px solid var(--tab-bg){%- endif -%}}
  #tabs-{{ section.id }} .tabs__btn.is-active{background:var(--tab-bg);color:var(--tab-fg);opacity:1}
  #tabs-{{ section.id }} .tabs__btn .gad-icon{font-size:20px}
  {% if s.stretch_m %}@media(max-width:749px){#tabs-{{ section.id }} .tabs__btn{flex:1 1 100%;justify-content:center}}{% endif %}
  @media(min-width:750px){#tabs-{{ section.id }} .tabs__btn{font-size:{{ s.font_size_d }}px}{% if s.stretch_d %}#tabs-{{ section.id }} .tabs__btn{flex:1}{% endif %}}
  #tabs-{{ section.id }} .tabs__panel{display:none}
  #tabs-{{ section.id }} .tabs__panel.is-active{display:grid;gap:2.4rem;align-items:center}
  #tabs-{{ section.id }} .tabs__panel.has-media{grid-template-columns:1fr}
  @media(min-width:990px){#tabs-{{ section.id }} .tabs__panel.has-media.w-half{grid-template-columns:1fr 1fr}#tabs-{{ section.id }} .tabs__panel.has-media.w-half.media-second .tabs__media{order:2}}
  #tabs-{{ section.id }} .tabs__media img,#tabs-{{ section.id }} .tabs__media video{width:100%;height:auto;border-radius:var(--media-radius);display:block}
  #tabs-{{ section.id }} .tabs__body{text-align:center}
  #tabs-{{ section.id }} .tabs__body.left{text-align:left}#tabs-{{ section.id }} .tabs__body.right{text-align:right}
  @media(max-width:989px){#tabs-{{ section.id }} .tabs__body.mobile-left{text-align:left}#tabs-{{ section.id }} .tabs__body.mobile-center{text-align:center}#tabs-{{ section.id }} .tabs__body.mobile-right{text-align:right}#tabs-{{ section.id }} .tabs__panel.m-media-second .tabs__media{order:2}}
  #tabs-{{ section.id }} .tabs__title{margin:0 0 1.2rem}
  #tabs-{{ section.id }} .tabs__title strong{color:var(--tab-hl)}
  #tabs-{{ section.id }} .tabs__cta{margin-top:1.6rem}
</style>
<div id="GadTabs-{{ section.id }}" class="{% render 'gad-scheme', s: s, key: section.id %}" {% render 'gad-section-attrs', s: s %}>
  <div class="page-width gad-tabs-pad">
    {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: s.heading_align, align_m: s.heading_align_m -%}
    <div id="tabs-{{ section.id }}" class="tabs">
      <div class="tabs__nav" role="tablist">
        {%- for block in section.blocks -%}
          <button type="button" role="tab" class="tabs__btn{% if forloop.first %} is-active{% endif %}" aria-selected="{{ forloop.first }}" aria-controls="panel-{{ block.id }}" data-tab="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}{%- render 'gad-icon', name: block.settings.icon, filled: block.settings.icon_filled -%}{%- endif -%}
            {{ block.settings.label }}
          </button>
        {%- endfor -%}
      </div>
      <div class="tabs__panels">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign has_media = false
            if b.image != blank or b.video != blank
              assign has_media = true
            endif
          -%}
          <div id="panel-{{ block.id }}" role="tabpanel" class="tabs__panel{% if forloop.first %} is-active{% endif %}{% if has_media %} has-media{% endif %}{% if b.media_width == 'half' %} w-half{% endif %}{% if b.media_position == 'second' %} media-second{% endif %}{% if b.m_media_position == 'second' %} m-media-second{% endif %}" style="--tab-hl:{{ b.title_accent | default: 'inherit' }}">
            {%- if has_media -%}
              <div class="tabs__media">
                {%- if b.video != blank -%}
                  {{ b.video | video_tag: image_size: '1100x', loop: b.loop, muted: b.autoplay, autoplay: b.autoplay, playsinline: true, controls: true }}
                {%- else -%}
                  {{ b.image | image_url: width: 1500 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw' }}
                {%- endif -%}
              </div>
            {%- endif -%}
            <div class="tabs__body {{ b.align | default: 'center' }} mobile-{{ b.m_align | default: 'center' }}">
              {%- if b.title != blank -%}<h3 class="tabs__title {{ b.title_size | default: 'h1' }}">{{ b.title }}</h3>{%- endif -%}
              {%- if b.text != blank -%}<div class="rte">{{ b.text }}</div>{%- endif -%}
              {%- if b.button_label != blank -%}<div class="tabs__cta"><a {% if b.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ b.button_link }}"{% endif %} class="button{% if b.button_outline %} button--secondary{% endif %}">{{ b.button_label | escape }}</a></div>{%- endif -%}
              {%- if b.atc_label != blank and b.atc_product != blank -%}<div class="tabs__cta">{%- render 'gad-atc-button', label: b.atc_label, product: b.atc_product, skip_cart: b.atc_skip_cart -%}</div>{%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
<script>
  (function () {
    var root = document.getElementById('tabs-{{ section.id }}');
    if (!root) return;
    root.addEventListener('click', function (e) {
      var btn = e.target.closest('.tabs__btn');
      if (!btn) return;
      var i = btn.dataset.tab;
      root.querySelectorAll('.tabs__btn').forEach(function (b, j) { var on = String(j) === i; b.classList.toggle('is-active', on); b.setAttribute('aria-selected', on); });
      root.querySelectorAll('.tabs__panel').forEach(function (p, j) { p.classList.toggle('is-active', String(j) === i); });
    });
  })();
</script>

