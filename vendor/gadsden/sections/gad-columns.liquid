
{%- assign s = section.settings -%}
{%- render 'gad-colors', s: s, key: section.id -%}
<div
  class="gad-cols gad-pad {% render 'gad-scheme', s: s, key: section.id %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --cols-gap: {{ s.gap }}px;"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="{% if s.full_width %}gad-full-width{% else %}page-width{% endif %}">
    {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: s.heading_align, align_m: s.heading_align_m -%}
    <div class="gad-cols__grid gad-cols__grid--{{ s.valign }}">
      {%- liquid
        assign open = false
        for block in section.blocks
          if block.type == 'column'
            if open
              echo '</div>'
            endif
            assign c = block.settings
            assign col_class = 'gad-cols__col gad-cols__col--' | append: c.align
            if c.boxed
              assign col_class = col_class | append: ' gad-cols__col--boxed color-' | append: c.color_scheme
            endif
            echo '<div class="' | append: col_class | append: '" style="--col-w: ' | append: c.width | append: ';" ' | append: block.shopify_attributes | append: '>'
            assign open = true
            continue
          endif
          unless open
            echo '<div class="gad-cols__col gad-cols__col--left" style="--col-w: 1;">'
            assign open = true
          endunless
          render 'gad-column-block', block: block, section: section
        endfor
        if open
          echo '</div>'
        endif
      -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .gad-cols__grid {
    display: flex;
    flex-direction: column;
    gap: var(--cols-gap, 30px);
  }

  @media screen and (min-width: 750px) {
    .gad-cols__grid {
      flex-direction: row;
    }

    .gad-cols__grid--center {
      align-items: center;
    }

    .gad-cols__grid--top {
      align-items: flex-start;
    }

    .gad-cols__grid--stretch {
      align-items: stretch;
    }

    .gad-cols__col {
      flex: var(--col-w, 1) 1 0;
      min-width: 0;
    }
  }

  .gad-cols__col--center {
    text-align: center;
  }

  .gad-cols__col--right {
    text-align: right;
  }

  .gad-cols__col--boxed {
    padding: 2.4rem;
    border-radius: 1.2rem;
  }

  .gad-cols__item + .gad-cols__item {
    margin-top: 1.6rem;
  }

  .gad-cols__col > .gad-cols__item:first-child {
    margin-top: 0;
  }

  .gad-cols__item.accordion + .gad-cols__item.accordion {
    margin-top: 0;
    border-top: none;
  }

  .gad-cols .list-payment {
    justify-content: flex-start;
    margin: -0.5rem;
    padding-top: 0;
  }

  .gad-cols__col--center .list-payment {
    justify-content: center;
  }

  .gad-cols__col--right .list-payment {
    justify-content: flex-end;
  }

  .gad-cols__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .gad-cols__col--center .gad-cols__buttons {
    justify-content: center;
  }

  .gad-cols__col--right .gad-cols__buttons {
    justify-content: flex-end;
  }

  .gad-cols__image img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: var(--img-r, 0);
  }

  .gad-cols__col--center .gad-cols__image img {
    margin: 0 auto;
  }

  .gad-cols__video {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 0.8rem;
  }

  .gad-cols__video iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .gad-cols__news .newsletter-form__field-wrapper {
    max-width: 44rem;
  }
{% endstylesheet %}

