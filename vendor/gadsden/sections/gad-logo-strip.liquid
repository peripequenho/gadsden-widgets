    },
    {
      "type": "select",
      "id": "text_scale",
      "label": "Tamaño de los textos",
      "options": [
        {
          "value": "70",
          "label": "70 %"
        },
        {
          "value": "80",
          "label": "80 %"
        },
        {
          "value": "90",
          "label": "90 %"
        },
        {
          "value": "100",
          "label": "Normal"
        },
        {
          "value": "110",
          "label": "110 %"
        },
        {
          "value": "125",
          "label": "125 %"
        },
        {
          "value": "150",
          "label": "150 %"
        },
        {
          "value": "175",
          "label": "175 %"
        },
        {
          "value": "200",
          "label": "200 %"
        }
