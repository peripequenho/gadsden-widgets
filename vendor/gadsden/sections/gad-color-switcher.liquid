        {
          "value": "h2",
          "label": "Chico"
        },
        {
          "value": "h1",
          "label": "Mediano"
        },
        {
          "value": "h0",
          "label": "Grande"
        }
      ],
      "default": "h1"
    },
    {
      "type": "color",
      "id": "heading_accent",
      "label": "Color de las palabras resaltadas",
      "info": "Vacío: el acento de la combinación de colores."
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alineación del encabezado",
      "default": "center",
