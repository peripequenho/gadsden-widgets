
{%- assign s = section.settings -%}
{%- render 'gad-colors', s: s, key: section.id -%}
<div
  class="gad-cs gad-pad {% render 'gad-scheme', s: s, key: section.id %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="page-width">
    {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: s.heading_align, align_m: s.heading_align_m -%}
    <gad-color-switcher class="gad-cs__list" role="radiogroup" aria-label="{{ s.heading | strip_html | escape }}">
      <button type="button" class="gad-cs__item is-active" role="radio" aria-checked="true" data-gad-palette="">
        <span class="gad-cs__dot gad-cs__dot--default"></span>
        <span class="gad-cs__name">{{ s.default_label | escape }}</span>
      </button>
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <button
          type="button"
          class="gad-cs__item"
          role="radio"
          aria-checked="false"
          data-gad-palette="{{ block.id }}"
          data-bg="{{ b.bg.red }},{{ b.bg.green }},{{ b.bg.blue }}"
          data-fg="{{ b.text.red }},{{ b.text.green }},{{ b.text.blue }}"
          data-btn="{{ b.button.red }},{{ b.button.green }},{{ b.button.blue }}"
          data-btn-text="{{ b.button_text.red }},{{ b.button_text.green }},{{ b.button_text.blue }}"
          {{ block.shopify_attributes }}
        >
          <span class="gad-cs__dot" style="background: linear-gradient(135deg, {{ b.bg }} 50%, {{ b.button }} 50%);"></span>
          <span class="gad-cs__name">{{ b.name | escape }}</span>
        </button>
      {%- endfor -%}
    </gad-color-switcher>
  </div>
</div>

{% stylesheet %}
  .gad-cs__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.6rem;
  }

  .gad-cs__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .gad-cs__dot {
    display: block;
    width: 4.4rem;
    height: 4.4rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.2);
    border-radius: 50%;
  }

  .gad-cs__dot--default {
    background: linear-gradient(135deg, rgb(var(--color-background)) 50%, rgb(var(--color-button)) 50%);
  }

  .gad-cs__item.is-active .gad-cs__dot {
    outline: 0.2rem solid rgb(var(--color-foreground));
    outline-offset: 0.3rem;
  }

  .gad-cs__name {
    font-size: 1.3rem;
  }
{% endstylesheet %}

{% schema %}
