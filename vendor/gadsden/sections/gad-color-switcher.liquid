    },
    {
      "type": "color",
      "id": "cc_accent",
      "label": "Acento",
      "default": "#334FB4"
    },
    {
      "type": "color",
      "id": "cc_btn_bg",
      "label": "Fondo del botón lleno",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "cc_btn_text",
