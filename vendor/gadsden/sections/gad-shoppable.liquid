
{%- assign s = section.settings -%}
{%- render 'gad-colors', s: s, key: section.id -%}
<div
  class="gad-shop gad-pad {% render 'gad-scheme', s: s, key: section.id %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px;"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="page-width{% if s.full_width %} page-width--full{% endif %}">
    {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: s.heading_align, align_m: s.heading_align_m -%}
    <gad-shoppable class="gad-shop__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: s.image.alt, sizes: '100vw', widths: '750, 1100, 1500, 2000' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'gad-shop__ph' }}
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign p = b.product
          assign side = 'right'
          if b.x > 60
            assign side = 'left'
          endif
          assign vert = 'down'
          if b.y > 55
            assign vert = 'up'
          endif
        -%}
        <details
          class="gad-shop__spot gad-shop__spot--{{ side }} gad-shop__spot--{{ vert }}"
          name="GadShop-{{ section.id }}"
          style="left: {{ b.x }}%; top: {{ b.y }}%;"
          {{ block.shopify_attributes }}
        >
          <summary class="gad-shop__dot gad-shop__dot--{{ s.point_style }}">
            <span class="visually-hidden">{{ p.title | default: b.title | escape }}</span>
          </summary>
          <div class="gad-shop__card color-{{ s.card_scheme }}">
            {%- if p != blank -%}
              <a href="{{ p.url }}" class="gad-shop__img">
                {%- if p.featured_media -%}
                  {{ p.featured_media | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', width: 120, height: 120 }}
                {%- endif -%}
              </a>
              <div class="gad-shop__info">
                <a href="{{ p.url }}" class="gad-shop__title">{{ p.title | escape }}</a>
                {%- render 'price', product: p, use_variant: true -%}
                {%- render 'gad-atc-button', label: s.atc_label, product: p -%}
                {%- if s.link_label != blank -%}<a href="{{ p.url }}" class="gad-shop__link link">{{ s.link_label | escape }}</a>{%- endif -%}
              </div>
            {%- else -%}
              <div class="gad-shop__info">
                <span class="gad-shop__title">{{ b.title | escape }}</span>
                {%- if request.design_mode -%}<p class="gad-shop__hint">{{ 'gadsden.shoppable.pick' | t }}</p>{%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </details>
      {%- endfor -%}
    </gad-shoppable>
  </div>
</div>

{% stylesheet %}
  .gad-shop__media {
    position: relative;
    display: block;
  }

  .gad-shop__media > img,
  .gad-shop__ph {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.2rem;
  }

  .page-width--full .gad-shop__media > img {
    border-radius: 0;
  }

  .gad-shop__ph {
    aspect-ratio: 16 / 9;
    background: rgba(var(--color-foreground), 0.06);
  }

  .gad-shop__spot {
    position: absolute;
    z-index: 1;
  }

  .gad-shop__spot[open] {
    z-index: 3;
  }

  .gad-shop__dot {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 0.2rem 0.8rem rgba(0, 0, 0, 0.25);
    list-style: none;
    cursor: pointer;
  }

  .gad-shop__dot::-webkit-details-marker {
    display: none;
  }

  .gad-shop__dot::before {
    content: '';
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: #121212;
    transition: transform 0.2s;
  }

  .gad-shop__dot--plus::before {
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 0;
    background: linear-gradient(#121212, #121212) center / 100% 0.2rem no-repeat,
      linear-gradient(#121212, #121212) center / 0.2rem 100% no-repeat;
  }

  .gad-shop__spot[open] .gad-shop__dot--plus::before {
    transform: rotate(45deg);
  }

  .gad-shop__spot[open] .gad-shop__dot--dot::before {
    transform: scale(1.3);
  }

  .gad-shop__card {
    position: absolute;
    display: flex;
    gap: 1.2rem;
    width: min(32rem, 80vw);
    padding: 1.2rem;
    border-radius: 1rem;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.2);
  }

  .gad-shop__spot--right .gad-shop__card {
    left: 2.4rem;
  }

  .gad-shop__spot--left .gad-shop__card {
    right: 2.4rem;
  }

  .gad-shop__spot--down .gad-shop__card {
    top: -1.5rem;
  }

  .gad-shop__spot--up .gad-shop__card {
    bottom: 1.5rem;
  }

  @media screen and (max-width: 749px) {
    .gad-shop__card {
      position: fixed;
      inset: auto 1.2rem 1.2rem !important;
      width: auto;
      z-index: 20;
    }
  }

  .gad-shop__img img {
    display: block;
    width: 9rem;
    height: 9rem;
    border-radius: 0.6rem;
    object-fit: cover;
  }

  .gad-shop__info {
    display: grid;
    flex: 1;
    gap: 0.6rem;
    align-content: start;
    min-width: 0;
  }

  .gad-shop__title {
    color: inherit;
    font-weight: 600;
    text-decoration: none;
  }

  .gad-shop__info .price {
    font-size: 1.4rem;
  }

  .gad-shop__info .button {
    min-height: 4rem;
    padding: 0 1.6rem;
    font-size: 1.3rem;
  }

  .gad-shop__link {
    font-size: 1.3rem;
  }

  .gad-shop__hint {
    margin: 0;
    font-size: 1.3rem;
    opacity: 0.7;
  }
{% endstylesheet %}

{% javascript %}
  class GadShoppable extends HTMLElement {
    connectedCallback() {
      if (this._ready) return;
      this._ready = true;
      this.onDoc = (e) => {
        this.querySelectorAll('details[open]').forEach((d) => {
          if (!d.contains(e.target)) d.removeAttribute('open');
        });
      };
      this.onKey = (e) => {
        if (e.key === 'Escape') this.querySelectorAll('details[open]').forEach((d) => d.removeAttribute('open'));
      };
      document.addEventListener('click', this.onDoc);
      document.addEventListener('keydown', this.onKey);
      this.addEventListener('shopify:block:select', (e) => e.target.setAttribute('open', ''));
      this.addEventListener('shopify:block:deselect', (e) => e.target.removeAttribute('open'));
    }

    disconnectedCallback() {
      document.removeEventListener('click', this.onDoc);
      document.removeEventListener('keydown', this.onKey);
      this._ready = false;
    }
  }

  if (!customElements.get('gad-shoppable')) customElements.define('gad-shoppable', GadShoppable);
{% endjavascript %}

