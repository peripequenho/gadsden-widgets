
{%- liquid
  assign s = section.settings
  assign a1 = s.anchor_1 | remove: '#' | handleize
  assign a2 = s.anchor_2 | remove: '#' | handleize
-%}
{%- render 'gad-colors', s: s, key: section.id -%}
<gad-merge
  class="gad-merge gad-pad {% render 'gad-scheme', s: s, key: section.id %}{% if s.reverse_mobile %} gad-merge--rev{% endif %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --mg-cols: {{ s.ratio }}; --mg-gap: {{ s.gap }}px; --mg-align: {{ s.valign }};"
  data-a1="{{ a1 }}"
  data-a2="{{ a2 }}"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="gad-merge__grid{% unless s.full_width %} page-width{% endunless %}">
    <div class="gad-merge__col" data-gad-merge-slot="1"></div>
    <div class="gad-merge__col" data-gad-merge-slot="2"></div>
  </div>
  {%- if request.design_mode -%}
    <p class="gad-merge__note page-width" hidden>{{ 'gadsden.merge.missing' | t }}</p>
  {%- endif -%}
</gad-merge>

{% stylesheet %}
  .gad-merge__grid {
    display: grid;
    gap: var(--mg-gap, 0);
  }

  .gad-merge--rev .gad-merge__col[data-gad-merge-slot='1'] {
    order: 2;
  }

  @media screen and (min-width: 750px) {
    .gad-merge__grid {
      grid-template-columns: var(--mg-cols, 1fr 1fr);
      align-items: var(--mg-align, stretch);
    }

    .gad-merge--rev .gad-merge__col[data-gad-merge-slot='1'] {
      order: 0;
    }
  }

  .gad-merge__col {
    min-width: 0;
  }

  .gad-merge__col,
  .gad-merge__col > .shopify-section,
  .gad-merge__col > .shopify-section > :not(.gad-sec-marker, style, script, link) {
    display: flex;
    flex-direction: column;
  }

  .gad-merge__col > .shopify-section,
  .gad-merge__col > .shopify-section > :not(.gad-sec-marker, style, script, link),
  .gad-merge__col > .shopify-section > :not(.gad-sec-marker, style, script, link) > :last-child {
    flex: 1 1 auto;
  }

  .gad-merge__col .page-width {
    padding-left: 0;
    padding-right: 0;
  }

  .gad-merge__note {
    padding: 1.2rem 1.5rem;
    border: 0.1rem dashed rgba(var(--color-foreground), 0.3);
    font-size: 1.3rem;
    text-align: center;
  }
{% endstylesheet %}

{% javascript %}
  class GadMerge extends HTMLElement {
    connectedCallback() {
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => this.merge(), { once: true });
      else this.merge();
    }

    merge() {
      if (!this.isConnected) return;
      this.moved = [];
      [this.dataset.a1, this.dataset.a2].forEach((id, i) => {
        const target = id && document.getElementById(id);
        const sec = target && target.closest('.shopify-section');
        const slot = this.querySelector(`[data-gad-merge-slot="${i + 1}"]`);
        if (!sec || sec.contains(this) || !slot) return;
        const mark = document.createComment('gad-merge');
        sec.before(mark);
        slot.appendChild(sec);
        this.moved.push([sec, mark]);
      });
      const note = this.querySelector('.gad-merge__note');
      if (note) note.hidden = this.moved.length === 2;
    }

    disconnectedCallback() {
      (this.moved || []).forEach(([sec, mark]) => {
        if (mark.parentNode) mark.replaceWith(sec);
      });
      this.moved = [];
    }
  }

  if (!customElements.get('gad-merge')) customElements.define('gad-merge', GadMerge);
{% endjavascript %}

