
{%- assign s = section.settings -%}
{%- render 'gad-colors', s: s, key: section.id -%}
{%- liquid
  assign t_align = s.text_align | default: 'center'
  assign t_items = t_align | replace: 'left', 'flex-start' | replace: 'right', 'flex-end'
  case s.media_width
    when 'half'
      assign t_img_w = '50%'
    when 'full'
      assign t_img_w = '100%'
    else
      assign t_img_w = '33%'
  endcase
-%}
<style>
  #GadTm-{{ section.id }} .gad-tm-pad{padding-top:{{ s.padding_top | times: 0.75 | round }}px;padding-bottom:{{ s.padding_bottom | times: 0.75 | round }}px}
  @media(min-width:750px){#GadTm-{{ section.id }} .gad-tm-pad{padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px}}
  #GadTm-{{ section.id }} .tm__card{height:100%;display:flex;flex-direction:column;gap:1.2rem;padding:2.4rem;border-radius:var(--text-boxes-radius);text-align:{{ t_align }};align-items:{{ t_items }};position:relative
    {%- if s.card_style == 'custom' -%};background:{{ s.card_cc_bg_gradient | default: s.card_cc_bg }};color:{{ s.card_cc_text }}{%- elsif s.card_style == 'tint' -%};background:rgba(var(--color-foreground),.05){%- endif -%}}
  #GadTm-{{ section.id }} .tm__quote{position:absolute;top:1rem;{% if t_align == 'left' %}right:1.6rem{% else %}left:1.6rem{% endif %};font-size:5rem;line-height:1;opacity:.35;font-family:Georgia,serif;color:{{ s.quotes_color | default: 'currentColor' }}}
  #GadTm-{{ section.id }} .tm__img{border-radius:{% if s.media_ratio == 'circle' %}50%{% else %}var(--media-radius){% endif %};overflow:hidden;width:{{ t_img_w }};aspect-ratio:{% if s.media_ratio == 'portrait' %}3/4{% elsif s.media_ratio == 'adapt' %}auto{% else %}1{% endif %}}
  #GadTm-{{ section.id }} .tm__img img{width:100%;height:100%;object-fit:cover;display:block}
  #GadTm-{{ section.id }} .tm__title{margin:0;font-weight:700;font-size:1.7rem}
  #GadTm-{{ section.id }} .tm__text{margin:0}
  #GadTm-{{ section.id }} .tm__author{margin-top:auto;font-size:1.4rem;display:flex;align-items:center;gap:.8rem;justify-content:{{ t_items }}}
  #GadTm-{{ section.id }} .tm__avatar{width:3.2rem;height:3.2rem;border-radius:50%;object-fit:cover}
  #GadTm-{{ section.id }} .tm__img--video video{width:100%;height:100%;object-fit:cover}
  #GadTm-{{ section.id }} .tm__stars{display:inline-flex;gap:.2rem}
  #GadTm-{{ section.id }} .tm__stars .gad-icon{font-size:2rem;color:{{ s.star_empty_color }}}
  #GadTm-{{ section.id }} .tm__stars .gad-icon.on{color:{{ s.star_color }}}
  {% if s.empty_stars == 'hidden' %}#GadTm-{{ section.id }} .tm__stars .gad-icon:not(.on){display:none}{% elsif s.empty_stars == 'outline' %}#GadTm-{{ section.id }} .tm__stars .gad-icon:not(.on){font-variation-settings:'FILL' 0;color:{{ s.star_color }}}{% endif %}
</style>
<div id="GadTm-{{ section.id }}" class="{% render 'gad-scheme', s: s, key: section.id %}" {% render 'gad-section-attrs', s: s %}>
  <div class="{% unless s.full_width %}page-width {% endunless %}gad-tm-pad">
    {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: s.heading_align, align_m: s.heading_align_m -%}
    {%- capture slides -%}
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div {{ block.shopify_attributes }}>
          <div class="tm__card{% if s.card_style == 'scheme' %} color-{{ s.card_color_scheme }} gradient{% endif %}">
            {%- if s.show_quotes -%}<span class="tm__quote" aria-hidden="true">“</span>{%- endif -%}
            {%- if b.video != blank -%}<div class="tm__img tm__img--video">{{ b.video | video_tag: image_size: '800x', loop: true, muted: true, autoplay: false, playsinline: true, controls: true, poster: b.image }}</div>
            {%- elsif b.image != blank -%}<div class="tm__img">{{ b.image | image_url: width: 600 | image_tag: loading: 'lazy' }}</div>{%- endif -%}
            {%- if s.show_stars and b.rating > 0 -%}
              <span class="tm__stars" role="img" aria-label="{{ b.rating }} / 5">
                {%- for i in (1..5) -%}{%- if i <= b.rating -%}{%- render 'gad-icon', name: 'star', filled: true, class: 'on' -%}{%- else -%}{%- render 'gad-icon', name: 'star', filled: true -%}{%- endif -%}{%- endfor -%}
              </span>
            {%- endif -%}
            {%- if b.title != blank -%}<h3 class="tm__title">{{ b.title }}</h3>{%- endif -%}
            {%- if b.text != blank -%}<div class="tm__text rte">{{ b.text }}</div>{%- endif -%}
            {%- if b.author != blank or b.avatar != blank -%}<div class="tm__author">{% if b.avatar != blank %}{{ b.avatar | image_url: width: 80 | image_tag: class: 'tm__avatar', loading: 'lazy' }}{% endif %}{{ b.author }}</div>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- endcapture -%}
    {%- render 'gad-carousel', s: s, key: section.id, slides: slides, label: s.heading, m_per_view: 1 -%}
  </div>
</div>

