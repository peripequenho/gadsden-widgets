    },
    {
      "type": "select",
      "id": "hl_style",
      "label": "Palabras resaltadas de los títulos",
      "default": "color",
      "options": [
        {
          "value": "color",
          "label": "En color"
        },
        {
          "value": "marker",
          "label": "Con marcador en las secciones claras"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "text_full",
      "label": "Texto con el color pleno",
      "default": false,
      "info": "El tema pinta el texto un poco más suave que los títulos."
    },
    {
      "type": "checkbox",
      "id": "border_on",
      "label": "Borde en tarjetas, fotos y cajas",
      "default": false
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Grosor del borde",
      "default": 2
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacidad del borde en las secciones claras",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_opacity_dark",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacidad del borde en las oscuras",
      "default": 25
    },
    {
      "type": "checkbox",
      "id": "square",
      "label": "Esquinas rectas",
      "default": false,
      "info": "Tarjetas, fotos, videos y cajas sin redondeo."
    },
    {
      "type": "range",
      "id": "texture",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "%",
      "label": "Trama de puntos en el fondo",
      "default": 0,
      "info": "Reemplaza el degradé o la imagen de fondo de las secciones."
    },
    {
      "type": "range",
      "id": "section_line",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "label": "Línea entre secciones",
      "default": 0,
      "info": "Del color del texto en las secciones claras y del acento en las oscuras."
    },
    {
      "type": "range",
      "id": "page_width",
      "min": 0,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Ancho de la página",
      "default": 0,
      "info": "0: el de Configuración del tema."
    },
    {
      "type": "range",
      "id": "title_zoom_m",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Títulos de las secciones en mobile",
      "default": 100,
      "info": "Achica los títulos grandes en el celular."
    }
  ],
  "presets": [
    {
      "name": "Estilo de esta página"
    }
  ]
}
{% endschema %}
