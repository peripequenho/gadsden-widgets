

{%- liquid
  assign uid = section.id | replace: '_', '-'
-%}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Barlow+Semi+Condensed:wght@400;500;600;700&display=swap">

<style>
  
  #ax-faq-{{ uid }}{
    --tinta:#141210;--papel:#E6DFCE;--papel-2:#D6CDB6;--lima:#93D920;
    --impacto:'Archivo Black','Arial Black',Haettenschweiler,Impact,sans-serif;
    --texto:'Barlow Semi Condensed','Barlow','Segoe UI Semibold','Segoe UI',Arial,sans-serif;
    background:var(--papel-2);color:var(--tinta);font-family:var(--texto);
    padding:44px 20px;border-bottom:4px solid var(--tinta);
  }
  #ax-faq-{{ uid }} h1,#ax-faq-{{ uid }} h2,#ax-faq-{{ uid }} h3{color:inherit}
  #ax-faq-{{ uid }} .ax-wrap{max-width:820px;margin:0 auto}
  #ax-faq-{{ uid }} .ax-eye{font-family:var(--impacto);font-size:9px;letter-spacing:.16em;
    text-transform:uppercase;background:var(--tinta);color:var(--papel);padding:7px 12px;
    display:block;width:max-content;max-width:100%;transform:skewX(-9deg);margin:0 0 16px}
  #ax-faq-{{ uid }} .ax-eye span{display:inline-block;transform:skewX(9deg)}
  #ax-faq-{{ uid }} h2{margin:0 0 22px;font-family:var(--impacto);text-transform:uppercase;
    font-size:clamp(25px,7.2vw,34px);line-height:1.02;letter-spacing:-.02em;
    transform:skewX(-9deg);display:inline-block}
  #ax-faq-{{ uid }} h2 span{display:inline-block}
  #ax-faq-{{ uid }} h2 em{font-style:normal;background:var(--lima);padding:1px 8px;
    box-decoration-break:clone;-webkit-box-decoration-break:clone}
  #ax-faq-{{ uid }} .ax-lista{border:3px solid var(--tinta);background:var(--papel)}
  #ax-faq-{{ uid }} details{border-bottom:2px solid var(--tinta)}
  #ax-faq-{{ uid }} details:last-child{border-bottom:0}
  
  #ax-faq-{{ uid }} summary{list-style:none;cursor:pointer;padding:16px 50px 16px 18px;
    min-height:44px;display:flex;align-items:center;
    font-family:var(--impacto);text-transform:uppercase;font-size:15.5px;
    line-height:1.2;letter-spacing:-.005em;position:relative}
  #ax-faq-{{ uid }} summary::-webkit-details-marker{display:none}
  #ax-faq-{{ uid }} summary:before,#ax-faq-{{ uid }} summary:after{content:"";position:absolute;
    right:18px;top:50%;background:var(--tinta);transition:transform .16s ease}
  #ax-faq-{{ uid }} summary:before{width:15px;height:3px;transform:translateY(-50%)}
  #ax-faq-{{ uid }} summary:after{width:3px;height:15px;right:24px;transform:translateY(-50%)}
  #ax-faq-{{ uid }} details[open] summary{background:var(--lima)}
  #ax-faq-{{ uid }} details[open] summary:after{transform:translateY(-50%) scaleY(0)}
  #ax-faq-{{ uid }} .ax-resp{padding:12px 18px 18px;font-size:16.5px;line-height:1.5;max-width:60ch}
  #ax-faq-{{ uid }} .ax-resp p{margin:0 0 10px}
  #ax-faq-{{ uid }} .ax-resp p:last-child{margin:0}
  #ax-faq-{{ uid }} .ax-pie{margin:22px 0 0;font-size:16px;line-height:1.5;opacity:.78;max-width:60ch}

  
  @media(min-width:900px){
    #ax-faq-{{ uid }}{padding:74px 28px}
    #ax-faq-{{ uid }} .ax-eye{font-size:10.5px;letter-spacing:.19em;padding:7px 14px;margin-bottom:24px}
    #ax-faq-{{ uid }} h2{font-size:clamp(34px,4.3vw,50px);margin-bottom:34px}
    #ax-faq-{{ uid }} .ax-lista{border-width:4px}
    #ax-faq-{{ uid }} summary{padding:21px 58px 21px 24px;font-size:17.5px}
    #ax-faq-{{ uid }} summary:before,#ax-faq-{{ uid }} summary:after{right:24px}
    #ax-faq-{{ uid }} summary:before{width:17px}
    #ax-faq-{{ uid }} summary:after{height:17px;right:31px}
    #ax-faq-{{ uid }} .ax-resp{padding:2px 24px 24px;font-size:17px;line-height:1.55}
    #ax-faq-{{ uid }} .ax-pie{margin-top:28px}
  }

  
</style>

<div id="ax-faq-{{ uid }}">
  <div class="ax-wrap">
    {%- if section.settings.eyebrow != blank -%}
      <div class="ax-eye"><span>{{ section.settings.eyebrow }}</span></div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2><span>{{ section.settings.heading }}</span></h2>
    {%- endif -%}

    <div class="ax-lista">
      {%- for block in section.blocks -%}
        <details {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.q }}</summary>
          <div class="ax-resp">{{ block.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.pie != blank -%}
      <p class="ax-pie">{{ section.settings.pie }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Objeciones",
  "tag": "section",
  "class": "athlex-faq-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bajada (eyebrow)", "default": "04 — LO QUE TODOS PREGUNTAN" },
    { "type": "inline_richtext", "id": "heading", "label": "Título (podés resaltar con cursiva → lima)", "default": "Sacate las <em>dudas</em>" },
    { "type": "checkbox", "id": "open_first", "label": "Abrir la primera pregunta", "default": true },
    { "type": "header", "content": "Pie" },
    { "type": "textarea", "id": "pie", "label": "Texto al pie", "default": "Producto cosmético de higiene y cuidado personal. Uso externo." }
  ],
  "blocks": [
    {
      "type": "qa", "name": "Pregunta", "limit": 8,
      "settings": [
        { "type": "text", "id": "q", "label": "Pregunta", "default": "¿Arde?" },
        { "type": "richtext", "id": "a", "label": "Respuesta", "default": "<p>No tiene por qué. Lo que vas a sentir es frío, que es otra cosa.</p>" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Objeciones",
      "blocks": [
        { "type": "qa", "settings": { "q": "¿Reemplaza al jabón?", "a": "<p>No, usalo con lo que ya tengas. Esto va después del baño o cuando lo necesites: seca la zona y alivia la picazón sin frotar nada.</p>" } },
        { "type": "qa", "settings": { "q": "¿Arde?", "a": "<p>Vas a sentir frío, no ardor. Si igual se te irrita, suspendé el uso. Y no lo pongas sobre piel lastimada.</p>" } },
        { "type": "qa", "settings": { "q": "¿Mancha la ropa?", "a": "<p>Es transparente y se evapora. Dejalo secar unos segundos antes de vestirte.</p>" } },
        { "type": "qa", "settings": { "q": "¿Qué olor tiene?", "a": "<p>[TODO — confirmar la fragancia con el formulador antes de publicar.]</p>" } },
        { "type": "qa", "settings": { "q": "¿Cuándo lo uso?", "a": "<p>Después de bañarte, con la piel seca. Y de nuevo cuando la zona vuelva a estar húmeda.</p>" } },
        { "type": "qa", "settings": { "q": "¿Dónde me lo puedo poner?", "a": "<p>Ingle, entrepierna, axilas, atrás de la rodilla. Evitá los ojos y las mucosas.</p>" } }
      ]
    }
  ]
}
{% endschema %}
