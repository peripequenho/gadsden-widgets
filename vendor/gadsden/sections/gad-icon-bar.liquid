
{%- liquid
  assign s = section.settings
  case s.icon_size
    when 'small'
      assign icon_px = 28
    when 'large'
      assign icon_px = 56
    else
      assign icon_px = 40
  endcase
  case s.icon_color
    when 'text'
      assign icon_color = 'rgb(var(--color-foreground))'
    when 'accent'
      assign icon_color = 'rgb(var(--color-accent, var(--color-button)))'
    else
      assign icon_color = 'rgb(var(--color-button))'
  endcase
-%}
{%- render 'gad-colors', s: s, key: section.id -%}
<style>
  #GadIb-{{ section.id }} .gad-ib-pad{padding-top:{{ s.padding_top | times: 0.75 | round }}px;padding-bottom:{{ s.padding_bottom | times: 0.75 | round }}px}
  @media(min-width:750px){#GadIb-{{ section.id }} .gad-ib-pad{padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px}}
  #GadIb-{{ section.id }} .icon-bar__card{height:100%;display:flex;gap:1.4rem;align-items:center;padding:2rem;border-radius:var(--text-boxes-radius);text-align:center;flex-direction:column;justify-content:flex-start
    {%- if s.card_style == 'custom' -%};background:{{ s.card_cc_bg_gradient | default: s.card_cc_bg }};color:{{ s.card_cc_text }}{%- elsif s.card_style == 'tint' -%};background:rgba(var(--color-foreground),.05){%- endif -%}
    {%- if s.card_shadow -%};box-shadow:0 .4rem 1.6rem rgba(0,0,0,.08){%- endif -%}}
  {% if s.layout == 'horizontal' %}#GadIb-{{ section.id }} .icon-bar__card{flex-direction:row;text-align:left}{% endif %}
  #GadIb-{{ section.id }} .icon-bar__icon{font-size:{{ icon_px }}px;color:{{ icon_color }};flex:0 0 auto;line-height:1}
  #GadIb-{{ section.id }} .icon-bar__icon .gad-icon{font-size:24px}
  #GadIb-{{ section.id }} .icon-bar__title{margin:0;font-size:1.6rem;font-weight:700}
  #GadIb-{{ section.id }} .icon-bar__text{margin:.4rem 0 0}
  #GadIb-{{ section.id }} .icon-bar__text p:empty{display:none}
  #GadIb-{{ section.id }} .icon-bar__card a{color:inherit;text-decoration:none}
</style>
<div id="GadIb-{{ section.id }}" class="{% render 'gad-scheme', s: s, key: section.id %}" {% render 'gad-section-attrs', s: s %}>
  <div class="{% unless s.full_width %}page-width {% endunless %}gad-ib-pad">
    {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: s.heading_align, align_m: s.heading_align_m -%}
    {%- capture slides -%}
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div {{ block.shopify_attributes }}>
          <div class="icon-bar__card{% if s.card_style == 'scheme' %} color-{{ s.card_color_scheme }} gradient{% endif %}">
            {%- if b.icon_image != blank -%}
              {{ b.icon_image | image_url: width: 200 | image_tag: loading: 'lazy', style: 'width:' | append: icon_px | append: 'px;height:auto' }}
            {%- elsif b.icon != blank -%}
              <span class="icon-bar__icon">{%- render 'gad-icon', name: b.icon, filled: b.icon_filled -%}</span>
            {%- endif -%}
            <div>
              {%- if b.title != blank -%}
                <h3 class="icon-bar__title">{% if b.link != blank %}<a href="{{ b.link }}">{% endif %}{{ b.title }}{% if b.link != blank %}</a>{% endif %}</h3>
              {%- endif -%}
              {%- if b.text != blank and b.text != '<p></p><p></p>' -%}
                <div class="icon-bar__text rte">{{ b.text }}</div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endcapture -%}
    {%- render 'gad-carousel', s: s, key: section.id, slides: slides, label: s.heading -%}
  </div>
</div>

