  "class": "athlex-test-section",
  "settings": [
    { "type": "inline_richtext", "id": "titulo", "label": "Titular", "default": "Roce, o algo mas? El test de las 8 preguntas" },
    { "type": "textarea", "id": "bajada", "label": "Bajada", "default": "Si hay picazon o ardor en la ingle, contesta estas 8 preguntas: al final te decimos que encaja con lo que contaste, que se puede hacer hoy sin gastar un peso, y si conviene ver a un medico antes de comprar nada." },
    { "type": "text", "id": "boton_empezar", "label": "Boton de arranque", "default": "Empezar el test" },
    { "type": "header", "content": "La absolucion (va en los 3 que venden)" },
    { "type": "inline_richtext", "id": "absolucion", "label": "Frase destacada",
      "default": "Eso se llama <em>tina inguinal</em>. Es un hongo, es comunisimo, y no es una enfermedad de transmision sexual." },
    { "type": "text", "id": "voces_pie", "label": "Aclaracion de las citas",
      "default": "Cita textual de un foro publico. No es un cliente de ATHLEX." },
    { "type": "header", "content": "Producto" },
    { "type": "text", "id": "handle", "label": "Handle del producto", "default": "athlex" },
    { "type": "text", "id": "caja_titulo", "label": "Titulo de la caja", "default": "ATHLEX PSS" },
    { "type": "text", "id": "caja_sub", "label": "Bajada de la caja", "default": "Spray corporal para zonas de roce. 120 ml." },
    { "type": "text", "id": "bene_1", "label": "Beneficio 1", "default": "Se aplica sin tocar la zona y sin frotar." },
    { "type": "text", "id": "bene_2", "label": "Beneficio 2", "default": "Seca en segundos: te vestis enseguida." },
    { "type": "text", "id": "bene_3", "label": "Beneficio 3", "default": "Parece un producto de deporte. Puede quedar a la vista." },
    { "type": "text", "id": "caja_boton", "label": "Boton", "default": "Quiero probarlo un mes" },
    { "type": "text", "id": "caja_pie", "label": "Linea de garantia", "default": "Garantia de 30 dias: si no te convence, te devolvemos lo que pagaste." },
    { "type": "header", "content": "Pie" },
    { "type": "textarea", "id": "legal", "label": "Aviso legal",
      "default": "Este test es una orientacion, no un diagnostico medico, y no reemplaza una consulta. ATHLEX PSS es un producto cosmetico de higiene y cuidado personal, de uso externo." }
  ],
  "presets": [ { "name": "Cuestionario" } ]
}
{% endschema %}
