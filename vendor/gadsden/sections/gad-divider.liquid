            />
          </defs>
          <g class="gad-dvx__ola gad-dvx__ola--1"><use href="#gad-dvx-ola-{{ section.id }}" x="50" y="3"/></g>
          <g class="gad-dvx__ola gad-dvx__ola--2"><use href="#gad-dvx-ola-{{ section.id }}" x="50" y="0" opacity=".4"/></g>
          <g class="gad-dvx__ola gad-dvx__ola--3"><use href="#gad-dvx-ola-{{ section.id }}" x="50" y="9" opacity=".3"/></g>
          <g class="gad-dvx__ola gad-dvx__ola--4"><use href="#gad-dvx-ola-{{ section.id }}" x="50" y="6" opacity=".2"/></g>
        </svg>
      {%- elsif s.shape == 'relief' -%}
        <svg viewBox="0 0 1920 60" aria-hidden="true" focusable="false">
          <path fill-rule="evenodd" d="{{ path }}"/>
        </svg>
      {%- elsif s.shape == 'capas' or s.shape == 'capas_cortas' -%}
        <svg viewBox="0 0 1440 250" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d="{{ path_2 }}" opacity="{% if s.shape == 'capas' %}.5{% else %}.3{% endif %}"/>
          <path d="{{ path }}"/>
        </svg>
      {%- elsif s.shape == 'ondas' -%}
        <svg viewBox="0 0 1440 195" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d="{{ path }}"/>
        </svg>
      {%- elsif s.shape == 'diagonal' -%}
        <svg viewBox="0 0 360 32" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d="{{ path }}"/>
        </svg>
      {%- else -%}
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d="{{ path | strip }}"/>
        </svg>
      {%- endif -%}
    </div>
  </div>
  <div class="gad-dvx__pad gad-dvx__pad--bottom {{ bottom_class }}"></div>
</div>

{% stylesheet %}
  div.gad-dvx {
    line-height: 0;
    background: none;
  }

  .gad-dvx div.gad-dvx__bg {
    background: var(--div-bg, rgb(var(--color-background)));
  }

  .gad-dvx div.gad-dvx__fill {
    background: var(--div-shape, rgb(var(--color-background)));
  }

  /* Los márgenes son divs vacíos y Dawn oculta los div:empty. */
  .gad-dvx div.gad-dvx__pad {
    display: block;
    height: calc(var(--div-pt) * 0.75);
  }

  .gad-dvx div.gad-dvx__pad--bottom {
    height: calc(var(--div-pb) * 0.75);
  }

  /* Un píxel de solape con la sección vecina para que no quede una línea entre las dos. */
  .gad-dvx div.gad-dvx__shape {
    background: none;
    transform: translateY(1px);
  }

  .gad-dvx svg {
    display: block;
    width: 100%;
    height: calc(var(--div-m, 40px) * var(--font-body-scale, 1));
    fill: var(--div-shape, rgb(var(--color-background)));
  }

  .gad-dvx.gad-dvx--relief svg {
    height: auto;
  }

  /* Formas que guardan su proporción hasta 150px de alto; más ancho, se estiran a lo ancho. */
  .gad-dvx.gad-dvx--capas svg,
  .gad-dvx.gad-dvx--capas_cortas svg,
  .gad-dvx.gad-dvx--ondas svg,
  .gad-dvx.gad-dvx--diagonal svg {
    height: auto;
    max-height: 150px;
  }

  .gad-dvx__ola use {
    animation: gad-dvx-ola-ida 10s linear infinite;
  }

  .gad-dvx__ola--2 use {
    animation: gad-dvx-ola-vuelta 8s linear infinite;
  }

  .gad-dvx__ola--3 use {
    animation-duration: 6s;
  }

  .gad-dvx__ola--4 use {
    animation: gad-dvx-ola-vuelta 4s linear infinite;
  }

  @keyframes gad-dvx-ola-ida {
    from {
      transform: translateX(85px);
    }

    to {
      transform: translateX(-90px);
    }
  }

  @keyframes gad-dvx-ola-vuelta {
    from {
      transform: translateX(-90px);
    }

    to {
      transform: translateX(85px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gad-dvx__ola use {
      animation: none;
    }
  }

  @media screen and (min-width: 750px) {
    .gad-dvx div.gad-dvx__pad {
      height: var(--div-pt);
    }

    .gad-dvx div.gad-dvx__pad--bottom {
      height: var(--div-pb);
    }
  }

  /* Alto de desktop. */
  @media screen and (min-width: 750px) {
    .gad-dvx svg {
      height: calc(var(--div-d, 80px) * var(--font-body-scale, 1));
    }

    .gad-dvx.gad-dvx--relief svg {
      height: auto;
    }
  }
{% endstylesheet %}
