{%- liquid
  assign s = section.settings
  assign wrap_class = 'page-width'
  if s.page_width == 'full'
    assign wrap_class = 'gad-media-slider__full'
  elsif s.page_width == 'full-bleed'
    assign wrap_class = 'gad-media-slider__bleed'
  endif
-%}
{%- render 'gad-colors', s: s, key: section.id -%}

<div
  class="gad-media-slider gad-pad {% render 'gad-scheme', s: s, key: section.id %}{% if s.m_full_width %} gad-media-slider--m-full{% endif %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --radius-d: {{ s.radius_d }}px; --radius-m: {{ s.radius_m }}px;"
  {% render 'gad-section-attrs', s: s %}
>
  {%- if s.heading != blank -%}
    <div class="page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, align: 'center' -%}
    </div>
  {%- endif -%}

  {%- capture slides -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        assign slide_empty = false
        if block.type == 'image_slide' and b.image == blank
          assign slide_empty = true
        endif
        if block.type == 'video_slide' and b.video == blank
          assign slide_empty = true
        endif
      -%}
      {%- if slide_empty and request.design_mode == false and s.show_empty != true -%}
        {%- continue -%}
      {%- endif -%}
      <div class="gad-media-slider__slide" {{ block.shopify_attributes }}>
        <div class="gad-media-slider__media{% if slide_empty and s.show_empty %} gad-media-slider__media--empty{% endif %}">
          {%- if block.type == 'image_slide' -%}
            {%- if b.link != blank -%}<a href="{{ b.link }}" class="gad-media-slider__link">{%- endif -%}
            {%- if b.image != blank -%}
              {%- assign img_alt = b.image.alt | default: '' -%}
              {{ b.image | image_url: width: 1500 | image_tag: loading: 'lazy', alt: img_alt, sizes: '(min-width: 990px) 33vw, 80vw', widths: '375, 550, 750, 1100, 1500' }}
            {%- else -%}
              {%- if s.show_empty -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg gad-media-slider__placeholder gad-media-slider__placeholder--empty' }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'gad-media-slider__placeholder' }}{%- endif -%}
            {%- endif -%}
            {%- if b.link != blank -%}</a>{%- endif -%}
          {%- else -%}
            {%- if b.video != blank -%}
              {%- render 'gad-video',
                video: b.video,
                poster: b.thumbnail,
                autoplay: b.autoplay,
                loop: b.loop,
                tap: b.tap_toggle,
                pulse: b.pulse,
                sound: b.sound,
                timeline: b.timeline,
                timeline_color: b.timeline_color,
                button_scheme: b.button_scheme,
                sound_scheme: b.sound_scheme,
                width: 1100
              -%}
            {%- else -%}
              {%- if s.show_empty -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg gad-media-slider__placeholder gad-media-slider__placeholder--empty' }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'gad-media-slider__placeholder' }}{%- endif -%}
            {%- endif -%}
          {%- endif -%}
        </div>
        {%- if b.description != blank -%}
          <div class="gad-media-slider__desc rte color-{{ b.desc_scheme }} gad-media-slider__desc--{{ b.desc_align }}">{{ b.description }}</div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  {%- endcapture -%}

  {%- if section.blocks.size > 0 -%}
    <div class="{{ wrap_class }} gad-media-slider__wrap{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {% if settings.animations_reveal_on_scroll %}data-cascade style="--animation-order: 2;"{% endif %}>
      {%- render 'gad-carousel', s: s, key: section.id, slides: slides, label: s.heading, force_d_on: true, force_m_on: true -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .gad-media-slider__full {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .gad-media-slider__bleed {
    padding: 0;
  }

  @media screen and (min-width: 750px) {
    :where(html[data-gad-bp='750']) .gad-media-slider__full {
      padding-left: 5rem;
      padding-right: 5rem;
    }
  }

  @media screen and (min-width: 990px) {
    :where(html:not([data-gad-bp='750'])) .gad-media-slider__full {
      padding-left: 5rem;
      padding-right: 5rem;
    }
  }

  @media screen and (max-width: 749px) {
    .gad-media-slider--m-full .gad-media-slider__wrap {
      padding-left: 0;
      padding-right: 0;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    :where(html:not([data-gad-bp='750'])) .gad-media-slider--m-full .gad-media-slider__wrap {
      padding-left: 0;
      padding-right: 0;
    }
  }

  .gad-media-slider__slide {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .gad-media-slider__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-m);
    background: rgba(var(--color-foreground), 0.04);
  }

  .gad-media-slider__media img,
  .gad-media-slider__placeholder {
    display: block;
    width: 100%;
    height: auto;
  }

  .gad-media-slider__link {
    display: block;
  }

  .gad-media-slider__desc {
    padding: 1rem 1.2rem;
    margin-top: 0.8rem;
    border-radius: var(--radius-m);
    font-size: 1.4rem;
  }

  .gad-media-slider__desc p {
    margin: 0;
  }

  .gad-media-slider__desc--center {
    text-align: center;
  }

  .gad-media-slider__desc--right {
    text-align: right;
  }

  @media screen and (min-width: 750px) {
    :where(html[data-gad-bp='750']) .gad-media-slider__media,
    :where(html[data-gad-bp='750']) .gad-media-slider__desc {
      border-radius: var(--radius-d);
    }
  }

  @media screen and (min-width: 990px) {
    :where(html:not([data-gad-bp='750'])) .gad-media-slider__media,
    :where(html:not([data-gad-bp='750'])) .gad-media-slider__desc {
      border-radius: var(--radius-d);
    }
  }

  /* Diapositiva vacía visible: el marcador de Shopify sin el fondo ni el redondeo del contenedor. */
  .gad-media-slider__media--empty {
    border-radius: 0;
    background: none;
  }

  .gad-media-slider__placeholder--empty.placeholder-svg {
    display: block;
    width: 100%;
    height: auto;
    background-color: rgba(var(--color-foreground), 0.04);
    fill: rgba(var(--color-foreground), 0.55);
  }
{% endstylesheet %}

