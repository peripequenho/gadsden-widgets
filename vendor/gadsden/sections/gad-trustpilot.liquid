
{%- liquid
  assign s = section.settings
  assign rating = s.rating | at_least: 0 | at_most: 5
-%}
{%- render 'gad-colors', s: s, key: section.id -%}
<div
  class="gad-tpr gad-pad {% render 'gad-scheme', s: s, key: section.id %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --tp: {{ s.star_color }}; --tp-off: {{ s.empty_color }};"
  {% render 'gad-section-attrs', s: s %}
>
  <div class="page-width">
    {%- render 'gad-heading', caption: s.caption, caption_color: s.caption_color, title: s.heading, size: s.heading_size, accent: s.heading_accent, text: s.text, align: s.heading_align, align_m: s.heading_align_m -%}
    {%- if s.summary_label != blank or s.count_text != blank -%}
      <div class="gad-tpr__summary">
        {%- if s.summary_label != blank -%}<strong class="gad-tpr__label h3">{{ s.summary_label | escape }}</strong>{%- endif -%}
        <span class="gad-tp__stars" style="--tp-size: 28px;" role="img" aria-label="{{ 'gadsden.reviews.stars' | t: count: rating }}">
          {%- for i in (1..5) -%}
            {%- assign part = rating | minus: forloop.index0 | at_least: 0 | at_most: 1 | times: 100 | round -%}
            <span class="gad-tp__star" style="--f: {{ part }}%;" aria-hidden="true">{%- render 'gad-icon', name: 'star', filled: true -%}</span>
          {%- endfor -%}
        </span>
        {%- if s.count_text != blank -%}<span class="gad-tpr__count">{{ s.count_text }}</span>{%- endif -%}
        {%- if s.platform_name != blank -%}
          <span class="gad-tpr__brand">{%- render 'gad-icon', name: 'star', filled: true -%}{{ s.platform_name | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- capture slides -%}
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <article class="gad-tpr__card color-{{ s.card_scheme }}" {{ block.shopify_attributes }}>
          <div class="gad-tpr__top">
            <span class="gad-tp__stars" style="--tp-size: 20px;" role="img" aria-label="{{ 'gadsden.reviews.stars' | t: count: b.rating }}">
              {%- for i in (1..5) -%}
                <span class="gad-tp__star" style="--f: {% if forloop.index <= b.rating %}100{% else %}0{% endif %}%;" aria-hidden="true">{%- render 'gad-icon', name: 'star', filled: true -%}</span>
              {%- endfor -%}
            </span>
            {%- if b.verified -%}
              <span class="gad-tpr__verified">{%- render 'gad-icon', name: 'check_circle', filled: true -%}{{ 'gadsden.reviews.verified' | t }}</span>
            {%- endif -%}
          </div>
          {%- if b.title != blank -%}<h3 class="gad-tpr__title h5">{{ b.title | escape }}</h3>{%- endif -%}
          <div class="gad-tpr__text rte">{{ b.text }}</div>
          <footer class="gad-tpr__foot">
            <span class="gad-tpr__author">{{ b.author | escape }}</span>
            {%- if b.date != blank -%}<span class="gad-tpr__date">{{ b.date | escape }}</span>{%- endif -%}
          </footer>
        </article>
      {%- endfor -%}
    {%- endcapture -%}
    {%- if section.blocks.size > 0 -%}
      {%- render 'gad-carousel', s: s, key: section.id, slides: slides, label: s.heading -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .gad-tpr__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.6rem;
    margin-bottom: 3.2rem;
  }

  .gad-tpr__label {
    margin: 0;
  }

  .gad-tpr__count {
    font-size: 1.4rem;
  }

  .gad-tpr__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    --gad-icon-color: var(--tp);
  }

  .gad-tpr__card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: 2rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.1);
    border-radius: 0.4rem;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  .gad-tpr__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .gad-tpr__verified {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.2rem;
    opacity: 0.75;
    --gad-icon-color: rgb(var(--color-foreground));
  }

  .gad-tpr__title {
    margin: 0;
  }

  .gad-tpr__text {
    font-size: 1.4rem;
  }

  .gad-tpr__text p {
    margin: 0;
  }

  .gad-tpr__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: auto;
    font-size: 1.3rem;
  }

  .gad-tpr__author {
    font-weight: 600;
  }

  .gad-tpr__date {
    opacity: 0.7;
  }
{% endstylesheet %}

