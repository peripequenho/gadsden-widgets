{%- comment -%}
  Muro de reseñas: una tira que corre arriba y el muro de tarjetas en columnas, con "ver más" en el celular.
  Copia configurable de la de Gadsden (white label, BUILD.md decisión 20): los colores y las letras que eran fijos
  son ajustes; vacíos, los de la tienda. El estilo "oscuro" pone los originales (src/w/oscuro.json).
{%- endcomment -%}
{%- if section.settings.letra_titulos != blank and section.settings.letra_titulos.family != settings.type_header_font.family and section.settings.letra_titulos.family != settings.type_body_font.family -%}<style>{{ section.settings.letra_titulos | font_face: font_display: 'swap' }}</style>{%- endif -%}
{%- if section.settings.letra_texto != blank and section.settings.letra_texto.family != settings.type_header_font.family and section.settings.letra_texto.family != settings.type_body_font.family -%}<style>{{ section.settings.letra_texto | font_face: font_display: 'swap' }}</style>{%- endif -%}

{%- liquid
  assign uid = section.id | replace: '_', '-'
  assign hay = section.blocks.size
-%}

{%- if hay > 0 -%}
{%- if section.settings.letra_titulos != blank or section.settings.letra_texto != blank -%}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Barlow+Semi+Condensed:wght@400;500;600;700&display=swap">{%- endif -%}

<style>
  
  #ax-rev-{{ uid }}{
    --tinta:rgb(var(--r-texto));--papel:rgb(var(--r-fondo));--papel-2:rgb(var(--r-puntos));--lima:rgb(var(--r-resalte));--lima-honda:#6BA512;
    --impacto:var(--r-letra_titulos);
    --texto:var(--r-letra_texto);
    background:var(--papel);color:var(--tinta);font-family:var(--texto);
    padding:44px 20px 40px;border-bottom:4px solid var(--tinta);
    background-image:radial-gradient(var(--papel-2) 1.1px,transparent 1.2px);background-size:7px 7px;
  }
  #ax-rev-{{ uid }} h1,#ax-rev-{{ uid }} h2,#ax-rev-{{ uid }} h3{color:inherit}
  #ax-rev-{{ uid }} .ax-wrap{max-width:1180px;margin:0 auto}

  #ax-rev-{{ uid }} .ax-eye{font-family:var(--impacto);font-size:9px;letter-spacing:.16em;
    text-transform:uppercase;background:var(--tinta);color:var(--papel);padding:7px 12px;
    display:block;width:max-content;max-width:100%;transform:skewX(-9deg);margin:0 0 16px}
  #ax-rev-{{ uid }} .ax-eye span{display:inline-block;transform:skewX(9deg)}
  #ax-rev-{{ uid }} h2{margin:0 0 10px;font-family:var(--impacto);text-transform:uppercase;
    font-size:clamp(25px,7.2vw,34px);line-height:1.02;letter-spacing:-.02em;
    transform:skewX(-9deg);display:inline-block}
  #ax-rev-{{ uid }} h2 span{display:inline-block}
  #ax-rev-{{ uid }} h2 em{font-style:normal;background:var(--lima);padding:1px 8px;
    box-decoration-break:clone;-webkit-box-decoration-break:clone}

  
  #ax-rev-{{ uid }} .ax-resumen{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;
    margin:0 0 18px;font-family:var(--impacto)}
  #ax-rev-{{ uid }} .ax-nota{font-size:30px;line-height:1}
  #ax-rev-{{ uid }} .ax-estrellas{letter-spacing:.1em;font-size:16px;color:var(--lima-honda)}
  #ax-rev-{{ uid }} .ax-cuantas{font-family:var(--texto);font-size:15.5px;opacity:.7}

  
  #ax-rev-{{ uid }}{overflow-x:clip}
  #ax-rev-{{ uid }} .ax-marq{overflow:hidden;width:100vw;margin:0 0 16px calc(50% - 50vw)}
  #ax-rev-{{ uid }} .ax-tira{display:flex;gap:9px;width:max-content;
    animation:ax-rueda-{{ uid }} 48s linear infinite}
  #ax-rev-{{ uid }} .ax-marq:hover .ax-tira{animation-play-state:paused}
  @keyframes ax-rueda-{{ uid }}{to{transform:translateX(-50%)}}
  #ax-rev-{{ uid }} .ax-mq{flex:none;display:flex;align-items:center;gap:9px;
    background:var(--tinta);color:var(--papel);padding:7px 12px 7px 7px;max-width:330px}
  #ax-rev-{{ uid }} .ax-mq img{width:34px;height:34px;object-fit:cover;flex:none;
    border:2px solid var(--lima)}
  #ax-rev-{{ uid }} .ax-mq .txt{min-width:0}
  #ax-rev-{{ uid }} .ax-mq .fila1{display:flex;align-items:baseline;gap:6px;white-space:nowrap}
  #ax-rev-{{ uid }} .ax-mq .e{color:var(--lima);font-size:11px;letter-spacing:.05em}
  #ax-rev-{{ uid }} .ax-mq b{font-family:var(--impacto);font-size:10.5px;letter-spacing:.05em;
    text-transform:uppercase}
  #ax-rev-{{ uid }} .ax-mq .ok{font-family:var(--impacto);font-size:10px;line-height:1;
    color:var(--tinta);background:var(--lima);padding:2px 4px}
  #ax-rev-{{ uid }} .ax-mq .cita{font-size:13.5px;line-height:1.25;white-space:nowrap;
    overflow:hidden;text-overflow:ellipsis;opacity:.92;display:block}
  #ax-rev-{{ uid }} .ax-mq .fecha{font-size:11.5px;opacity:.55;white-space:nowrap}
  

  
  #ax-rev-{{ uid }} .ax-muro{columns:2;column-gap:10px}
  
  #ax-rev-{{ uid }} .ax-rev.ax-oculta{display:none}
  #ax-rev-{{ uid }} .ax-vermas{display:none;margin:14px auto 0;background:var(--tinta);
    color:var(--papel);font-family:var(--impacto);text-transform:uppercase;font-size:14px;
    letter-spacing:.08em;padding:15px 26px;border:0;cursor:pointer;min-height:44px;
    transform:skewX(-9deg)}
  #ax-rev-{{ uid }} .ax-vermas span{display:inline-block;transform:skewX(9deg)}
  #ax-rev-{{ uid }} .ax-vermas.ax-visible{display:block}
  #ax-rev-{{ uid }} .ax-vermas:focus-visible{outline:3px solid var(--lima-honda);outline-offset:2px}
  #ax-rev-{{ uid }} .ax-rev{break-inside:avoid;margin:0 0 10px;border:3px solid var(--tinta);
    background:var(--papel);overflow:hidden}
  #ax-rev-{{ uid }} .ax-rev img{width:100%;height:auto;display:block}
  #ax-rev-{{ uid }} .ax-cuerpo{padding:10px 11px 12px}
  #ax-rev-{{ uid }} .ax-rev .ax-estrellas{display:block;font-size:13px;margin:0 0 4px}
  #ax-rev-{{ uid }} .ax-rev h3{margin:0 0 4px;font-family:var(--impacto);text-transform:uppercase;
    font-size:14px;line-height:1.15;letter-spacing:-.01em}
  #ax-rev-{{ uid }} .ax-rev p{margin:0;font-size:15.5px;line-height:1.38;opacity:.9}
  #ax-rev-{{ uid }} .ax-firma{margin:8px 0 0;padding:7px 0 0;border-top:2px solid rgba(var(--r-texto),.12);
    display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:13.5px}
  #ax-rev-{{ uid }} .ax-nombre{white-space:nowrap;font-weight:600}
  #ax-rev-{{ uid }} .ax-cuando{font-size:12px;opacity:.55;white-space:nowrap}
  #ax-rev-{{ uid }} .ax-ok{font-size:10px;letter-spacing:.05em;text-transform:uppercase;
    color:var(--lima-honda);font-family:var(--impacto);margin-left:auto;white-space:nowrap}

  
  #ax-rev-{{ uid }} .ax-rev.es-destacada{background:var(--lima)}
  #ax-rev-{{ uid }} .es-destacada .ax-estrellas{color:var(--tinta)}
  #ax-rev-{{ uid }} .es-destacada p{font-family:var(--impacto);text-transform:uppercase;
    font-size:15px;line-height:1.25;letter-spacing:-.01em;opacity:1}
  #ax-rev-{{ uid }} .es-destacada .ax-ok{color:var(--tinta);opacity:.7}
  #ax-rev-{{ uid }} .es-destacada .ax-firma{border-top-color:rgba(var(--r-texto),.25)}

  
  @media(min-width:900px){
    #ax-rev-{{ uid }}{padding:74px 28px}
    #ax-rev-{{ uid }} .ax-eye{font-size:10.5px;letter-spacing:.19em;padding:7px 14px;margin-bottom:24px}
    #ax-rev-{{ uid }} h2{font-size:clamp(34px,4.3vw,48px)}
    #ax-rev-{{ uid }} .ax-nota{font-size:40px}
    #ax-rev-{{ uid }} .ax-resumen{margin-bottom:26px}
    #ax-rev-{{ uid }} .ax-muro{columns:3;column-gap:16px}
    #ax-rev-{{ uid }} .ax-rev{margin-bottom:16px;border-width:3px}
    #ax-rev-{{ uid }} .ax-cuerpo{padding:13px 15px 15px}
    #ax-rev-{{ uid }} .ax-rev h3{font-size:15.5px}
    #ax-rev-{{ uid }} .ax-rev p{font-size:16px;line-height:1.42}
    #ax-rev-{{ uid }} .es-destacada p{font-size:17px}
    #ax-rev-{{ uid }} .ax-firma{font-size:14.5px}
  }
  @media(min-width:900px){
    #ax-rev-{{ uid }} .ax-marq{margin-bottom:22px}
    #ax-rev-{{ uid }} .ax-mq .cita{max-width:230px}
  }
  @media(min-width:1200px){
    #ax-rev-{{ uid }} .ax-muro{columns:4}
  }
</style>

<div id="ax-rev-{{ uid }}" style="--r-fondo: {%- render 'gad-rol', c: section.settings.color_fondo, d: 'var(--color-background)' -%}; --r-puntos: {%- render 'gad-rol', c: section.settings.color_puntos, d: 'var(--color-background-contrast)' -%}; --r-texto: {%- render 'gad-rol', c: section.settings.color_texto, d: 'var(--color-foreground)' -%}; --r-resalte: {%- render 'gad-rol', c: section.settings.color_resalte, d: 'var(--color-background-contrast)' -%}; --r-letra_titulos: {% if section.settings.letra_titulos != blank %}'{{ section.settings.letra_titulos.family }}','Arial Black',Haettenschweiler,Impact,sans-serif{% else %}var(--font-heading-family){% endif %}; --r-letra_texto: {% if section.settings.letra_texto != blank %}'{{ section.settings.letra_texto.family }}','Barlow','Segoe UI Semibold','Segoe UI',Arial,sans-serif{% else %}var(--font-body-family){% endif %};">
  
  <span id="gad-resenas" style="position:absolute;margin-top:-80px"></span>
  <div class="ax-wrap">
    {%- if section.settings.eyebrow != blank -%}
      <div class="ax-eye"><span>{{ section.settings.eyebrow }}</span></div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2><span>{{ section.settings.heading }}</span></h2>
    {%- endif -%}

    {%- if section.settings.mostrar_resumen and section.settings.promedio != blank -%}
      {%- assign p = section.settings.promedio | replace: ',', '.' | times: 1.0 | round -%}
      <div class="ax-resumen">
        <span class="ax-nota">{{ section.settings.promedio }}</span>
        <span class="ax-estrellas" role="img" aria-label="{{ section.settings.promedio }} de 5">
          {%- for i in (1..5) -%}{% if i <= p %}★{% else %}☆{% endif %}{%- endfor -%}
        </span>
        {%- if section.settings.cuantas != blank -%}
          <span class="ax-cuantas">{{ section.settings.cuantas }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      El ticker se alimenta de las mismas reseñas del muro (recorte de 60
      caracteres): cero contenido extra que mantener. Se imprime dos veces
      para que el bucle sea continuo; la segunda copia va oculta a lectores.
    {%- endcomment -%}
    <div class="ax-marq" aria-hidden="false">
      <div class="ax-tira">
        {%- for copia in (1..2) -%}
          <div style="display:flex;gap:9px" {% if copia == 2 %}aria-hidden="true"{% endif %}>
            {%- for block in section.blocks limit: 10 -%}
              {%- assign e = block.settings.estrellas | default: 5 -%}
              <span class="ax-mq">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 80 }}" alt="" width="34" height="34" loading="lazy">
                {%- endif -%}
                <span class="txt">
                  <span class="fila1">
                    <span class="e">{% for i in (1..e) %}★{% endfor %}</span>
                    {%- if block.settings.autor != blank -%}<b>{{ block.settings.autor }}</b>{%- endif -%}
                    {%- if block.settings.verificada -%}<span class="ok" role="img" aria-label="Compra verificada" title="Compra verificada">✓</span>{%- endif -%}
                    {%- if block.settings.fecha != blank -%}<span class="fecha">{{ block.settings.fecha }}</span>{%- endif -%}
                  </span>
                  <span class="cita">“{{ block.settings.text | strip_html | truncate: 60 }}”</span>
                </span>
              </span>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="ax-muro">
      {%- for block in section.blocks -%}
        <div class="ax-rev{% if block.settings.destacada %} es-destacada{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}"
                 alt="{{ block.settings.image.alt | default: 'Foto enviada por quien dejó la reseña' | escape }}"
                 width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}"
                 loading="lazy">
          {%- endif -%}
          <div class="ax-cuerpo">
            {%- assign e = block.settings.estrellas | default: 5 -%}
            <span class="ax-estrellas" role="img" aria-label="{{ e }} de 5">
              {%- for i in (1..5) -%}{% if i <= e %}★{% else %}☆{% endif %}{%- endfor -%}
            </span>
            {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
            {%- if block.settings.autor != blank -%}
              <div class="ax-firma">
                <span class="ax-nombre">{{ block.settings.autor }}</span>
                {%- if block.settings.fecha != blank -%}<span class="ax-cuando">{{ block.settings.fecha }}</span>{%- endif -%}
                {%- if block.settings.verificada -%}<span class="ax-ok">Compra verificada</span>{%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    <button type="button" class="ax-vermas"><span>Ver más reseñas</span></button>
  </div>
</div>

<script>
  
  (function () {
    var caja = document.getElementById('ax-rev-{{ uid }}');
    if (!caja || caja.dataset.axListo) return;
    caja.dataset.axListo = '1';
    var lote = parseInt('{{ section.settings.lote | default: 6 }}', 10) || 6;
    var revs = [].slice.call(caja.querySelectorAll('.ax-rev'));
    var btn  = caja.querySelector('.ax-vermas');
    if (!btn || revs.length <= lote) return;
    var visibles = lote;
    function pintar () {
      revs.forEach(function (r, i) { r.classList.toggle('ax-oculta', i >= visibles); });
      var quedan = revs.length - visibles;
      if (quedan > 0) {
        btn.querySelector('span').textContent = 'Ver más reseñas (' + quedan + ')';
        btn.classList.add('ax-visible');
      } else {
        btn.classList.remove('ax-visible');
      }
    }
    btn.addEventListener('click', function () { visibles += lote; pintar(); });
    pintar();
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Muro de reseñas",
  "tag": "section",
  "class": "gad-reviews-wall-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Bajada (eyebrow)",
      "default": "07 — LO QUE DICEN"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título (la cursiva va en el color de resaltado)",
      "default": "Reseñas de <em>clientes</em>"
    },
    {
      "type": "header",
      "content": "Resumen"
    },
    {
      "type": "checkbox",
      "id": "mostrar_resumen",
      "label": "Mostrar el resumen",
      "default": true,
      "info": "Apagalo si Judge.me ya muestra el promedio."
    },
    {
      "type": "text",
      "id": "promedio",
      "label": "Promedio real (ej: 4,8)",
      "info": "Vacío oculta el resumen. No lo estimes."
    },
    {
      "type": "text",
      "id": "cuantas",
      "label": "Cantidad (ej: 23 opiniones)"
    },
    {
      "type": "range",
      "id": "lote",
      "label": "Reseñas visibles antes del Ver más",
      "min": 4,
      "max": 12,
      "step": 2,
      "default": 6
    },
    {
      "type": "header",
      "content": "Colores y letras (vacíos: los de la tienda)"
    },
    {
      "type": "color",
      "id": "color_fondo",
      "label": "Fondo"
    },
    {
      "type": "color",
      "id": "color_puntos",
      "label": "Trama de puntos del fondo"
    },
    {
      "type": "color",
      "id": "color_texto",
      "label": "Texto y bordes"
    },
    {
      "type": "color",
      "id": "color_resalte",
      "label": "Resaltado (título, estrellas, destacada)"
    },
    {
      "type": "font_picker",
      "id": "letra_titulos",
      "label": "Letra de los títulos"
    },
    {
      "type": "font_picker",
      "id": "letra_texto",
      "label": "Letra del texto"
    }
  ],
  "blocks": [
    {
      "type": "resena",
      "name": "Reseña",
      "limit": 24,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto del cliente",
          "info": "Opcional. Altura libre: el muro la acomoda."
        },
        {
          "type": "range",
          "id": "estrellas",
          "label": "Estrellas",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título (opcional)"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "[VACÍO — pegar la reseña tal cual la escribió la persona, sin corregirle la redacción.]"
        },
        {
          "type": "text",
          "id": "autor",
          "label": "Nombre",
          "default": "[VACÍO]"
        },
        {
          "type": "checkbox",
          "id": "verificada",
          "label": "Compra verificada",
          "default": false,
          "info": "Marcá sólo si existe el pedido."
        },
        {
          "type": "text",
          "id": "fecha",
          "label": "Fecha de compra (mm/aa, ej: 07/26)",
          "info": "Real o nada, como todo acá."
        },
        {
          "type": "checkbox",
          "id": "destacada",
          "label": "Destacada (fondo resaltado)",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Muro de reseñas"
    }
  ]
}
{% endschema %}
