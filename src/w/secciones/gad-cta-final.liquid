{%- comment -%}
  Llamado final: una placa con brillo, título, píldora de oferta, subtítulo y botón.
  Copia configurable de la de Gadsden (white label, BUILD.md decisión 20): los colores y las letras que eran fijos
  son ajustes; vacíos, los de la tienda. El estilo "oscuro" pone los originales (src/w/oscuro.json).
{%- endcomment -%}
{%- if section.settings.letra != blank and section.settings.letra.family != settings.type_header_font.family and section.settings.letra.family != settings.type_body_font.family -%}<style>{{ section.settings.letra | font_face: font_display: 'swap' }}</style>{%- endif -%}
{%- assign uid = section.id | replace: '_', '-' -%}
<style>
  #gad-cta-{{ uid }}{background:rgb(var(--r-fondo));padding:70px 20px;font-family:var(--r-letra)}
  #gad-cta-{{ uid }} .gt-card{max-width:1180px;margin:0 auto;background:rgb(var(--r-placa));color:rgb(var(--r-texto));border-radius:32px;padding:66px 40px;text-align:center;position:relative;overflow:hidden}
  #gad-cta-{{ uid }} .gt-card:before{content:"";position:absolute;inset:0;background:radial-gradient(600px 320px at 82% 120%,rgba(var(--r-brillo),.5),transparent 62%)}
  #gad-cta-{{ uid }} .gt-card>*{position:relative;z-index:1}
  #gad-cta-{{ uid }} h2{font-size:46px;font-weight:800;letter-spacing:-.02em;margin:0;color:rgb(var(--r-texto))}
  #gad-cta-{{ uid }} .gt-pill{display:inline-block;border:1.5px solid rgba(var(--r-texto),.55);color:rgb(var(--r-texto));border-radius:100px;padding:14px 32px;font-weight:700;font-size:21px;margin:26px 0 18px}
  #gad-cta-{{ uid }} .gt-sub{color:rgb(var(--r-subtitulo));font-size:17px;margin:0 0 28px}
  #gad-cta-{{ uid }} .gt-btn{display:inline-flex;align-items:center;justify-content:center;background:rgb(var(--r-boton));color:rgb(var(--r-boton_texto));font-weight:800;font-size:18px;border-radius:14px;padding:19px 46px;text-decoration:none;transition:.2s;min-width:300px}
  #gad-cta-{{ uid }} .gt-btn:hover{background:rgb(var(--r-boton_hover));transform:translateY(-2px);box-shadow:0 14px 28px rgba(0,0,0,.22)}
  @media(max-width:760px){#gad-cta-{{ uid }} .gt-card{padding:52px 24px;border-radius:24px}#gad-cta-{{ uid }} h2{font-size:30px}#gad-cta-{{ uid }} .gt-btn{width:100%;min-width:0}}
</style>
<div id="gad-cta-{{ uid }}" style="--r-fondo: {%- render 'gad-rol', c: section.settings.color_fondo, d: 'var(--color-background)' -%}; --r-placa: {%- render 'gad-rol', c: section.settings.color_placa, d: 'var(--color-button)' -%}; --r-texto: {%- render 'gad-rol', c: section.settings.color_texto, d: 'var(--color-button-text)' -%}; --r-subtitulo: {%- render 'gad-rol', c: section.settings.color_subtitulo, d: 'var(--color-button-text)' -%}; --r-brillo: {%- render 'gad-rol', c: section.settings.color_brillo, d: 'var(--color-button-text)' -%}; --r-boton: {%- render 'gad-rol', c: section.settings.color_boton, d: 'var(--color-button-text)' -%}; --r-boton_texto: {%- render 'gad-rol', c: section.settings.color_boton_texto, d: 'var(--color-button)' -%}; --r-boton_hover: {%- render 'gad-rol', c: section.settings.color_boton_hover, d: 'var(--color-background-contrast)' -%}; --r-letra: {% if section.settings.letra != blank %}'{{ section.settings.letra.family }}',system-ui,sans-serif{% else %}var(--font-heading-family){% endif %};">
  <div class="gt-card">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.pill != blank -%}<div class="gt-pill">{{ section.settings.pill }}</div>{%- endif -%}
    {%- if section.settings.sub != blank -%}<p class="gt-sub">{{ section.settings.sub }}</p>{%- endif -%}
    {%- if section.settings.btn_label != blank -%}<a class="gt-btn" href="{{ section.settings.btn_link | default: '#' }}">{{ section.settings.btn_label }}</a>{%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Llamado final",
  "tag": "section",
  "class": "gad-cta-final-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "¿Listo para probarlo?"
    },
    {
      "type": "text",
      "id": "pill",
      "label": "Píldora (oferta)",
      "default": "Lleva 3, pagá 2"
    },
    {
      "type": "text",
      "id": "sub",
      "label": "Subtítulo",
      "default": "Envíos a todo el país · Garantía · 3 cuotas sin interés"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Botón (texto)",
      "default": "Comprar ahora"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Botón (link)"
    },
    {
      "type": "header",
      "content": "Colores y letras (vacíos: los de la tienda)"
    },
    {
      "type": "color",
      "id": "color_fondo",
      "label": "Fondo de la sección"
    },
    {
      "type": "color",
      "id": "color_placa",
      "label": "Fondo de la placa"
    },
    {
      "type": "color",
      "id": "color_texto",
      "label": "Texto de la placa"
    },
    {
      "type": "color",
      "id": "color_subtitulo",
      "label": "Subtítulo"
    },
    {
      "type": "color",
      "id": "color_brillo",
      "label": "Brillo de la placa"
    },
    {
      "type": "color",
      "id": "color_boton",
      "label": "Fondo del botón"
    },
    {
      "type": "color",
      "id": "color_boton_texto",
      "label": "Texto del botón"
    },
    {
      "type": "color",
      "id": "color_boton_hover",
      "label": "Fondo del botón al pasar el mouse"
    },
    {
      "type": "font_picker",
      "id": "letra",
      "label": "Letra"
    }
  ],
  "presets": [
    {
      "name": "Llamado final"
    }
  ]
}
{% endschema %}