      "label": "Fondo de las tarjetas y su degradado"
    },
    {
      "type": "font_picker",
      "id": "letra_titulos",
      "label": "Letra de los títulos"
    },
    {
      "type": "font_picker",
      "id": "letra_texto",
      "label": "Letra del texto"
    }
  ],
  "blocks": [
    {
      "type": "equipo",
      "name": "Póster",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "imagen",
          "label": "Imagen de fondo",
          "info": "Sin imagen se muestra una trama de puntos."
        },
        {
          "type": "text",
          "id": "palabra",
          "label": "Palabra grande",
          "default": "Título"
        },
        {
          "type": "text",
          "id": "linea",
          "label": "Línea corta",
