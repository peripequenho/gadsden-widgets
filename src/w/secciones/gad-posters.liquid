        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Pósters con texto",
      "blocks": [
        {
          "type": "equipo",
          "settings": {
            "palabra": "PRIMERO",
            "linea": "Una línea corta sobre este punto.",
            "ingredientes": "DETALLE|DATO\nDETALLE|DATO"
          }
