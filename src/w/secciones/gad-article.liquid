{%- comment -%}
  Nota: un artículo armado con bloques (subtítulos, párrafos, frases destacadas, citas, firma, índice, caja de producto y demostraciones animadas al entrar), con dos pieles (papel y portal) y una barra fija en el celular.
  Copia configurable de la de Gadsden (white label, BUILD.md decisión 20): los colores y las letras que eran fijos
  son ajustes; vacíos, los de la tienda. El estilo "oscuro" pone los originales (src/w/oscuro.json).
{%- endcomment -%}
{%- if section.settings.letra_titulos != blank and section.settings.letra_titulos.family != settings.type_header_font.family and section.settings.letra_titulos.family != settings.type_body_font.family -%}<style>{{ section.settings.letra_titulos | font_face: font_display: 'swap' }}</style>{%- endif -%}
{%- if section.settings.letra_texto != blank and section.settings.letra_texto.family != settings.type_header_font.family and section.settings.letra_texto.family != settings.type_body_font.family -%}<style>{{ section.settings.letra_texto | font_face: font_display: 'swap' }}</style>{%- endif -%}
{%- if section.settings.letra_lectura != blank and section.settings.letra_lectura.family != settings.type_header_font.family and section.settings.letra_lectura.family != settings.type_body_font.family -%}<style>{{ section.settings.letra_lectura | font_face: font_display: 'swap' }}</style>{%- endif -%}
{%- if section.settings.portal_letra_titulos != blank and section.settings.portal_letra_titulos.family != settings.type_header_font.family and section.settings.portal_letra_titulos.family != settings.type_body_font.family -%}<style>{{ section.settings.portal_letra_titulos | font_face: font_display: 'swap' }}</style>{%- endif -%}
{%- if section.settings.portal_letra_texto != blank and section.settings.portal_letra_texto.family != settings.type_header_font.family and section.settings.portal_letra_texto.family != settings.type_body_font.family -%}<style>{{ section.settings.portal_letra_texto | font_face: font_display: 'swap' }}</style>{%- endif -%}

{%- liquid
  assign uid = section.id | replace: '_', '-'
  assign p = all_products[section.settings.handle]
-%}

{%- if section.settings.letra_titulos != blank or section.settings.letra_texto != blank or section.settings.letra_lectura != blank or section.settings.portal_letra_titulos != blank or section.settings.portal_letra_texto != blank -%}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@600;700;800&family=Barlow:wght@400;500;600&family=Barlow+Semi+Condensed:wght@400;500;600;700&display=swap">{%- endif -%}

{% style %}
  #ax-nota-{{ uid }}{
    --tinta:rgb(var(--r-texto));--papel:rgb(var(--r-fondo));--papel-2:rgb(var(--r-fondo_2));--lima:rgb(var(--r-acento));--lima-honda:rgb(var(--r-acento_hondo));
    --impacto:var(--r-letra_titulos);
    --texto:var(--r-letra_texto);
    --lectura:var(--r-letra_lectura);
    background:var(--papel);color:var(--tinta);font-family:var(--lectura);
    padding:0 0 40px;
    background-image:radial-gradient(var(--papel-2) 1.1px,transparent 1.2px);background-size:7px 7px;
  }
  #ax-nota-{{ uid }} *{box-sizing:border-box}
  #ax-nota-{{ uid }} h1,#ax-nota-{{ uid }} h2,#ax-nota-{{ uid }} h3{color:inherit}
  #ax-nota-{{ uid }} .ax-col{max-width:660px;margin:0 auto;padding:0 20px}

  
  #ax-nota-{{ uid }} .ax-cinta{background:var(--tinta);color:var(--papel);
    font-family:var(--impacto);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;
    padding:9px 20px;text-align:center;line-height:1.4}

  #ax-nota-{{ uid }} .ax-cab{padding-top:28px}
  #ax-nota-{{ uid }} .ax-eye{font-family:var(--impacto);font-size:9px;letter-spacing:.16em;
    text-transform:uppercase;background:var(--lima);color:var(--tinta);padding:7px 12px;
    display:block;width:max-content;max-width:100%;transform:skewX(-9deg);margin:0 0 16px}
  #ax-nota-{{ uid }} .ax-eye span{display:inline-block;transform:skewX(9deg)}
  #ax-nota-{{ uid }} h1{margin:0 0 16px;font-family:var(--impacto);text-transform:uppercase;
    font-size:clamp(28px,8.2vw,44px);line-height:1.02;letter-spacing:-.02em;
    transform:skewX(-9deg);display:inline-block;max-width:100%}
  #ax-nota-{{ uid }} h1 em{font-style:normal;background:var(--lima);padding:1px 8px;
    box-decoration-break:clone;-webkit-box-decoration-break:clone}
  #ax-nota-{{ uid }} .ax-bajada{font-size:18px;line-height:1.5;margin:0 0 18px;font-weight:500}
  #ax-nota-{{ uid }} .ax-firma-top{display:flex;gap:8px;align-items:center;flex-wrap:wrap;
    font-family:var(--texto);font-size:13px;letter-spacing:.04em;text-transform:uppercase;
    border-top:2px solid var(--tinta);border-bottom:2px solid var(--tinta);padding:10px 0;margin:0 0 26px}
  #ax-nota-{{ uid }} .ax-firma-top i{font-style:normal;opacity:.6}

  
  #ax-nota-{{ uid }} .ax-p{font-size:17.5px;line-height:1.62;margin:0 0 18px}
  #ax-nota-{{ uid }} .ax-p p{margin:0 0 18px}
  #ax-nota-{{ uid }} .ax-p p:last-child{margin:0}
  #ax-nota-{{ uid }} .ax-p strong{background:var(--lima);padding:0 4px;
    box-decoration-break:clone;-webkit-box-decoration-break:clone}
  #ax-nota-{{ uid }} .ax-p ul,#ax-nota-{{ uid }} .ax-p ol{margin:0 0 18px;padding-left:20px}
  #ax-nota-{{ uid }} .ax-p li{margin:0 0 8px}
  #ax-nota-{{ uid }} .ax-p a{color:inherit;text-decoration:underline;text-decoration-thickness:2px;
    text-underline-offset:3px;text-decoration-color:var(--lima-honda)}

  #ax-nota-{{ uid }} h2{margin:34px 0 14px;font-family:var(--impacto);text-transform:uppercase;
    font-size:clamp(20px,5.6vw,26px);line-height:1.08;letter-spacing:-.01em;
    transform:skewX(-9deg);display:inline-block;max-width:100%}

  #ax-nota-{{ uid }} .ax-dest{margin:26px 0;padding:18px 20px;background:var(--tinta);color:var(--papel);
    font-family:var(--impacto);text-transform:uppercase;font-size:clamp(17px,4.8vw,22px);
    line-height:1.18;letter-spacing:-.01em}
  #ax-nota-{{ uid }} .ax-dest em{font-style:normal;background:var(--lima);color:var(--tinta);padding:0 5px;
    box-decoration-break:clone;-webkit-box-decoration-break:clone}

  #ax-nota-{{ uid }} .ax-img{margin:26px 0;border:3px solid var(--tinta)}
  #ax-nota-{{ uid }} .ax-img img{display:block;width:100%;height:auto}
  #ax-nota-{{ uid }} .ax-img figcaption{font-family:var(--texto);font-size:13px;padding:8px 12px;
    background:var(--tinta);color:var(--papel);letter-spacing:.03em}

  
  #ax-nota-{{ uid }} .ax-firma{margin:28px 0 0;padding:16px 18px;background:var(--papel-2);
    border-left:6px solid var(--tinta);font-family:var(--texto)}
  #ax-nota-{{ uid }} .ax-firma b{display:block;font-family:var(--impacto);text-transform:uppercase;
    font-size:15px;letter-spacing:.02em}
  #ax-nota-{{ uid }} .ax-firma i{font-style:normal;font-size:14px;letter-spacing:.04em;
    text-transform:uppercase;opacity:.7}

  
  #ax-nota-{{ uid }} .ax-caja{margin:30px 0;background:var(--tinta);color:var(--papel);padding:20px}
  #ax-nota-{{ uid }} .ax-caja-top{display:flex;gap:16px;align-items:center}
  #ax-nota-{{ uid }} .ax-caja img{width:92px;height:92px;object-fit:contain;flex:none;background:var(--papel)}
  #ax-nota-{{ uid }} .ax-caja h3{margin:0 0 6px;font-family:var(--impacto);text-transform:uppercase;
    font-size:19px;line-height:1.06;letter-spacing:-.01em}
  #ax-nota-{{ uid }} .ax-caja .ax-sub{font-family:var(--texto);font-size:14px;line-height:1.35;opacity:.85}
  #ax-nota-{{ uid }} .ax-precio{display:flex;align-items:baseline;gap:10px;margin:14px 0 0;flex-wrap:wrap}
  #ax-nota-{{ uid }} .ax-precio b{font-family:var(--impacto);font-size:30px;letter-spacing:-.02em}
  #ax-nota-{{ uid }} .ax-precio s{font-family:var(--texto);font-size:16px;opacity:.6}
  #ax-nota-{{ uid }} .ax-precio em{font-style:normal;background:var(--lima);color:var(--tinta);
    font-family:var(--impacto);font-size:11px;letter-spacing:.08em;text-transform:uppercase;
    padding:5px 8px;transform:skewX(-9deg)}
  #ax-nota-{{ uid }} .ax-precio em span{display:inline-block;transform:skewX(9deg)}
  #ax-nota-{{ uid }} .ax-cta{display:block;margin:14px 0 0;background:var(--lima);color:var(--tinta);
    font-family:var(--impacto);text-transform:uppercase;font-size:17px;letter-spacing:.02em;
    text-align:center;padding:16px 14px;transform:skewX(-9deg);text-decoration:none;border:none;
    width:100%;cursor:pointer;line-height:1.1}
  #ax-nota-{{ uid }} .ax-cta span{display:inline-block;transform:skewX(9deg)}
  
  #ax-nota-{{ uid }} .ax-cta::before,#ax-nota-{{ uid }} .ax-cta::after{content:none !important;display:none !important}
  #ax-nota-{{ uid }} .ax-cta{border-radius:0 !important;box-shadow:none !important}
  #ax-nota-{{ uid }} .ax-caja-pie{margin:12px 0 0;font-family:var(--texto);font-size:13.5px;
    line-height:1.4;display:flex;gap:8px;align-items:flex-start}
  #ax-nota-{{ uid }} .ax-caja-pie svg{width:17px;height:17px;flex:none;color:var(--lima);margin-top:1px}

  
  #ax-nota-{{ uid }} .ax-test{margin:26px 0;padding:16px 18px;border:3px solid var(--tinta);
    display:block;text-decoration:none;color:var(--tinta);background:var(--papel)}
  #ax-nota-{{ uid }} .ax-test b{display:block;font-family:var(--impacto);text-transform:uppercase;
    font-size:16px;line-height:1.1;margin:0 0 6px}
  #ax-nota-{{ uid }} .ax-test i{font-style:normal;font-family:var(--texto);font-size:14.5px;line-height:1.4}
  #ax-nota-{{ uid }} .ax-test u{display:inline-block;margin-top:10px;font-family:var(--impacto);
    font-size:12px;letter-spacing:.1em;text-transform:uppercase;background:var(--lima);
    padding:7px 11px;text-decoration:none;transform:skewX(-9deg)}
  #ax-nota-{{ uid }} .ax-test u span{display:inline-block;transform:skewX(9deg)}

  
  #ax-nota-{{ uid }} .ax-voces{margin:26px 0;border:3px solid var(--tinta);background:var(--papel)}
  #ax-nota-{{ uid }} .ax-voces-tit{background:var(--tinta);color:var(--papel);font-family:var(--impacto);
    font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;padding:9px 14px;line-height:1.3;margin:0}
  #ax-nota-{{ uid }} .ax-voces blockquote{margin:0;padding:14px 16px;
    border-bottom:2px dashed var(--papel-2);font-size:16.5px;line-height:1.45;font-style:italic}
  #ax-nota-{{ uid }} .ax-voces blockquote:last-of-type{border-bottom:none}
  #ax-nota-{{ uid }} .ax-voces cite{display:block;margin-top:6px;font-family:var(--texto);font-size:12.5px;
    font-style:normal;letter-spacing:.05em;text-transform:uppercase;opacity:.65}
  #ax-nota-{{ uid }} .ax-voces-pie{padding:10px 14px;background:var(--papel-2);margin:0;
    font-family:var(--texto);font-size:12.5px;line-height:1.4}

  
  #ax-nota-{{ uid }} .ax-cta-suelto{margin:22px 0}
  #ax-nota-{{ uid }} .ax-cta-suelto .ax-linea{font-family:var(--texto);font-size:14.5px;
    line-height:1.4;margin:0 0 9px}
  #ax-nota-{{ uid }} .ax-cta-suelto .ax-cta{margin:0}

  
  #ax-nota-{{ uid }} h2{scroll-margin-top:90px}
  #ax-nota-{{ uid }} .ax-indice{margin:24px 0;padding:16px 18px;background:var(--papel-2);
    border-left:6px solid var(--tinta)}
  #ax-nota-{{ uid }} .ax-indice-tit{margin:0 0 10px;font-family:var(--impacto);font-size:11px;
    letter-spacing:.14em;text-transform:uppercase}
  
  #ax-nota-{{ uid }} .ax-indice ol{margin:0;padding:0;list-style:none;font-family:var(--texto);font-size:16px}
  #ax-nota-{{ uid }} .ax-indice li{margin:0 0 7px;line-height:1.35}
  #ax-nota-{{ uid }} .ax-indice a{color:inherit;text-decoration:underline;
    text-decoration-thickness:2px;text-underline-offset:3px;text-decoration-color:var(--lima-honda)}
  #ax-nota-{{ uid }} .ax-indice a:hover{background:var(--lima)}
  #ax-nota-{{ uid }}.ax-portal .ax-indice{background:rgb(var(--r-portal_caja));border:1px solid var(--linea);
    border-left:4px solid rgb(var(--r-portal_rojo));padding:16px 18px}
  #ax-nota-{{ uid }}.ax-portal .ax-indice-tit{font-family:var(--texto);color:var(--gris);font-size:11px}
  #ax-nota-{{ uid }}.ax-portal .ax-indice ol{font-family:var(--texto);font-size:15.5px}
  #ax-nota-{{ uid }}.ax-portal .ax-indice a{text-decoration-color:rgb(var(--r-portal_rojo))}

  

  #ax-nota-{{ uid }}.ax-portal{
    --tinta:rgb(var(--r-portal_texto));--papel:rgb(var(--r-portal_fondo));--papel-2:rgb(var(--r-portal_fondo_2));--lima:rgb(var(--r-portal_acento));--lima-honda:rgb(var(--r-portal_acento_hondo));
    --gris:rgb(var(--r-portal_gris));--linea:rgb(var(--r-portal_linea));
    --impacto:var(--r-portal_letra_titulos);
    --lectura:'Georgia','Times New Roman',serif;
    --texto:var(--r-portal_letra_texto);
    background:var(--papel);background-image:none;color:var(--tinta)}
  #ax-nota-{{ uid }}.ax-portal .ax-col{max-width:700px;padding:0 18px}

  
  #ax-nota-{{ uid }}.ax-portal .ax-cinta{background:var(--papel-2);color:var(--gris);
    font-family:var(--texto);font-size:10px;letter-spacing:.1em;font-weight:600;
    border-bottom:1px solid var(--linea);padding:8px 18px}
  #ax-nota-{{ uid }}.ax-portal .ax-cab{padding-top:22px}
  #ax-nota-{{ uid }}.ax-portal .ax-eye{background:none;color:rgb(var(--r-portal_rojo));padding:0;transform:none;
    font-family:var(--texto);font-weight:700;font-size:12px;letter-spacing:.09em;margin:0 0 10px}
  #ax-nota-{{ uid }}.ax-portal .ax-eye span{transform:none}
  #ax-nota-{{ uid }}.ax-portal h1{font-family:var(--impacto);font-weight:800;text-transform:none;
    transform:none;display:block;font-size:clamp(28px,7.4vw,42px);line-height:1.08;
    letter-spacing:-.022em;margin:0 0 14px}
  #ax-nota-{{ uid }}.ax-portal h1 em{background:none;padding:0;font-style:normal}
  #ax-nota-{{ uid }}.ax-portal .ax-bajada{font-family:var(--texto);font-size:18.5px;line-height:1.45;
    font-weight:400;color:rgb(var(--r-portal_bajada));margin:0 0 16px}
  #ax-nota-{{ uid }}.ax-portal .ax-firma-top{border-top:1px solid var(--linea);
    border-bottom:1px solid var(--linea);font-family:var(--texto);font-size:12.5px;
    letter-spacing:0;text-transform:none;color:var(--gris);padding:11px 0;margin:0 0 22px;font-weight:500}

  
  #ax-nota-{{ uid }}.ax-portal .ax-p{font-family:var(--lectura);font-size:18px;line-height:1.68;
    margin:0 0 20px;color:rgb(var(--r-portal_parrafo))}
  #ax-nota-{{ uid }}.ax-portal .ax-p strong{background:none;padding:0;font-weight:700}
  #ax-nota-{{ uid }}.ax-portal .ax-p p{margin:0 0 20px}
  #ax-nota-{{ uid }}.ax-portal h2{font-family:var(--impacto);font-weight:800;text-transform:none;
    transform:none;display:block;font-size:clamp(20px,5vw,25px);line-height:1.2;
    letter-spacing:-.015em;margin:34px 0 12px}
  #ax-nota-{{ uid }}.ax-portal .ax-dest{background:var(--papel);color:var(--tinta);
    border-left:4px solid rgb(var(--r-portal_rojo));padding:4px 0 4px 18px;margin:26px 0;
    font-family:var(--impacto);font-weight:700;text-transform:none;letter-spacing:-.01em;
    font-size:clamp(19px,4.6vw,23px);line-height:1.3}
  #ax-nota-{{ uid }}.ax-portal .ax-dest em{background:none;color:inherit;padding:0;
    border-bottom:3px solid var(--lima)}

  
  #ax-nota-{{ uid }}.ax-portal .ax-img{border:none;margin:22px 0}
  #ax-nota-{{ uid }}.ax-portal .ax-img figcaption{background:none;color:var(--gris);
    font-family:var(--texto);font-size:13px;line-height:1.4;padding:8px 0 0;letter-spacing:0;
    border-bottom:1px solid var(--linea);padding-bottom:12px}
  #ax-nota-{{ uid }}.ax-portal .ax-tira figure{border:1px solid var(--linea);background:var(--papel)}
  #ax-nota-{{ uid }}.ax-portal .ax-tira figcaption{color:var(--gris);background:var(--papel)}

  
  #ax-nota-{{ uid }}.ax-portal .ax-test{border:none;border-top:3px solid var(--tinta);
    border-bottom:1px solid var(--linea);padding:14px 0;background:none}
  #ax-nota-{{ uid }}.ax-portal .ax-test b{font-family:var(--texto);font-size:11px;
    letter-spacing:.12em;color:rgb(var(--r-portal_rojo));text-transform:uppercase;margin:0 0 8px}
  #ax-nota-{{ uid }}.ax-portal .ax-test i{font-family:var(--impacto);font-weight:700;font-size:19px;
    line-height:1.25;color:var(--tinta);display:block}
  #ax-nota-{{ uid }}.ax-portal .ax-test u{background:none;color:rgb(var(--r-portal_rojo));transform:none;
    font-family:var(--texto);font-size:13px;letter-spacing:.02em;padding:0;margin-top:9px}
  #ax-nota-{{ uid }}.ax-portal .ax-test u span{transform:none}

  
  #ax-nota-{{ uid }}.ax-portal .ax-voces{border:1px solid var(--linea)}
  #ax-nota-{{ uid }}.ax-portal .ax-voces-tit{background:var(--papel-2);color:var(--gris);
    font-family:var(--texto);font-size:11px;letter-spacing:.1em}
  #ax-nota-{{ uid }}.ax-portal .ax-voces blockquote{font-family:var(--lectura);font-size:17px;
    border-bottom:1px solid var(--linea)}
  #ax-nota-{{ uid }}.ax-portal .ax-voces cite{font-family:var(--texto);color:var(--gris)}
  #ax-nota-{{ uid }}.ax-portal .ax-voces-pie{background:var(--papel-2);color:var(--gris);
    font-family:var(--texto)}

  
  #ax-nota-{{ uid }}.ax-portal .ax-demo{border:1px solid var(--linea)}
  #ax-nota-{{ uid }}.ax-portal .ax-demo-tit{background:var(--papel-2);color:var(--tinta);
    font-family:var(--texto);font-size:11.5px;letter-spacing:.08em;border-bottom:1px solid var(--linea)}
  #ax-nota-{{ uid }}.ax-portal .ax-demo-pie{background:var(--papel);color:var(--gris);
    font-family:var(--texto);border-top:1px solid var(--linea)}
  #ax-nota-{{ uid }}.ax-portal .ax-dia-riel{border:1px solid var(--linea)}
  #ax-nota-{{ uid }}.ax-portal .ax-dia-marcas li{font-family:var(--texto)}
  #ax-nota-{{ uid }}.ax-portal .ax-dia-marcas b{background:var(--tinta);color:rgb(var(--r-portal_fondo))}
  #ax-nota-{{ uid }}.ax-portal .ax-sem-dias i{border:1px solid var(--linea)}
  #ax-nota-{{ uid }}.ax-portal .ax-sem-dias i.vuelve{background:rgb(var(--r-portal_rojo))}
  #ax-nota-{{ uid }}.ax-portal .ax-vs-col b{border:1px solid var(--linea);font-family:var(--texto)}
  #ax-nota-{{ uid }}.ax-portal .ax-vs-col li{font-family:var(--texto);border-bottom:1px solid var(--linea)}
  #ax-nota-{{ uid }}.ax-portal .ax-vs-col li::before{background:var(--tinta);color:rgb(var(--r-portal_fondo))}
  #ax-nota-{{ uid }}.ax-portal .ax-ciclo text{font-family:var(--texto);fill:var(--tinta)}
  #ax-nota-{{ uid }}.ax-portal .ax-ciclo .nodo{fill:var(--papel);stroke:var(--tinta);stroke-width:2}
  #ax-nota-{{ uid }}.ax-portal .ax-ciclo .aro{stroke:var(--linea);opacity:1}

  
  #ax-nota-{{ uid }}.ax-portal .ax-caja{background:rgb(var(--r-portal_caja));color:var(--tinta);
    border:1px solid var(--linea);border-top:4px solid var(--lima)}
  #ax-nota-{{ uid }}.ax-portal .ax-caja h3{font-family:var(--impacto);text-transform:none;font-weight:800}
  #ax-nota-{{ uid }}.ax-portal .ax-caja .ax-sub{font-family:var(--texto);opacity:1;color:var(--gris)}
  #ax-nota-{{ uid }}.ax-portal .ax-caja img{background:rgb(var(--r-portal_fondo));border:1px solid var(--linea)}
  #ax-nota-{{ uid }}.ax-portal .ax-precio b{font-family:var(--impacto);font-weight:800}
  #ax-nota-{{ uid }}.ax-portal .ax-precio s{font-family:var(--texto)}
  #ax-nota-{{ uid }}.ax-portal .ax-cta{background:var(--lima);color:rgb(var(--r-portal_texto));transform:none;
    font-family:var(--impacto);font-weight:800;text-transform:none;font-size:17px;border-radius:3px}
  #ax-nota-{{ uid }}.ax-portal .ax-cta span{transform:none}
  #ax-nota-{{ uid }}.ax-portal .ax-caja-pie{font-family:var(--texto);color:var(--gris)}
  #ax-nota-{{ uid }}.ax-portal .ax-caja-pie svg{color:var(--lima-honda)}
  #ax-nota-{{ uid }}.ax-portal .ax-cta-suelto .ax-linea{font-family:var(--texto);color:var(--gris)}
  #ax-nota-{{ uid }}.ax-portal .ax-firma{background:var(--papel-2);border-left:3px solid var(--tinta);
    font-family:var(--texto)}
  #ax-nota-{{ uid }}.ax-portal .ax-firma b{font-family:var(--impacto);text-transform:none;font-weight:800}
  #ax-nota-{{ uid }}.ax-portal .ax-legal{font-family:var(--texto);border-top:1px solid var(--linea);
    color:var(--gris);opacity:1;font-size:12px}

  
  #ax-nota-{{ uid }} .ax-temas{margin:26px 0 0;padding:16px 0 0;border-top:1px solid var(--linea)}
  #ax-nota-{{ uid }} .ax-temas p{margin:0 0 9px;font-family:var(--texto);font-size:11px;
    letter-spacing:.1em;text-transform:uppercase;color:var(--gris);font-weight:600}
  #ax-nota-{{ uid }} .ax-temas ul{display:flex;flex-wrap:wrap;gap:7px;list-style:none;margin:0;padding:0}
  #ax-nota-{{ uid }} .ax-temas li{font-family:var(--texto);font-size:13px;padding:6px 11px;
    background:var(--papel-2);border:1px solid var(--linea);border-radius:3px;color:rgb(var(--r-portal_bajada))}

  
  #ax-barra-{{ uid }}.ax-portal-barra{background:rgb(var(--r-portal_texto))}
  #ax-barra-{{ uid }}.ax-portal-barra a{background:rgb(var(--r-portal_acento));border-radius:3px;transform:none;
    font-family:{%- if section.settings.portal_letra_titulos != blank -%}'{{ section.settings.portal_letra_titulos.family }}',Arial,sans-serif{%- else -%}var(--font-heading-family){%- endif -%};font-weight:800;text-transform:none}
  #ax-barra-{{ uid }}.ax-portal-barra a span{transform:none}

  

  #ax-nota-{{ uid }} .ax-demo{margin:26px 0;border:3px solid var(--tinta);background:var(--papel)}
  #ax-nota-{{ uid }} .ax-demo-tit{background:var(--tinta);color:var(--papel);font-family:var(--impacto);
    font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;padding:9px 14px;margin:0;line-height:1.3}
  #ax-nota-{{ uid }} .ax-demo-cuerpo{padding:18px 16px}
  #ax-nota-{{ uid }} .ax-demo-pie{margin:0;padding:11px 14px;background:var(--papel-2);
    font-family:var(--texto);font-size:13.5px;line-height:1.4}

  
  #ax-nota-{{ uid }} .ax-dia-riel{position:relative;height:56px;border:3px solid var(--tinta);
    background:var(--papel);overflow:hidden}
  #ax-nota-{{ uid }} .ax-dia-h{position:absolute;top:0;bottom:0;
    background:repeating-linear-gradient(-45deg,var(--lima) 0 7px,var(--lima-honda) 7px 14px);
    transform-origin:left}
  #ax-nota-{{ uid }}.ax-armado .ax-dia-h{transform:scaleX(0)}
  #ax-nota-{{ uid }} .ax-va .ax-dia-h{transform:scaleX(1);transition:transform .55s ease}
  #ax-nota-{{ uid }} .ax-dia-h.d1{left:8%;width:13%;transition-delay:.05s}
  #ax-nota-{{ uid }} .ax-dia-h.d2{left:26%;width:34%;transition-delay:.35s}
  #ax-nota-{{ uid }} .ax-dia-h.d3{left:66%;width:16%;transition-delay:.65s}
  #ax-nota-{{ uid }} .ax-dia-h.d4{left:86%;width:9%;transition-delay:.95s}
  #ax-nota-{{ uid }} .ax-dia-horas{display:flex;justify-content:space-between;margin:7px 0 0;
    font-family:var(--impacto);font-size:9.5px;letter-spacing:.1em;opacity:.65}
  #ax-nota-{{ uid }} .ax-dia-marcas{list-style:none;margin:14px 0 0;padding:0;display:grid;gap:8px}
  #ax-nota-{{ uid }} .ax-dia-marcas li{display:flex;gap:9px;align-items:flex-start;
    font-family:var(--texto);font-size:15px;line-height:1.35}
  #ax-nota-{{ uid }} .ax-dia-marcas b{font-family:var(--impacto);font-size:12px;letter-spacing:.06em;
    background:var(--lima);padding:3px 7px;flex:none;text-transform:uppercase}

  
  #ax-nota-{{ uid }} .ax-ciclo{display:block;width:100%;max-width:330px;margin:0 auto;height:auto}
  #ax-nota-{{ uid }} .ax-ciclo .aro{fill:none;stroke:var(--tinta);stroke-width:3;stroke-dasharray:9 7;opacity:.35}
  #ax-nota-{{ uid }} .ax-ciclo .nodo{fill:var(--papel);stroke:var(--tinta);stroke-width:3}
  #ax-nota-{{ uid }} .ax-ciclo text{font-family:var(--texto);font-size:13px;fill:var(--tinta);text-anchor:middle}
  #ax-nota-{{ uid }} .ax-ciclo .num{font-family:var(--impacto);font-size:15px}
  #ax-nota-{{ uid }} .ax-ciclo .bolita{fill:var(--lima-honda);stroke:var(--tinta);stroke-width:2.5}
  #ax-nota-{{ uid }} .ax-va .ax-ciclo .rota{animation:ax-gira-{{ uid }} 9s linear infinite}
  @keyframes ax-gira-{{ uid }}{to{transform:rotate(360deg)}}
  #ax-nota-{{ uid }} .ax-ciclo .rota{transform-origin:160px 174px}

  
  #ax-nota-{{ uid }} .ax-sem{display:grid;gap:16px}
  #ax-nota-{{ uid }} .ax-sem-fila b{display:block;font-family:var(--impacto);font-size:12px;
    letter-spacing:.08em;text-transform:uppercase;margin:0 0 7px}
  #ax-nota-{{ uid }} .ax-sem-dias{display:flex;gap:3px;flex-wrap:nowrap}
  #ax-nota-{{ uid }} .ax-sem-dias i{flex:1 1 0;height:26px;border:2px solid var(--tinta);
    background:var(--papel-2)}
  #ax-nota-{{ uid }}.ax-armado .ax-sem-dias i{opacity:0}
  #ax-nota-{{ uid }} .ax-va .ax-sem-dias i{opacity:1;transition:opacity .18s ease}
  #ax-nota-{{ uid }} .ax-sem-dias i.usa{background:var(--lima)}
  #ax-nota-{{ uid }} .ax-sem-dias i.extra{background:var(--lima-honda)}
  #ax-nota-{{ uid }} .ax-sem-dias i.vuelve{background:var(--tinta)}
  #ax-nota-{{ uid }} .ax-sem-pie{margin:7px 0 0;font-family:var(--texto);font-size:14px;line-height:1.35}
  #ax-nota-{{ uid }} .ax-sem-pie em{font-style:normal;background:var(--lima);padding:1px 5px}

  
  #ax-nota-{{ uid }} .ax-vs{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  #ax-nota-{{ uid }} .ax-vs-col b{display:block;font-family:var(--impacto);font-size:12.5px;
    letter-spacing:.06em;text-transform:uppercase;padding:8px 10px;text-align:center;
    background:var(--papel-2);border:3px solid var(--tinta);margin:0 0 9px}
  #ax-nota-{{ uid }} .ax-vs-col.nuestra b{background:var(--lima)}
  #ax-nota-{{ uid }} .ax-vs-col ol{list-style:none;margin:0;padding:0;counter-reset:paso}
  #ax-nota-{{ uid }} .ax-vs-col li{counter-increment:paso;position:relative;padding:7px 0 7px 26px;
    font-family:var(--texto);font-size:14.5px;line-height:1.3;border-bottom:2px dotted var(--papel-2)}
  #ax-nota-{{ uid }}.ax-armado .ax-vs-col li{opacity:0;transform:translateY(6px)}
  #ax-nota-{{ uid }} .ax-va .ax-vs-col li{opacity:1;transform:none;transition:opacity .3s ease,transform .3s ease}
  #ax-nota-{{ uid }} .ax-vs-col li::before{content:counter(paso);position:absolute;left:0;top:7px;
    font-family:var(--impacto);font-size:11px;width:18px;height:18px;line-height:18px;text-align:center;
    background:var(--tinta);color:var(--papel)}
  #ax-nota-{{ uid }} .ax-vs-col.nuestra li::before{background:var(--lima-honda);color:var(--tinta)}
  #ax-nota-{{ uid }} .ax-vs-total{margin:10px 0 0;font-family:var(--impacto);font-size:12px;
    letter-spacing:.06em;text-transform:uppercase;text-align:center}

  
  #ax-nota-{{ uid }} .ax-video video{display:block;width:100%;height:auto;background:var(--tinta)}

  
  #ax-nota-{{ uid }} .ax-tira{display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;
    -webkit-overflow-scrolling:touch;scrollbar-width:none;padding:0 0 4px}
  #ax-nota-{{ uid }} .ax-tira::-webkit-scrollbar{display:none}
  #ax-nota-{{ uid }} .ax-tira figure{flex:0 0 76%;scroll-snap-align:center;margin:0;
    border:3px solid var(--tinta);background:var(--tinta)}
  #ax-nota-{{ uid }} .ax-tira img{display:block;width:100%;height:auto}
  #ax-nota-{{ uid }} .ax-tira figcaption{font-family:var(--texto);font-size:13px;padding:8px 11px;
    color:var(--papel);line-height:1.35}

  @media (min-width:750px){
    #ax-nota-{{ uid }} .ax-tira figure{flex:0 0 46%}
  }
  
  @media (prefers-reduced-motion:reduce){
    #ax-nota-{{ uid }} .ax-dia-h,#ax-nota-{{ uid }} .ax-sem-dias i,#ax-nota-{{ uid }} .ax-vs-col li{
      transition:none !important;transform:none !important;opacity:1 !important}
    #ax-nota-{{ uid }} .ax-ciclo .rota{animation:none !important}
  }

  
  #ax-nota-{{ uid }} .ax-legal{margin:34px 0 0;padding:14px 0 0;border-top:2px solid var(--tinta);
    font-family:var(--texto);font-size:12.5px;line-height:1.5;opacity:.75}

  
  #ax-barra-{{ uid }}{position:fixed;left:0;right:0;bottom:0;z-index:60;background:rgb(var(--r-texto));
    padding:10px 14px;display:flex;gap:12px;align-items:center;justify-content:space-between;
    transform:translateY(120px);transition:transform .22s ease;
    font-family:{%- if section.settings.letra_texto != blank -%}'{{ section.settings.letra_texto.family }}','Barlow',Arial,sans-serif{%- else -%}var(--font-body-family){%- endif -%}}
  #ax-barra-{{ uid }}.ax-ver{transform:translateY(0)}
  #ax-barra-{{ uid }} .ax-b-txt{color:rgb(var(--r-fondo));font-size:13px;line-height:1.2}
  #ax-barra-{{ uid }} .ax-b-txt b{display:block;font-family:{%- if section.settings.letra_titulos != blank -%}'{{ section.settings.letra_titulos.family }}',Arial,sans-serif{%- else -%}var(--font-heading-family){%- endif -%};font-size:16px}
  #ax-barra-{{ uid }} a{background:rgb(var(--r-acento));color:rgb(var(--r-texto));font-family:{%- if section.settings.letra_titulos != blank -%}'{{ section.settings.letra_titulos.family }}',Arial,sans-serif{%- else -%}var(--font-heading-family){%- endif -%};
    text-transform:uppercase;font-size:14px;padding:15px 14px;text-decoration:none;
    transform:skewX(-9deg);white-space:nowrap;flex:none}
  #ax-barra-{{ uid }} a span{display:inline-block;transform:skewX(9deg)}

  @media (min-width:750px){
    #ax-nota-{{ uid }} .ax-col{padding:0 24px}
    #ax-nota-{{ uid }} .ax-caja img{width:120px;height:120px}
    #ax-barra-{{ uid }}{display:none}
  }
{% endstyle %}

<div id="ax-nota-{{ uid }}" class="{% if section.settings.estilo == 'portal' %}ax-portal{% endif %}" style="--r-texto: {%- render 'gad-rol', c: section.settings.color_texto, d: 'var(--color-foreground)' -%}; --r-fondo: {%- render 'gad-rol', c: section.settings.color_fondo, d: 'var(--color-background)' -%}; --r-fondo_2: {%- render 'gad-rol', c: section.settings.color_fondo_2, d: 'var(--color-background-suave)' -%}; --r-acento: {%- render 'gad-rol', c: section.settings.color_acento, d: 'var(--color-background-contrast)' -%}; --r-acento_hondo: {%- render 'gad-rol', c: section.settings.color_acento_hondo, d: 'var(--color-background-suave)' -%}; --r-portal_texto: {%- render 'gad-rol', c: section.settings.color_portal_texto, d: 'var(--color-foreground)' -%}; --r-portal_fondo: {%- render 'gad-rol', c: section.settings.color_portal_fondo, d: 'var(--color-background)' -%}; --r-portal_fondo_2: {%- render 'gad-rol', c: section.settings.color_portal_fondo_2, d: 'var(--color-background-suave)' -%}; --r-portal_acento: {%- render 'gad-rol', c: section.settings.color_portal_acento, d: 'var(--color-background-contrast)' -%}; --r-portal_acento_hondo: {%- render 'gad-rol', c: section.settings.color_portal_acento_hondo, d: 'var(--color-foreground)' -%}; --r-portal_gris: {%- render 'gad-rol', c: section.settings.color_portal_gris, d: 'var(--color-foreground)' -%}; --r-portal_linea: {%- render 'gad-rol', c: section.settings.color_portal_linea, d: 'var(--color-background-contrast)' -%}; --r-portal_rojo: {%- render 'gad-rol', c: section.settings.color_portal_rojo, d: 'var(--color-button)' -%}; --r-portal_caja: {%- render 'gad-rol', c: section.settings.color_portal_caja, d: 'var(--color-background-suave)' -%}; --r-portal_bajada: {%- render 'gad-rol', c: section.settings.color_portal_bajada, d: 'var(--color-foreground)' -%}; --r-portal_parrafo: {%- render 'gad-rol', c: section.settings.color_portal_parrafo, d: 'var(--color-foreground)' -%}; --r-letra_titulos: {% if section.settings.letra_titulos != blank %}'{{ section.settings.letra_titulos.family }}','Arial Black',Haettenschweiler,Impact,sans-serif{% else %}var(--font-heading-family){% endif %}; --r-letra_texto: {% if section.settings.letra_texto != blank %}'{{ section.settings.letra_texto.family }}','Barlow','Segoe UI',Arial,sans-serif{% else %}var(--font-body-family){% endif %}; --r-letra_lectura: {% if section.settings.letra_lectura != blank %}'{{ section.settings.letra_lectura.family }}','Barlow Semi Condensed','Segoe UI',Arial,sans-serif{% else %}var(--font-body-family){% endif %}; --r-portal_letra_titulos: {% if section.settings.portal_letra_titulos != blank %}'{{ section.settings.portal_letra_titulos.family }}','Helvetica Neue',Helvetica,Arial,sans-serif{% else %}var(--font-heading-family){% endif %}; --r-portal_letra_texto: {% if section.settings.portal_letra_texto != blank %}'{{ section.settings.portal_letra_texto.family }}','Helvetica Neue',Arial,sans-serif{% else %}var(--font-body-family){% endif %};">
  {%- if section.settings.cinta != blank -%}
    <div class="ax-cinta">{{ section.settings.cinta }}</div>
  {%- endif -%}

  <article class="ax-col ax-cab">
    {%- if section.settings.eyebrow != blank -%}
      <span class="ax-eye"><span>{{ section.settings.eyebrow }}</span></span>
    {%- endif -%}

    <h1>{{ section.settings.titulo }}</h1>

    {%- if section.settings.bajada != blank -%}
      <p class="ax-bajada">{{ section.settings.bajada }}</p>
    {%- endif -%}

    {%- if section.settings.autor != blank or section.settings.dato != blank -%}
      <div class="ax-firma-top">
        {%- if section.settings.autor != blank -%}<span>{{ section.settings.autor }}</span>{%- endif -%}
        {%- if section.settings.dato != blank -%}<i>·</i><i>{{ section.settings.dato }}</i>{%- endif -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'subtitulo' -%}
          <h2 id="ax-s-{{ uid }}-{{ forloop.index }}" {{ block.shopify_attributes }}>{{ block.settings.texto }}</h2>

        {%- when 'parrafo' -%}
          <div class="ax-p" {{ block.shopify_attributes }}>{{ block.settings.texto }}</div>

        {%- when 'destacado' -%}
          <p class="ax-dest" {{ block.shopify_attributes }}>{{ block.settings.texto }}</p>

        {%- when 'imagen' -%}
          {%- if block.settings.imagen != blank -%}
            <figure class="ax-img" {{ block.shopify_attributes }}>
              <img src="{{ block.settings.imagen | image_url: width: 1200 }}"
                   alt="{{ block.settings.alt | escape }}" loading="lazy" width="1200" height="900">
              {%- if block.settings.pie != blank -%}<figcaption>{{ block.settings.pie }}</figcaption>{%- endif -%}
            </figure>
          {%- endif -%}

        {%- when 'firma' -%}
          <div class="ax-firma" {{ block.shopify_attributes }}>
            <b>{{ block.settings.nombre }}</b>
            {%- if block.settings.rol != blank -%}<i>{{ block.settings.rol }}</i>{%- endif -%}
          </div>

        {%- when 'test' -%}
          <a class="ax-test" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
            <b>{{ block.settings.titulo }}</b>
            <i>{{ block.settings.texto }}</i>
            <u><span>{{ block.settings.boton }}</span></u>
          </a>

        {%- comment -%} ── INDICE (se genera de los subtitulos de la nota) ── {%- endcomment -%}
        {%- when 'indice' -%}
          {%- comment -%} sólo lista lo que viene DESPUÉS del índice, o se lista a sí mismo {%- endcomment -%}
          {%- assign pos_indice = forloop.index -%}
          <nav class="ax-indice" {{ block.shopify_attributes }} aria-label="Contenido de la nota">
            {%- if block.settings.titulo != blank -%}<p class="ax-indice-tit">{{ block.settings.titulo }}</p>{%- endif -%}
            <ol>
              {%- for b in section.blocks -%}
                {%- if b.type == 'subtitulo' and b.settings.texto != blank and forloop.index > pos_indice -%}
                  <li><a href="#ax-s-{{ uid }}-{{ forloop.index }}">{{ b.settings.texto }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ol>
          </nav>

        {%- comment -%} ── DEMO 1 · el día ── {%- endcomment -%}
        {%- when 'dia' -%}
          <div class="ax-demo ax-mira" {{ block.shopify_attributes }}>
            <p class="ax-demo-tit">{{ block.settings.titulo }}</p>
            <div class="ax-demo-cuerpo">
              <div class="ax-dia-riel">
                <span class="ax-dia-h d1"></span><span class="ax-dia-h d2"></span>
                <span class="ax-dia-h d3"></span><span class="ax-dia-h d4"></span>
              </div>
              <div class="ax-dia-horas"><span>7:00</span><span>13:00</span><span>19:00</span><span>23:00</span></div>
              <ul class="ax-dia-marcas">
                {%- assign marcas = block.settings.marcas | newline_to_br | split: '<br />' -%}
                {%- for m in marcas -%}
                  {%- assign partes = m | strip | split: '|' -%}
                  {%- if partes[0] != blank -%}
                    <li><b>{{ partes[0] | strip }}</b><span>{{ partes[1] | strip }}</span></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
            {%- if block.settings.pie != blank -%}<p class="ax-demo-pie">{{ block.settings.pie }}</p>{%- endif -%}
          </div>

        {%- comment -%} ── DEMO 2 · el ciclo ── {%- endcomment -%}
        {%- when 'ciclo' -%}
          <div class="ax-demo ax-mira" {{ block.shopify_attributes }}>
            <p class="ax-demo-tit">{{ block.settings.titulo }}</p>
            <div class="ax-demo-cuerpo">
              {%- comment -%}
                El número va DENTRO del círculo y la etiqueta AFUERA: adentro se
                desborda con cualquier palabra de más de seis letras. Y la bolita
                se dibuja al final, o los nodos la tapan.
              {%- endcomment -%}
              <svg class="ax-ciclo" viewBox="0 0 320 348" role="img"
                   aria-label="{{ block.settings.n1 }}, {{ block.settings.n2 }}, {{ block.settings.n3 }}, {{ block.settings.n4 }}, y otra vez desde el principio">
                <circle class="aro" cx="160" cy="174" r="104"/>
                <circle class="nodo" cx="160" cy="70"  r="31"/><text class="num" x="160" y="78">1</text><text x="160" y="26">{{ block.settings.n1 }}</text>
                <circle class="nodo" cx="264" cy="174" r="31"/><text class="num" x="264" y="182">2</text><text x="264" y="228">{{ block.settings.n2 }}</text>
                <circle class="nodo" cx="160" cy="278" r="31"/><text class="num" x="160" y="286">3</text><text x="160" y="332">{{ block.settings.n3 }}</text>
                <circle class="nodo" cx="56"  cy="174" r="31"/><text class="num" x="56"  y="182">4</text><text x="56"  y="228">{{ block.settings.n4 }}</text>
                <g class="rota"><circle class="bolita" cx="160" cy="110" r="9"/></g>
              </svg>
            </div>
            {%- if block.settings.pie != blank -%}<p class="ax-demo-pie">{{ block.settings.pie }}</p>{%- endif -%}
          </div>

        {%- comment -%} ── DEMO 3 · la semana de más ── {%- endcomment -%}
        {%- when 'semana' -%}
          <div class="ax-demo ax-mira" {{ block.shopify_attributes }}>
            <p class="ax-demo-tit">{{ block.settings.titulo }}</p>
            <div class="ax-demo-cuerpo ax-sem">
              <div class="ax-sem-fila">
                <b>{{ block.settings.fila_a }}</b>
                <div class="ax-sem-dias">
                  {%- for i in (1..21) -%}
                    {%- if i <= 10 -%}<i class="usa" style="transition-delay:{{ i | times: 30 }}ms"></i>
                    {%- else -%}<i class="vuelve" style="transition-delay:{{ i | times: 30 }}ms"></i>{%- endif -%}
                  {%- endfor -%}
                </div>
                <p class="ax-sem-pie">{{ block.settings.pie_a }}</p>
              </div>
              <div class="ax-sem-fila">
                <b>{{ block.settings.fila_b }}</b>
                <div class="ax-sem-dias">
                  {%- for i in (1..21) -%}
                    {%- if i <= 10 -%}<i class="usa" style="transition-delay:{{ i | times: 30 }}ms"></i>
                    {%- elsif i <= 17 -%}<i class="extra" style="transition-delay:{{ i | times: 30 }}ms"></i>
                    {%- else -%}<i style="transition-delay:{{ i | times: 30 }}ms"></i>{%- endif -%}
                  {%- endfor -%}
                </div>
                <p class="ax-sem-pie">{{ block.settings.pie_b }}</p>
              </div>
            </div>
          </div>

        {%- comment -%} ── DEMO 4 · versus (pasos contra pasos) ── {%- endcomment -%}
        {%- when 'versus' -%}
          <div class="ax-demo ax-mira" {{ block.shopify_attributes }}>
            <p class="ax-demo-tit">{{ block.settings.titulo }}</p>
            <div class="ax-demo-cuerpo">
              <div class="ax-vs">
                {%- assign izq = block.settings.pasos_a | newline_to_br | split: '<br />' -%}
                {%- assign der = block.settings.pasos_b | newline_to_br | split: '<br />' -%}
                <div class="ax-vs-col">
                  <b>{{ block.settings.col_a }}</b>
                  <ol>{%- for x in izq -%}{%- if x != blank -%}<li style="transition-delay:{{ forloop.index | times: 120 }}ms">{{ x | strip }}</li>{%- endif -%}{%- endfor -%}</ol>
                  <p class="ax-vs-total">{{ izq.size }} pasos</p>
                </div>
                <div class="ax-vs-col nuestra">
                  <b>{{ block.settings.col_b }}</b>
                  <ol>{%- for x in der -%}{%- if x != blank -%}<li style="transition-delay:{{ forloop.index | times: 120 }}ms">{{ x | strip }}</li>{%- endif -%}{%- endfor -%}</ol>
                  <p class="ax-vs-total">{{ der.size }} pasos</p>
                </div>
              </div>
            </div>
            {%- if block.settings.pie != blank -%}<p class="ax-demo-pie">{{ block.settings.pie }}</p>{%- endif -%}
          </div>

        {%- comment -%} ── DEMO 5 · video ── {%- endcomment -%}
        {%- when 'video' -%}
          {%- if block.settings.video != blank -%}
            <div class="ax-demo ax-video" {{ block.shopify_attributes }}>
              {%- if block.settings.titulo != blank -%}<p class="ax-demo-tit">{{ block.settings.titulo }}</p>{%- endif -%}
              {{ block.settings.video | video_tag: image_size: '800x', autoplay: true, loop: true, muted: true, controls: false }}
              {%- if block.settings.pie != blank -%}<p class="ax-demo-pie">{{ block.settings.pie }}</p>{%- endif -%}
            </div>
          {%- endif -%}

        {%- comment -%} ── DEMO 6 · tira de escenas ── {%- endcomment -%}
        {%- when 'tira' -%}
          <div class="ax-tira" {{ block.shopify_attributes }}>
            {%- for n in (1..3) -%}
              {%- assign clave = 'img_' | append: n -%}
              {%- assign cap = 'pie_' | append: n -%}
              {%- if block.settings[clave] != blank -%}
                <figure>
                  <img src="{{ block.settings[clave] | image_url: width: 700 }}" alt="{{ block.settings[cap] | escape }}" loading="lazy" width="700" height="875">
                  {%- if block.settings[cap] != blank -%}<figcaption>{{ block.settings[cap] }}</figcaption>{%- endif -%}
                </figure>
              {%- endif -%}
            {%- endfor -%}
          </div>

        {%- when 'citas' -%}
          <div class="ax-voces" {{ block.shopify_attributes }}>
            {%- if block.settings.titulo != blank -%}
              <p class="ax-voces-tit">{{ block.settings.titulo }}</p>
            {%- endif -%}
            <blockquote>&laquo;{{ block.settings.cita_1 }}&raquo;<cite>{{ block.settings.fuente_1 }}</cite></blockquote>
            {%- if block.settings.cita_2 != blank -%}
              <blockquote>&laquo;{{ block.settings.cita_2 }}&raquo;<cite>{{ block.settings.fuente_2 }}</cite></blockquote>
            {%- endif -%}
            {%- if block.settings.pie != blank -%}
              <p class="ax-voces-pie">{{ block.settings.pie }}</p>
            {%- endif -%}
          </div>

        {%- when 'cta' -%}
          <div class="ax-cta-suelto" {{ block.shopify_attributes }}>
            {%- if block.settings.linea != blank -%}
              <p class="ax-linea">{{ block.settings.linea }}</p>
            {%- endif -%}
            <a class="ax-cta" href="{{ p.url | default: '#' }}{{ section.settings.utm }}">
              <span>{{ block.settings.boton }}</span>
            </a>
          </div>

        {%- when 'caja' -%}
          <div class="ax-caja" {{ block.shopify_attributes }}>
            <div class="ax-caja-top">
              {%- if p.featured_image != blank -%}
                <img src="{{ p.featured_image | image_url: width: 300 }}"
                     alt="{{ p.featured_image.alt | escape }}" loading="lazy" width="300" height="300">
              {%- endif -%}
              <div>
                <h3>{{ block.settings.titulo }}</h3>
                <div class="ax-sub">{{ block.settings.sub }}</div>
              </div>
            </div>

            {%- if p != blank -%}
              <div class="ax-precio">
                <b>{{ p.price | money }}</b>
                {%- if p.compare_at_price > p.price -%}
                  <s>{{ p.compare_at_price | money }}</s>
                  {%- comment -%} el round es obligatorio: sin él, fuera de Shopify la división da 25.000312503906297 {%- endcomment -%}
                  {%- assign off = p.compare_at_price | minus: p.price | times: 100.0 | divided_by: p.compare_at_price | round -%}
                  <em><span>Ahorr&aacute;s {{ off }}&#37;</span></em>
                {%- endif -%}
              </div>
            {%- endif -%}

            <a class="ax-cta" href="{{ p.url | default: '#' }}{{ section.settings.utm }}">
              <span>{{ block.settings.boton }}</span>
            </a>

            {%- if block.settings.pie != blank -%}
              <p class="ax-caja-pie">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5Z"/><path d="m9 12 2 2 4-4"/>
                </svg>
                <span>{{ block.settings.pie }}</span>
              </p>
            {%- endif -%}
          </div>

      {%- endcase -%}
    {%- endfor -%}

    {%- if section.settings.temas != blank -%}
      <div class="ax-temas">
        <p>{{ section.settings.temas_titulo | default: 'Temas de la nota' }}</p>
        <ul>
          {%- assign temas = section.settings.temas | split: ',' -%}
          {%- for t in temas -%}{%- if t != blank -%}<li>{{ t | strip }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if section.settings.legal != blank -%}
      <p class="ax-legal">{{ section.settings.legal }}</p>
    {%- endif -%}
  </article>
</div>

<script>
  
  (function () {
    var caja = document.getElementById('ax-nota-{{ uid }}');
    if (!caja || caja.dataset.axDemos) return;
    caja.dataset.axDemos = '1';
    var demos = [].slice.call(caja.querySelectorAll('.ax-mira'));
    if (!demos.length || !('IntersectionObserver' in window)) return;
    caja.classList.add('ax-armado');
    var ojo = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('ax-va'); ojo.unobserve(e.target); }
      });
    }, { threshold: 0.35 });
    demos.forEach(function (d) { ojo.observe(d); });
  })();
</script>

{%- if section.settings.barra -%}
  <div id="ax-barra-{{ uid }}" class="{% if section.settings.estilo == 'portal' %}ax-portal-barra{% endif %}" style="--r-texto: {%- render 'gad-rol', c: section.settings.color_texto, d: 'var(--color-foreground)' -%}; --r-fondo: {%- render 'gad-rol', c: section.settings.color_fondo, d: 'var(--color-background)' -%}; --r-fondo_2: {%- render 'gad-rol', c: section.settings.color_fondo_2, d: 'var(--color-background-suave)' -%}; --r-acento: {%- render 'gad-rol', c: section.settings.color_acento, d: 'var(--color-background-contrast)' -%}; --r-acento_hondo: {%- render 'gad-rol', c: section.settings.color_acento_hondo, d: 'var(--color-background-suave)' -%}; --r-portal_texto: {%- render 'gad-rol', c: section.settings.color_portal_texto, d: 'var(--color-foreground)' -%}; --r-portal_fondo: {%- render 'gad-rol', c: section.settings.color_portal_fondo, d: 'var(--color-background)' -%}; --r-portal_fondo_2: {%- render 'gad-rol', c: section.settings.color_portal_fondo_2, d: 'var(--color-background-suave)' -%}; --r-portal_acento: {%- render 'gad-rol', c: section.settings.color_portal_acento, d: 'var(--color-background-contrast)' -%}; --r-portal_acento_hondo: {%- render 'gad-rol', c: section.settings.color_portal_acento_hondo, d: 'var(--color-foreground)' -%}; --r-portal_gris: {%- render 'gad-rol', c: section.settings.color_portal_gris, d: 'var(--color-foreground)' -%}; --r-portal_linea: {%- render 'gad-rol', c: section.settings.color_portal_linea, d: 'var(--color-background-contrast)' -%}; --r-portal_rojo: {%- render 'gad-rol', c: section.settings.color_portal_rojo, d: 'var(--color-button)' -%}; --r-portal_caja: {%- render 'gad-rol', c: section.settings.color_portal_caja, d: 'var(--color-background-suave)' -%}; --r-portal_bajada: {%- render 'gad-rol', c: section.settings.color_portal_bajada, d: 'var(--color-foreground)' -%}; --r-portal_parrafo: {%- render 'gad-rol', c: section.settings.color_portal_parrafo, d: 'var(--color-foreground)' -%}; --r-letra_titulos: {% if section.settings.letra_titulos != blank %}'{{ section.settings.letra_titulos.family }}','Arial Black',Haettenschweiler,Impact,sans-serif{% else %}var(--font-heading-family){% endif %}; --r-letra_texto: {% if section.settings.letra_texto != blank %}'{{ section.settings.letra_texto.family }}','Barlow','Segoe UI',Arial,sans-serif{% else %}var(--font-body-family){% endif %}; --r-letra_lectura: {% if section.settings.letra_lectura != blank %}'{{ section.settings.letra_lectura.family }}','Barlow Semi Condensed','Segoe UI',Arial,sans-serif{% else %}var(--font-body-family){% endif %}; --r-portal_letra_titulos: {% if section.settings.portal_letra_titulos != blank %}'{{ section.settings.portal_letra_titulos.family }}','Helvetica Neue',Helvetica,Arial,sans-serif{% else %}var(--font-heading-family){% endif %}; --r-portal_letra_texto: {% if section.settings.portal_letra_texto != blank %}'{{ section.settings.portal_letra_texto.family }}','Helvetica Neue',Arial,sans-serif{% else %}var(--font-body-family){% endif %};">
    <div class="ax-b-txt">
      <b>{{ section.settings.barra_titulo }}</b>
      {%- if p != blank -%}{{ p.price | money }}{%- endif -%}
    </div>
    <a href="{{ p.url | default: '#' }}{{ section.settings.utm }}">
      <span>{{ section.settings.barra_boton }}</span>
    </a>
  </div>

  <script>
    (function () {
      var barra = document.getElementById('ax-barra-{{ uid }}');
      if (!barra || barra.dataset.axListo) return;
      barra.dataset.axListo = '1';
      var pedido = false;
      function pintar () {
        pedido = false;
        barra.classList.toggle('ax-ver', window.scrollY > window.innerHeight * 0.9);
      }
      window.addEventListener('scroll', function () {
        if (!pedido) { pedido = true; requestAnimationFrame(pintar); }
      }, { passive: true });
      pintar();
    })();
  </script>
{%- endif -%}

