{%- comment -%}
  Objeciones: preguntas frecuentes en una lista de desplegables con título resaltado.
  Copia configurable de la de Gadsden (white label, BUILD.md decisión 20): los colores y las letras que eran fijos
  son ajustes; vacíos, los de la tienda. El estilo "oscuro" pone los originales (src/w/oscuro.json).
{%- endcomment -%}
{%- if section.settings.letra_titulos != blank and section.settings.letra_titulos.family != settings.type_header_font.family and section.settings.letra_titulos.family != settings.type_body_font.family -%}<style>{{ section.settings.letra_titulos | font_face: font_display: 'swap' }}</style>{%- endif -%}
{%- if section.settings.letra_texto != blank and section.settings.letra_texto.family != settings.type_header_font.family and section.settings.letra_texto.family != settings.type_body_font.family -%}<style>{{ section.settings.letra_texto | font_face: font_display: 'swap' }}</style>{%- endif -%}

{%- liquid
  assign uid = section.id | replace: '_', '-'
-%}

{%- if section.settings.letra_titulos != blank or section.settings.letra_texto != blank -%}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Barlow+Semi+Condensed:wght@400;500;600;700&display=swap">{%- endif -%}

<style>
  
  #ax-faq-{{ uid }}{
    --tinta:rgb(var(--r-texto));--papel:rgb(var(--r-tarjeta));--papel-2:rgb(var(--r-fondo));--lima:rgb(var(--r-resalte));
    --impacto:var(--r-letra_titulos);
    --texto:var(--r-letra_texto);
    background:var(--papel-2);color:var(--tinta);font-family:var(--texto);
    padding:44px 20px;border-bottom:4px solid var(--tinta);
  }
  #ax-faq-{{ uid }} h1,#ax-faq-{{ uid }} h2,#ax-faq-{{ uid }} h3{color:inherit}
  #ax-faq-{{ uid }} .ax-wrap{max-width:820px;margin:0 auto}
  #ax-faq-{{ uid }} .ax-eye{font-family:var(--impacto);font-size:9px;letter-spacing:.16em;
    text-transform:uppercase;background:var(--tinta);color:var(--papel);padding:7px 12px;
    display:block;width:max-content;max-width:100%;transform:skewX(-9deg);margin:0 0 16px}
  #ax-faq-{{ uid }} .ax-eye span{display:inline-block;transform:skewX(9deg)}
  #ax-faq-{{ uid }} h2{margin:0 0 22px;font-family:var(--impacto);text-transform:uppercase;
    font-size:clamp(25px,7.2vw,34px);line-height:1.02;letter-spacing:-.02em;
    transform:skewX(-9deg);display:inline-block}
  #ax-faq-{{ uid }} h2 span{display:inline-block}
  #ax-faq-{{ uid }} h2 em{font-style:normal;background:var(--lima);padding:1px 8px;
    box-decoration-break:clone;-webkit-box-decoration-break:clone}
  #ax-faq-{{ uid }} .ax-lista{border:3px solid var(--tinta);background:var(--papel)}
  #ax-faq-{{ uid }} details{border-bottom:2px solid var(--tinta)}
  #ax-faq-{{ uid }} details:last-child{border-bottom:0}
  
  #ax-faq-{{ uid }} summary{list-style:none;cursor:pointer;padding:16px 50px 16px 18px;
    min-height:44px;display:flex;align-items:center;
    font-family:var(--impacto);text-transform:uppercase;font-size:15.5px;
    line-height:1.2;letter-spacing:-.005em;position:relative}
  #ax-faq-{{ uid }} summary::-webkit-details-marker{display:none}
  #ax-faq-{{ uid }} summary:before,#ax-faq-{{ uid }} summary:after{content:"";position:absolute;
    right:18px;top:50%;background:var(--tinta);transition:transform .16s ease}
  #ax-faq-{{ uid }} summary:before{width:15px;height:3px;transform:translateY(-50%)}
  #ax-faq-{{ uid }} summary:after{width:3px;height:15px;right:24px;transform:translateY(-50%)}
  #ax-faq-{{ uid }} details[open] summary{background:var(--lima)}
  #ax-faq-{{ uid }} details[open] summary:after{transform:translateY(-50%) scaleY(0)}
  #ax-faq-{{ uid }} .ax-resp{padding:12px 18px 18px;font-size:16.5px;line-height:1.5;max-width:60ch}
  #ax-faq-{{ uid }} .ax-resp p{margin:0 0 10px}
  #ax-faq-{{ uid }} .ax-resp p:last-child{margin:0}
  #ax-faq-{{ uid }} .ax-pie{margin:22px 0 0;font-size:16px;line-height:1.5;opacity:.78;max-width:60ch}

  
  @media(min-width:900px){
    #ax-faq-{{ uid }}{padding:74px 28px}
    #ax-faq-{{ uid }} .ax-eye{font-size:10.5px;letter-spacing:.19em;padding:7px 14px;margin-bottom:24px}
    #ax-faq-{{ uid }} h2{font-size:clamp(34px,4.3vw,50px);margin-bottom:34px}
    #ax-faq-{{ uid }} .ax-lista{border-width:4px}
    #ax-faq-{{ uid }} summary{padding:21px 58px 21px 24px;font-size:17.5px}
    #ax-faq-{{ uid }} summary:before,#ax-faq-{{ uid }} summary:after{right:24px}
    #ax-faq-{{ uid }} summary:before{width:17px}
    #ax-faq-{{ uid }} summary:after{height:17px;right:31px}
    #ax-faq-{{ uid }} .ax-resp{padding:2px 24px 24px;font-size:17px;line-height:1.55}
    #ax-faq-{{ uid }} .ax-pie{margin-top:28px}
  }

  
</style>

<div id="ax-faq-{{ uid }}" style="--r-fondo: {%- render 'gad-rol', c: section.settings.color_fondo, d: 'var(--color-background)' -%}; --r-tarjeta: {%- render 'gad-rol', c: section.settings.color_tarjeta, d: 'var(--color-background)' -%}; --r-texto: {%- render 'gad-rol', c: section.settings.color_texto, d: 'var(--color-foreground)' -%}; --r-resalte: {%- render 'gad-rol', c: section.settings.color_resalte, d: 'var(--color-background-contrast)' -%}; --r-letra_titulos: {% if section.settings.letra_titulos != blank %}'{{ section.settings.letra_titulos.family }}','Arial Black',Haettenschweiler,Impact,sans-serif{% else %}var(--font-heading-family){% endif %}; --r-letra_texto: {% if section.settings.letra_texto != blank %}'{{ section.settings.letra_texto.family }}','Barlow','Segoe UI Semibold','Segoe UI',Arial,sans-serif{% else %}var(--font-body-family){% endif %};">
  <div class="ax-wrap">
    {%- if section.settings.eyebrow != blank -%}
      <div class="ax-eye"><span>{{ section.settings.eyebrow }}</span></div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2><span>{{ section.settings.heading }}</span></h2>
    {%- endif -%}

    <div class="ax-lista">
      {%- for block in section.blocks -%}
        <details {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.q }}</summary>
          <div class="ax-resp">{{ block.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.pie != blank -%}
      <p class="ax-pie">{{ section.settings.pie }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Objeciones",
  "tag": "section",
  "class": "gad-objections-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Bajada (eyebrow)",
      "default": "04 — LO QUE TODOS PREGUNTAN"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título (la cursiva va en el color de resaltado)",
      "default": "Sacate las <em>dudas</em>"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Abrir la primera pregunta",
      "default": true
    },
    {
      "type": "header",
      "content": "Pie"
    },
    {
      "type": "textarea",
      "id": "pie",
      "label": "Texto al pie",
      "default": "Texto al pie de las preguntas."
    },
    {
      "type": "header",
      "content": "Colores y letras (vacíos: los de la tienda)"
    },
    {
      "type": "color",
      "id": "color_fondo",
      "label": "Fondo de la sección"
    },
    {
      "type": "color",
      "id": "color_tarjeta",
      "label": "Fondo de la lista"
    },
    {
      "type": "color",
      "id": "color_texto",
      "label": "Texto y bordes"
    },
    {
      "type": "color",
      "id": "color_resalte",
      "label": "Resaltado"
    },
    {
      "type": "font_picker",
      "id": "letra_titulos",
      "label": "Letra de los títulos"
    },
    {
      "type": "font_picker",
      "id": "letra_texto",
      "label": "Letra del texto"
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Pregunta",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "q",
          "label": "Pregunta",
          "default": "Tu pregunta"
        },
        {
          "type": "richtext",
          "id": "a",
          "label": "Respuesta",
          "default": "<p>Tu respuesta.</p>"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Objeciones",
      "blocks": [
        {
          "type": "qa",
          "settings": {
            "q": "¿Cuánto tarda en llegar?",
            "a": "<p>Acá va la respuesta a la primera pregunta frecuente.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "q": "¿Cómo lo uso?",
            "a": "<p>Acá va la respuesta a la segunda pregunta frecuente.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "q": "¿Tiene garantía?",
            "a": "<p>Acá va la respuesta a la tercera pregunta frecuente.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "q": "¿Puedo cambiarlo?",
            "a": "<p>Acá va la respuesta a la cuarta pregunta frecuente.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "q": "¿Cómo pago?",
            "a": "<p>Acá va la respuesta a la quinta pregunta frecuente.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "q": "¿Hacen envíos a todo el país?",
            "a": "<p>Acá va la respuesta a la sexta pregunta frecuente.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
