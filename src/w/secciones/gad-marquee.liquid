{%- comment -%}
  Marquesina — texto gigante en scroll (outline + relleno).
  Copia configurable de la de Gadsden (white label, 22-oct): los colores y la letra que eran fijos son ajustes; vacíos,
  toman la combinación de colores y la letra de títulos de la tienda. El estilo "oscuro" pone los originales
  (src/w/oscuro.json). Mismo markup, mismas medidas y la misma animación.
{%- endcomment -%}
{%- liquid
  assign uid = section.id | replace: '_', '-'
  assign s = section.settings
  assign fondo = s.color_fondo | default: 'rgb(var(--color-background))'
  assign contorno = s.color_contorno | default: 'rgba(var(--color-foreground), 0.18)'
  assign relleno = s.color_relleno | default: 'rgba(var(--color-foreground), 0.08)'
  if s.letra != blank
    assign letra = s.letra.family | prepend: "'" | append: "',system-ui,sans-serif"
    assign peso = s.letra.weight
  else
    assign letra = 'var(--font-heading-family)'
    assign peso = 800
  endif
-%}
<style>
  {%- comment -%} La letra del theme ya está cargada, con sus caras: se pide sólo otra. {%- endcomment -%}
  {%- if s.letra != blank and s.letra.family != settings.type_header_font.family and s.letra.family != settings.type_body_font.family -%}{{ s.letra | font_face: font_display: 'swap' }}{%- endif -%}
  #gad-marq-{{ uid }}{background:{{ fondo }};overflow:hidden;white-space:nowrap;padding:26px 0 4px;font-family:{{ letra }}}
  #gad-marq-{{ uid }} .gm-trk{display:inline-flex;animation:gm-{{ uid }} {{ section.settings.speed | default: 34 }}s linear infinite}
  #gad-marq-{{ uid }} .gm-trk span{font-size:96px;font-weight:{{ peso }};letter-spacing:-.02em;text-transform:uppercase;padding:0 30px;color:transparent;-webkit-text-stroke:2px {{ contorno }}}
  #gad-marq-{{ uid }} .gm-trk span.fill{color:{{ relleno }};-webkit-text-stroke:0}
  @keyframes gm-{{ uid }}{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  @media(prefers-reduced-motion:reduce){#gad-marq-{{ uid }} .gm-trk{animation:none}}
  @media(max-width:900px){#gad-marq-{{ uid }} .gm-trk span{font-size:54px;-webkit-text-stroke:1.5px {{ contorno }}}}
</style>
<div id="gad-marq-{{ uid }}" aria-hidden="true">
  <div class="gm-trk">
    {%- for i in (1..4) -%}
      <span>{{ section.settings.text_outline | default: 'Tu frase' }}</span><span class="fill">{{ section.settings.text_fill | default: 'Tu marca' }}</span>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Marquesina",
  "tag": "section",
  "class": "gad-marquee-section",
  "settings": [
    { "type": "text", "id": "text_outline", "label": "Palabra en contorno", "default": "Tu frase" },
    { "type": "text", "id": "text_fill", "label": "Palabra rellena", "default": "Tu marca" },
    { "type": "range", "id": "speed", "label": "Velocidad (seg)", "min": 12, "max": 60, "step": 2, "unit": "s", "default": 34 },
    { "type": "header", "content": "Colores y letra (vacíos: los de la tienda)" },
    { "type": "color", "id": "color_fondo", "label": "Fondo" },
    { "type": "color", "id": "color_contorno", "label": "Contorno de la palabra" },
    { "type": "color", "id": "color_relleno", "label": "Relleno de la palabra" },
    { "type": "font_picker", "id": "letra", "label": "Letra" }
  ],
  "presets": [ { "name": "Marquesina" } ]
}
{% endschema %}
