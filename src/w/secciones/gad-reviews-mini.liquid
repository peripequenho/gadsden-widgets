{%- comment -%}
  Reseñas mini: una tira de frases de reseñas que corre, para arriba de la landing.
  Copia configurable de la de Gadsden (white label, BUILD.md decisión 20): los colores y las letras que eran fijos
  son ajustes; vacíos, los de la tienda. El estilo "oscuro" pone los originales (src/w/oscuro.json).
{%- endcomment -%}
{%- if section.settings.letra_titulos != blank and section.settings.letra_titulos.family != settings.type_header_font.family and section.settings.letra_titulos.family != settings.type_body_font.family -%}<style>{{ section.settings.letra_titulos | font_face: font_display: 'swap' }}</style>{%- endif -%}
{%- if section.settings.letra_texto != blank and section.settings.letra_texto.family != settings.type_header_font.family and section.settings.letra_texto.family != settings.type_body_font.family -%}<style>{{ section.settings.letra_texto | font_face: font_display: 'swap' }}</style>{%- endif -%}

{%- liquid
  assign uid = section.id | replace: '_', '-'
-%}

{%- if section.blocks.size > 0 -%}
{%- if section.settings.letra_titulos != blank or section.settings.letra_texto != blank -%}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Barlow+Semi+Condensed:wght@400;500;600;700&display=swap">{%- endif -%}

<style>
  
  #ax-rmini-{{ uid }}{
    --tinta:rgb(var(--r-fondo));--papel:rgb(var(--r-texto));--lima:rgb(var(--r-acento));--lima-honda:#6BA512;
    --impacto:var(--r-letra_titulos);
    --texto:var(--r-letra_texto);
    background:var(--tinta);color:var(--papel);font-family:var(--texto);
    padding:12px 0;border-top:3px solid var(--lima);border-bottom:3px solid var(--lima);
  }

  
  #ax-rmini-{{ uid }} .ax-marq{overflow:hidden}
  #ax-rmini-{{ uid }} .ax-tira{display:flex;gap:8px;width:max-content;
    animation:ax-rmini-rueda-{{ uid }} {{ section.settings.velocidad | default: 40 }}s linear infinite}
  #ax-rmini-{{ uid }} .ax-marq:hover .ax-tira{animation-play-state:paused}
  @keyframes ax-rmini-rueda-{{ uid }}{to{transform:translateX(-50%)}}
  #ax-rmini-{{ uid }} .ax-item{flex:none;display:flex;align-items:center;gap:9px;
    border:2px solid rgba(var(--r-texto),.26);padding:7px 12px 7px 7px;max-width:330px}
  #ax-rmini-{{ uid }} .ax-item img{width:34px;height:34px;object-fit:cover;flex:none;
    border:2px solid var(--lima)}
  #ax-rmini-{{ uid }} .ax-item .txt{min-width:0}
  #ax-rmini-{{ uid }} .ax-item .fila1{display:flex;align-items:baseline;gap:6px;white-space:nowrap}
  #ax-rmini-{{ uid }} .ax-item .e{color:var(--lima);font-size:11px;letter-spacing:.05em}
  #ax-rmini-{{ uid }} .ax-item b{font-family:var(--impacto);font-size:10.5px;letter-spacing:.05em;
    text-transform:uppercase}
  #ax-rmini-{{ uid }} .ax-item .ok{font-family:var(--impacto);font-size:10px;line-height:1;
    color:var(--tinta);background:var(--lima);padding:2px 4px}
  
  #ax-rmini-{{ uid }} .ax-item .cita{display:block;font-size:13.5px;line-height:1.25;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;opacity:.92}
  #ax-rmini-{{ uid }} .ax-item .fecha{font-size:11.5px;opacity:.55;white-space:nowrap}

  

  
  @media(min-width:900px){
    #ax-rmini-{{ uid }} .ax-item .cita{max-width:230px}
  }
</style>

<div id="ax-rmini-{{ uid }}" style="--r-fondo: {%- render 'gad-rol', c: section.settings.color_fondo, d: 'var(--color-background)' -%}; --r-texto: {%- render 'gad-rol', c: section.settings.color_texto, d: 'var(--color-foreground)' -%}; --r-acento: {%- render 'gad-rol', c: section.settings.color_acento, d: 'var(--color-button)' -%}; --r-letra_titulos: {% if section.settings.letra_titulos != blank %}'{{ section.settings.letra_titulos.family }}','Arial Black',Haettenschweiler,Impact,sans-serif{% else %}var(--font-heading-family){% endif %}; --r-letra_texto: {% if section.settings.letra_texto != blank %}'{{ section.settings.letra_texto.family }}','Barlow','Segoe UI Semibold','Segoe UI',Arial,sans-serif{% else %}var(--font-body-family){% endif %};">
  <div class="ax-marq">
    <div class="ax-tira">
      {%- for copia in (1..2) -%}
        <div style="display:flex;gap:8px" {% if copia == 2 %}aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            {%- assign e = block.settings.estrellas | default: 5 -%}
            <span class="ax-item" {% if copia == 1 %}{{ block.shopify_attributes }}{% endif %}>
              {%- if block.settings.foto != blank -%}
                <img src="{{ block.settings.foto | image_url: width: 80 }}"
                     alt="" width="34" height="34" loading="lazy">
              {%- endif -%}
              <span class="txt">
                <span class="fila1">
                  <span class="e">{% for i in (1..e) %}★{% endfor %}</span>
                  {%- if block.settings.autor != blank -%}<b>{{ block.settings.autor }}</b>{%- endif -%}
                  {%- if block.settings.verificada -%}<span class="ok" role="img" aria-label="Compra verificada" title="Compra verificada">✓</span>{%- endif -%}
                  {%- if block.settings.fecha != blank -%}<span class="fecha">{{ block.settings.fecha }}</span>{%- endif -%}
                </span>
                <span class="cita">“{{ block.settings.texto }}”</span>
              </span>
            </span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Reseñas mini",
  "tag": "section",
  "class": "gad-reviews-mini-section",
  "settings": [
    {
      "type": "range",
      "id": "velocidad",
      "label": "Velocidad del ticker (segundos por vuelta)",
      "min": 16,
      "max": 60,
      "step": 4,
      "default": 40
    },
    {
      "type": "header",
      "content": "Colores y letras (vacíos: los de la tienda)"
    },
    {
      "type": "color",
      "id": "color_fondo",
      "label": "Fondo"
    },
    {
      "type": "color",
      "id": "color_texto",
      "label": "Texto"
    },
    {
      "type": "color",
      "id": "color_acento",
      "label": "Acento (bordes, estrellas y etiqueta)"
    },
    {
      "type": "font_picker",
      "id": "letra_titulos",
      "label": "Letra de las etiquetas"
    },
    {
      "type": "font_picker",
      "id": "letra_texto",
      "label": "Letra del texto"
    }
  ],
  "blocks": [
    {
      "type": "destacado",
      "name": "Reseña corta",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "foto",
          "label": "Foto del cliente (opcional)"
        },
        {
          "type": "range",
          "id": "estrellas",
          "label": "Estrellas",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "texto",
          "label": "Cita (corta, sin comillas)",
          "default": "[VACÍO — una frase de una reseña real]"
        },
        {
          "type": "text",
          "id": "autor",
          "label": "Nombre"
        },
        {
          "type": "text",
          "id": "fecha",
          "label": "Fecha de compra (mm/aa, ej: 07/26)"
        },
        {
          "type": "checkbox",
          "id": "verificada",
          "label": "Compra verificada",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Reseñas mini"
    }
  ]
}
{% endschema %}
