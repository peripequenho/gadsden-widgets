{%- comment -%}
  Pasos automáticos: tarjetas de pasos que avanzan solas con barras de progreso tipo historias, y un botón al final.
  Copia configurable de la de Gadsden (white label, BUILD.md decisión 20): los colores y las letras que eran fijos
  son ajustes; vacíos, los de la tienda. El estilo "oscuro" pone los originales (src/w/oscuro.json).
{%- endcomment -%}
{%- assign s = section.settings -%}

<style>
  #ct-pasos-{{ section.id }} {
    --ct-carbon: {{ s.accent | default: 'rgb(var(--color-button))' }};
    --ct-menta: {{ s.highlight | default: 'rgb(var(--color-background-contrast))' }};
    --ct-intervalo: {{ s.interval }}s;
    --ct-img: {{ s.image_size }}px;
    display: flex; flex-direction: column; justify-content: flex-start; box-sizing: border-box;
    {% if s.section_height > 0 %}min-height: {{ s.section_height }}vh;{% endif %}
    padding: {{ s.padding_top }}px 16px {{ s.padding_bottom }}px;
    background: {{ s.background | default: 'rgb(var(--color-background))' }}; color: {{ s.text_color | default: 'rgb(var(--color-foreground))' }};
  }
  #ct-pasos-{{ section.id }} .ct-pasos__wrap { width: 100%; max-width: 560px; margin: 0 auto; }
  #ct-pasos-{{ section.id }} .ct-pasos__cap {
    margin: 0 0 2px; text-align: center; font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; opacity: .7;
  }
  #ct-pasos-{{ section.id }} .ct-pasos__titulo { margin: 0 0 14px; text-align: center; line-height: 1.15; }

  
  #ct-pasos-{{ section.id }} .ct-pasos__barras { display: flex; gap: 4px; margin-bottom: 12px; }
  #ct-pasos-{{ section.id }} .ct-pasos__barra {
    flex: 1; height: 14px; padding: 5px 0; border: 0; background: none; cursor: pointer;
  }
  #ct-pasos-{{ section.id }} .ct-pasos__barra > span {
    display: block; height: 4px; border-radius: 4px; background: rgb(var(--r-pista)); overflow: hidden;
  }
  #ct-pasos-{{ section.id }} .ct-pasos__barra > span > i { display: block; height: 100%; width: 0; background: var(--ct-carbon); }
  #ct-pasos-{{ section.id }} .ct-pasos__barra.is-hecha > span > i { width: 100%; }
  #ct-pasos-{{ section.id }} .ct-pasos__barra.is-activa > span > i { animation: ct-llenar-{{ section.id }} var(--ct-intervalo) linear forwards; }
  #ct-pasos-{{ section.id }}.is-pausa .ct-pasos__barra.is-activa > span > i { animation-play-state: paused; }
  @keyframes ct-llenar-{{ section.id }} { from { width: 0; } to { width: 100%; } }
  #ct-pasos-{{ section.id }} .ct-pasos__barra:focus-visible { outline: 2px solid var(--ct-carbon); outline-offset: 2px; }

  
  #ct-pasos-{{ section.id }} .ct-pasos__pista {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    border-radius: 16px; overscroll-behavior-x: contain;
  }
  #ct-pasos-{{ section.id }} .ct-pasos__pista::-webkit-scrollbar { display: none; }
  #ct-pasos-{{ section.id }} .ct-pasos__card {
    flex: 0 0 100%; scroll-snap-align: start; box-sizing: border-box; position: relative; overflow: hidden;
    display: grid; grid-template-columns: 56px 1fr; gap: 12px; align-items: center; min-height: 84px;
    padding: 14px 16px; border-radius: 16px; background: rgb(var(--r-tarjeta)); border: 1px solid rgb(var(--r-borde));
  }
  #ct-pasos-{{ section.id }} .ct-pasos__img {
    
    position: absolute; left: calc(80px - var(--ct-img)); top: 50%; transform: translateY(-50%);
    width: var(--ct-img); height: var(--ct-img); max-width: none; object-fit: contain; display: block; mix-blend-mode: multiply;
  }
  #ct-pasos-{{ section.id }} .ct-pasos__card > div { grid-column: 2; position: relative;
  }
  
  #ct-pasos-{{ section.id }} .ct-pasos__fila { margin: 0 0 4px; line-height: 1.25; }
  #ct-pasos-{{ section.id }} .ct-pasos__card h3 { display: inline; margin: 0 6px 0 0; font-size: 16px; line-height: 1.25; }
  #ct-pasos-{{ section.id }} .ct-pasos__card > div { min-width: 0; }
  #ct-pasos-{{ section.id }} .ct-pasos__chip {
    display: inline-block; vertical-align: 1px; padding: 2px 8px; border-radius: 100px; background: var(--ct-carbon); color: var(--ct-menta);
    font-size: 11px; font-weight: 700; letter-spacing: .04em; white-space: nowrap;
  }
  #ct-pasos-{{ section.id }} .ct-pasos__card p { margin: 0; font-size: 14px; line-height: 1.4; color: rgb(var(--r-parrafo)); }

  
  #ct-pasos-{{ section.id }} .ct-pasos__cta {
    display: grid; grid-template-rows: 0fr; opacity: 0; transform: translateY(8px);
    transition: grid-template-rows .35s ease, opacity .3s ease, transform .35s ease, margin .35s ease;
  }
  #ct-pasos-{{ section.id }}.is-cta .ct-pasos__cta { grid-template-rows: 1fr; opacity: 1; transform: none; margin-top: 12px; }
  #ct-pasos-{{ section.id }} .ct-pasos__cta > div { overflow: hidden; }
  #ct-pasos-{{ section.id }} .ct-pasos__btn {
    position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; gap: 10px;
    width: 100%; min-height: 56px; border-radius: 12px; background: var(--ct-carbon); color: rgb(var(--r-boton_texto));
    font-weight: 800; font-size: 16px; letter-spacing: .03em; text-transform: uppercase; text-decoration: none;
    box-shadow: 0 0 0 3px var(--ct-menta), 0 10px 24px rgba(11, 11, 11, .25);
  }
  #ct-pasos-{{ section.id }} .ct-pasos__btn svg { width: 20px; height: 20px; flex: none; color: var(--ct-menta); }
  
  #ct-pasos-{{ section.id }} .ct-pasos__btn::after {
    content: ""; position: absolute; inset: 0; transform: translateX(-120%);
    background: linear-gradient(100deg, transparent 30%, rgba(255, 255, 255, .35) 50%, transparent 70%);
  }
  #ct-pasos-{{ section.id }}.is-cta .ct-pasos__btn { animation: ct-salta-{{ section.id }} .5s cubic-bezier(.34, 1.56, .64, 1) .15s both; }
  #ct-pasos-{{ section.id }}.is-cta .ct-pasos__btn::after { animation: ct-brillo-{{ section.id }} 2.4s ease-in-out .6s infinite; }
  #ct-pasos-{{ section.id }}.is-cta .ct-pasos__btn svg { animation: ct-flecha-{{ section.id }} 1.2s ease-in-out .6s infinite; }
  @keyframes ct-salta-{{ section.id }} { from { transform: scale(.9); } to { transform: none; } }
  @keyframes ct-brillo-{{ section.id }} { 0% { transform: translateX(-120%); } 55%, 100% { transform: translateX(120%); } }
  @keyframes ct-flecha-{{ section.id }} { 0%, 100% { transform: none; } 50% { transform: translateX(5px); } }

  
  #ct-pasos-{{ section.id }} .ct-pasos__card.is-sale > * { animation: ct-sale-{{ section.id }} .22s ease-in forwards; }
  #ct-pasos-{{ section.id }} .ct-pasos__card.is-entra .ct-pasos__img { animation: ct-entra-img-{{ section.id }} .5s cubic-bezier(.22, 1, .36, 1) both; }
  #ct-pasos-{{ section.id }} .ct-pasos__card.is-entra > div { animation: ct-entra-txt-{{ section.id }} .45s cubic-bezier(.22, 1, .36, 1) .08s both; }
  @keyframes ct-sale-{{ section.id }} { to { opacity: 0; translate: -14px 0; } }
  @keyframes ct-entra-img-{{ section.id }} { from { opacity: 0; translate: -36px 0; } to { opacity: 1; translate: 0 0; } }
  @keyframes ct-entra-txt-{{ section.id }} { from { opacity: 0; translate: 0 10px; } to { opacity: 1; translate: 0 0; } }

  
  @media (prefers-reduced-motion: reduce) {
    #ct-pasos-{{ section.id }} .ct-pasos__cta { transition: opacity .3s; transform: none; }
    #ct-pasos-{{ section.id }} .ct-pasos__card.is-sale > * { animation: ct-funde-out-{{ section.id }} .2s forwards; }
    #ct-pasos-{{ section.id }} .ct-pasos__card.is-entra .ct-pasos__img,
    #ct-pasos-{{ section.id }} .ct-pasos__card.is-entra > div { animation: ct-funde-in-{{ section.id }} .4s both; }
    #ct-pasos-{{ section.id }}.is-cta .ct-pasos__btn,
    #ct-pasos-{{ section.id }}.is-cta .ct-pasos__btn::after,
    #ct-pasos-{{ section.id }}.is-cta .ct-pasos__btn svg { animation: none; }
    @keyframes ct-funde-out-{{ section.id }} { to { opacity: 0; } }
    @keyframes ct-funde-in-{{ section.id }} { from { opacity: 0; } to { opacity: 1; } }
  }

  
  @media (min-width: 990px) {
    #ct-pasos-{{ section.id }} { padding-top: 48px; padding-bottom: 48px; }
    #ct-pasos-{{ section.id }} .ct-pasos__wrap { max-width: 1180px; }
    #ct-pasos-{{ section.id }} .ct-pasos__titulo { margin-bottom: 28px; }
    #ct-pasos-{{ section.id }} .ct-pasos__barras { display: none; }
    #ct-pasos-{{ section.id }} .ct-pasos__pista { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; overflow: visible; }
    #ct-pasos-{{ section.id }} .ct-pasos__card { display: flex; flex-direction: column; align-items: stretch; padding: 0 0 22px; }
    #ct-pasos-{{ section.id }} .ct-pasos__img {
      position: static; transform: none; width: 100%; height: 190px; margin-bottom: 16px; object-fit: contain;
    }
    #ct-pasos-{{ section.id }} .ct-pasos__card > div { padding: 0 20px; }
    #ct-pasos-{{ section.id }} .ct-pasos__card h3 { font-size: 18px; }
    #ct-pasos-{{ section.id }} .ct-pasos__card p { margin-top: 6px; font-size: 15px; }
    #ct-pasos-{{ section.id }} .ct-pasos__cta > div { display: flex; justify-content: center; padding: 6px 0 20px; }
    #ct-pasos-{{ section.id }} .ct-pasos__btn { width: auto; min-width: 380px; padding: 0 36px; }
  }
</style>

<section id="ct-pasos-{{ section.id }}" class="ct-pasos" style="--r-tarjeta: {%- render 'gad-rol', c: section.settings.color_tarjeta, d: 'var(--color-background)' -%}; --r-borde: {%- render 'gad-rol', c: section.settings.color_borde, d: 'var(--color-background-contrast)' -%}; --r-parrafo: {%- render 'gad-rol', c: section.settings.color_parrafo, d: 'var(--color-foreground)' -%}; --r-pista: {%- render 'gad-rol', c: section.settings.color_pista, d: 'var(--color-background-contrast)' -%}; --r-boton_texto: {%- render 'gad-rol', c: section.settings.color_boton_texto, d: 'var(--color-button-text)' -%};">
  <div class="ct-pasos__wrap">
    {%- if s.caption != blank -%}<p class="ct-pasos__cap">{{ s.caption }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="ct-pasos__titulo {{ s.heading_size }}">{{ s.heading }}</h2>{%- endif -%}

    <div class="ct-pasos__barras" role="tablist" aria-label="Pasos">
      {%- for b in section.blocks -%}
        <button type="button" class="ct-pasos__barra{% if forloop.first %} is-activa{% endif %}" role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="ct-card-{{ section.id }}-{{ forloop.index0 }}"
          aria-label="Paso {{ forloop.index }}: {{ b.settings.title | escape }}"><span><i></i></span></button>
      {%- endfor -%}
    </div>

    <div class="ct-pasos__pista" aria-live="polite">
      {%- for b in section.blocks -%}
        {%- liquid
          if b.settings.image != blank
            assign img = b.settings.image | image_url: width: 240
          else
            capture img
              render 'gad-relleno'
            endcapture
          endif
        -%}
        <article class="ct-pasos__card" id="ct-card-{{ section.id }}-{{ forloop.index0 }}" role="tabpanel" {{ b.shopify_attributes }}>
          <img class="ct-pasos__img" src="{{ img }}" alt="" width="{{ s.image_size }}" height="{{ s.image_size }}" loading="lazy">
          <div>
            <div class="ct-pasos__fila">
              <h3>{{ b.settings.title }}</h3>
              {%- if b.settings.tag != blank -%}<span class="ct-pasos__chip">{{ b.settings.tag }}</span>{%- endif -%}
            </div>
            {%- if b.settings.text != blank -%}<p>{{ b.settings.text }}</p>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    <div class="ct-pasos__cta" aria-hidden="true">
      <div>
        {%- comment -%} lleva a la oferta (bloque main-product de la plantilla) {%- endcomment -%}
        <a class="ct-pasos__btn" href="#ct-oferta" data-ct-oferta tabindex="-1">
          {{ s.button_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const raiz = document.getElementById('ct-pasos-{{ section.id }}');
    if (!raiz) return;
    const barras = [...raiz.querySelectorAll('.ct-pasos__barra')];
    const pista = raiz.querySelector('.ct-pasos__pista');
    const cards = [...pista.children];
    const cta = raiz.querySelector('.ct-pasos__cta');
    const ctaBtn = cta.querySelector('a');
    // escritorio: no hay slider (las rayitas están ocultas y no avanzan); el botón se muestra de entrada
    if (matchMedia('(min-width: 990px)').matches) { raiz.classList.add('is-cta'); cta.setAttribute('aria-hidden', 'false'); ctaBtn.tabIndex = 0; }
    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ultimo = cards.length - 1;
    let activo = 0, visible = false;

    const marcar = (n) => {
      activo = n;
      barras.forEach((b, i) => {
        b.classList.toggle('is-hecha', i < n);
        b.classList.remove('is-activa');
        b.setAttribute('aria-selected', i === n ? 'true' : 'false');
      });
      void barras[n].offsetWidth; // reinicia la animación de la rayita
      barras[n].classList.add('is-activa');
      if (n === ultimo && !raiz.classList.contains('is-cta')) {
        raiz.classList.add('is-cta');
        cta.setAttribute('aria-hidden', 'false');
        ctaBtn.tabIndex = 0;
      }
    };
    const entrar = (n) => {
      const c = cards[n];
      c.classList.remove('is-entra'); void c.offsetWidth; c.classList.add('is-entra');
    };
    // sale la card actual (fundido corto), salta a la nueva y entra con su animación
    let saliendo = false;
    const ir = (n) => {
      if (n < 0 || n > ultimo || n === activo || saliendo) return;
      const vieja = cards[activo];
      saliendo = true;
      vieja.classList.add('is-sale');
      setTimeout(() => {
        marcar(n);
        pista.scrollTo({ left: n * pista.clientWidth, behavior: 'auto' });
        vieja.classList.remove('is-sale', 'is-entra');
        entrar(n);
        saliendo = false;
      }, 220);
    };

    // avanza sola: cuando se llena la rayita activa pasa a la siguiente; después del último vuelve al primero
    // (el botón ya quedó visible)
    raiz.addEventListener('animationend', (e) => {
      if (e.target.closest('.ct-pasos__barra.is-activa') && visible) ir(activo === ultimo ? 0 : activo + 1);
    });
    barras.forEach((b, i) => b.addEventListener('click', () => ir(i)));

    // deslizar con el dedo: al frenar el scroll, toma la card que quedó
    let t;
    pista.addEventListener('scroll', () => {
      clearTimeout(t);
      t = setTimeout(() => {
        const n = Math.round(pista.scrollLeft / pista.clientWidth);
        if (n !== activo && !saliendo) { marcar(Math.min(Math.max(n, 0), ultimo)); entrar(activo); }
      }, 120);
    }, { passive: true });

    // pausa mientras se toca o se pasa el mouse
    const pausa = (on) => raiz.classList.toggle('is-pausa', on);
    pista.addEventListener('pointerenter', () => pausa(true));
    pista.addEventListener('pointerleave', () => pausa(!visible));
    pista.addEventListener('touchstart', () => pausa(true), { passive: true });
    pista.addEventListener('touchend', () => pausa(!visible), { passive: true });

    raiz.querySelector('[data-ct-oferta]').addEventListener('click', (e) => {
      const oferta = document.querySelector('[id$="__main"]');
      if (!oferta) return;
      e.preventDefault();
      oferta.scrollIntoView({ behavior: quieto ? 'auto' : 'smooth', block: 'start' });
    });

    // arranca recién cuando la sección se ve
    pausa(true);
    const io = new IntersectionObserver(([e]) => { visible = e.isIntersecting; pausa(!visible); }, { threshold: 0.5 });
    io.observe(raiz);
  })();
</script>

{% schema %}
{
  "name": "Pasos automáticos",
  "tag": "div",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Texto de arriba",
      "default": "Cómo se usan"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Cómo funciona, en 4 pasos"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del titular",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "Chico"
        },
        {
          "value": "h1",
          "label": "Mediano"
        },
        {
          "value": "h0",
          "label": "Grande"
        }
      ]
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Segundos por paso",
      "min": 2,
      "max": 10,
      "step": 0.5,
      "unit": "s",
      "default": 5
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Tamaño de la imagen (se recorta por el borde de la card)",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 104
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Alto mínimo de la sección",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 0,
      "info": "0 = lo que ocupe el contenido"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Color de la sección",
      "info": "Vacío: el de la tienda."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "info": "Vacío: el de la tienda."
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Color de las rayitas y los chips",
      "info": "Vacío: el de la tienda."
    },
    {
      "type": "color",
      "id": "highlight",
      "label": "Color del texto de los chips",
      "info": "Vacío: el de la tienda."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón del último paso (lleva a la oferta)",
      "default": "Quiero el mío"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Margen arriba",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Margen abajo",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Colores y letras (vacíos: los de la tienda)"
    },
    {
      "type": "color",
      "id": "color_tarjeta",
      "label": "Fondo de las tarjetas"
    },
    {
      "type": "color",
      "id": "color_borde",
      "label": "Borde de las tarjetas"
    },
    {
      "type": "color",
      "id": "color_parrafo",
      "label": "Texto de las tarjetas"
    },
    {
      "type": "color",
      "id": "color_pista",
      "label": "Fondo de las barras"
    },
    {
      "type": "color",
      "id": "color_boton_texto",
      "label": "Texto del botón"
    }
  ],
  "blocks": [
    {
      "type": "paso",
      "name": "Paso",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen",
          "info": "Vacío: un dibujo de relleno."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Título del paso"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Chip del tiempo"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Una frase"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pasos automáticos"
    }
  ]
}
{% endschema %}
