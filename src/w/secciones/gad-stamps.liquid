{%- comment -%}
  Sellos animados: tres palabras que caen como sellos, con su texto, una animación arriba y una frase de cierre.
  Copia configurable de la de Gadsden (white label, BUILD.md decisión 20): los colores y las letras que eran fijos
  son ajustes; vacíos, los de la tienda. El estilo "oscuro" pone los originales (src/w/oscuro.json).
{%- endcomment -%}
{%- if section.settings.letra_titulos != blank and section.settings.letra_titulos.family != settings.type_header_font.family and section.settings.letra_titulos.family != settings.type_body_font.family -%}<style>{{ section.settings.letra_titulos | font_face: font_display: 'swap' }}</style>{%- endif -%}
{%- if section.settings.letra_texto != blank and section.settings.letra_texto.family != settings.type_header_font.family and section.settings.letra_texto.family != settings.type_body_font.family -%}<style>{{ section.settings.letra_texto | font_face: font_display: 'swap' }}</style>{%- endif -%}

{%- liquid
  assign uid = section.id | replace: '_', '-'
-%}

{%- if section.settings.letra_titulos != blank or section.settings.letra_texto != blank -%}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Barlow+Semi+Condensed:wght@400;500;600;700&display=swap">{%- endif -%}

<style>
  
  #ax-mec-{{ uid }}{overflow-x:clip;
    --tinta:rgb(var(--r-fondo));--papel:rgb(var(--r-texto));--lima:rgb(var(--r-acento));
    --impacto:var(--r-letra_titulos);
    --texto:var(--r-letra_texto);
    background:var(--tinta);color:var(--papel);font-family:var(--texto);
    padding:24px 20px 30px;position:relative;overflow:hidden;
    display:grid;gap:18px;align-content:start;
  }
  #ax-mec-{{ uid }} h1,#ax-mec-{{ uid }} h2,#ax-mec-{{ uid }} h3{color:inherit}

  
  
  #ax-mec-{{ uid }} .ax-anim{
    height:50svh;min-height:270px;position:relative;
    width:100vw;max-width:100vw;margin-left:calc(50% - 50vw);
    border-top:3px solid rgba(var(--r-acento),.35);border-bottom:3px solid rgba(var(--r-acento),.35);
    background:rgb(var(--r-caja));overflow:hidden}
  #ax-mec-{{ uid }} .ax-anim video,#ax-mec-{{ uid }} .ax-anim img{
    width:100%;height:100%;object-fit:cover;display:block}
  #ax-mec-{{ uid }} .ax-anim .ph{
    position:absolute;inset:10px;display:grid;place-items:center;text-align:center;
    border:2px dashed rgba(var(--r-texto),.28);
    font-family:var(--impacto);font-size:11px;letter-spacing:.15em;
    text-transform:uppercase;opacity:.6;padding:0 16px;line-height:1.8}

  
  #ax-mec-{{ uid }} .ax-eye{font-family:var(--impacto);font-size:9.5px;letter-spacing:.18em;
    text-transform:uppercase;color:var(--lima);display:block;width:max-content;
    max-width:100%;margin:0 0 8px}
  #ax-mec-{{ uid }} h2{margin:0;font-family:var(--impacto);text-transform:uppercase;
    font-size:clamp(25px,7.4vw,34px);line-height:1;letter-spacing:-.02em;
    transform:skewX(-9deg);display:inline-block}
  #ax-mec-{{ uid }} h2 em{font-style:normal;color:var(--lima)}
  #ax-mec-{{ uid }} .ax-lead{margin:10px 0 0;font-size:16.5px;line-height:1.48;
    max-width:52ch;opacity:.88}

  
  #ax-mec-{{ uid }} .ax-sellos{display:grid;gap:10px;margin:4px 0 0}
  #ax-mec-{{ uid }} .ax-sello{display:flex;align-items:center;gap:14px;
    border:3px solid rgba(var(--r-texto),.22);padding:12px 14px}
  #ax-mec-{{ uid }} .ax-sello b{font-family:var(--impacto);text-transform:uppercase;
    font-size:clamp(30px,9vw,40px);line-height:.9;letter-spacing:-.01em;
    transform:skewX(-9deg);display:inline-block;flex:none;min-width:4.6ch}
  #ax-mec-{{ uid }} .ax-sello:nth-child(1) b{color:var(--lima)}
  #ax-mec-{{ uid }} .ax-sello:nth-child(3) b{background:var(--lima);color:var(--tinta);
    padding:3px 10px 1px}
  #ax-mec-{{ uid }} .ax-sello span{font-size:16px;line-height:1.35;opacity:.85;min-width:0}

  
  #ax-mec-{{ uid }}.ax-armado .ax-sello{opacity:0;transform:scale(1.28) rotate(-3deg)}
  #ax-mec-{{ uid }}.ax-armado .ax-sello.ax-va{opacity:1;transform:scale(1) rotate(0);
    transition:transform .3s cubic-bezier(.2,1.7,.4,1),opacity .1s linear}
  #ax-mec-{{ uid }}.ax-armado .ax-sello:nth-child(2).ax-va{transition-delay:.09s}
  #ax-mec-{{ uid }}.ax-armado .ax-sello:nth-child(3).ax-va{transition-delay:.18s}

  
  #ax-mec-{{ uid }} .ax-remate{margin:0;font-family:var(--impacto);text-transform:uppercase;
    font-size:clamp(16px,4.2vw,18px);line-height:1.3;background:var(--lima);
    color:var(--tinta);padding:12px 14px}

  

  
  @media(min-width:900px){
    #ax-mec-{{ uid }}{padding:64px 28px;gap:26px}
    #ax-mec-{{ uid }} .ax-wrap{max-width:1180px;margin:0 auto}
    #ax-mec-{{ uid }} .ax-anim{height:52vh;min-height:360px;width:auto;max-width:none;
      margin-left:0;border:3px solid rgba(var(--r-acento),.35)}
    #ax-mec-{{ uid }} .ax-eye{font-size:10.5px}
    #ax-mec-{{ uid }} h2{font-size:clamp(34px,4.4vw,54px)}
    #ax-mec-{{ uid }} .ax-lead{font-size:18px}
    
    #ax-mec-{{ uid }} .ax-sellos{grid-template-columns:repeat(3,1fr);gap:18px}
    #ax-mec-{{ uid }} .ax-sello{flex-direction:column;align-items:flex-start;gap:10px;
      padding:22px 22px 24px}
    #ax-mec-{{ uid }} .ax-sello b{font-size:clamp(40px,3.8vw,54px);min-width:0}
    #ax-mec-{{ uid }} .ax-sello span{font-size:16.5px;line-height:1.45}
    #ax-mec-{{ uid }} .ax-remate{font-size:19px;padding:16px 20px}
  }
</style>

<div id="ax-mec-{{ uid }}" style="--r-fondo: {%- render 'gad-rol', c: section.settings.color_fondo, d: 'var(--color-background)' -%}; --r-texto: {%- render 'gad-rol', c: section.settings.color_texto, d: 'var(--color-foreground)' -%}; --r-acento: {%- render 'gad-rol', c: section.settings.color_acento, d: 'var(--color-button)' -%}; --r-caja: {%- render 'gad-rol', c: section.settings.color_caja, d: 'var(--color-background-contrast)' -%}; --r-letra_titulos: {% if section.settings.letra_titulos != blank %}'{{ section.settings.letra_titulos.family }}','Arial Black',Haettenschweiler,Impact,sans-serif{% else %}var(--font-heading-family){% endif %}; --r-letra_texto: {% if section.settings.letra_texto != blank %}'{{ section.settings.letra_texto.family }}','Barlow','Segoe UI Semibold','Segoe UI',Arial,sans-serif{% else %}var(--font-body-family){% endif %};">
 <div class="ax-wrap" style="display:grid;gap:inherit">

  {%- comment -%} 1 · ANIMACIÓN — media pantalla {%- endcomment -%}
  <div class="ax-anim">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
    {%- elsif section.settings.imagen != blank -%}
      <img src="{{ section.settings.imagen | image_url: width: 1200 }}" alt="{{ section.settings.imagen.alt | escape }}" loading="lazy">
    {%- else -%}
      <div class="ph">Espacio reservado para la animación<br>subila en los ajustes de esta sección</div>
    {%- endif -%}
  </div>

  {%- comment -%} 2 · TÍTULO {%- endcomment -%}
  <div class="ax-txt">
    {%- if section.settings.eyebrow != blank -%}
      <span class="ax-eye">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.lead != blank -%}
      <p class="ax-lead">{{ section.settings.lead }}</p>
    {%- endif -%}
  </div>

  {%- comment -%} 3 · FRÍO / SECO / LISTO {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <div class="ax-sellos">
      {%- for block in section.blocks -%}
        <div class="ax-sello" {{ block.shopify_attributes }}>
          {%- if block.settings.palabra != blank -%}<b>{{ block.settings.palabra }}</b>{%- endif -%}
          {%- if block.settings.texto != blank -%}<span>{{ block.settings.texto }}</span>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.remate != blank -%}
    <p class="ax-remate">{{ section.settings.remate }}</p>
  {%- endif -%}

 </div>
</div>

<script>
  (function () {
    var caja = document.getElementById('ax-mec-{{ uid }}');
    if (!caja || caja.dataset.axListo) return;
    caja.dataset.axListo = '1';
    var sellos = [].slice.call(caja.querySelectorAll('.ax-sello'));
    if (!sellos.length || !('IntersectionObserver' in window)) return;
    // recién acá se esconden: si el JS no llega hasta esta línea, no se escondió nada
    caja.classList.add('ax-armado');
    var ojo = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('ax-va'); ojo.unobserve(e.target); }
      });
    }, { threshold: 0.5 });
    sellos.forEach(function (s) { ojo.observe(s); });
  })();
</script>

{% schema %}
{
  "name": "Sellos animados",
  "tag": "section",
  "class": "gad-stamps-section",
  "settings": [
    {
      "type": "header",
      "content": "Animación (ocupa media pantalla)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video de la animación"
    },
    {
      "type": "image_picker",
      "id": "imagen",
      "label": "Imagen (si no cargás video)"
    },
    {
      "type": "header",
      "content": "Título"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Bajada (eyebrow)",
      "default": "02 — CÓMO FUNCIONA"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título (la cursiva va en el color de resaltado)",
      "default": "Tres pasos, <em>un resultado</em>."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Bajada",
      "default": "Contá acá, en una o dos líneas, cómo funciona tu producto."
    },
    {
      "type": "header",
      "content": "Cierre"
    },
    {
      "type": "text",
      "id": "remate",
      "label": "Remate",
      "default": "Una frase de cierre que resuma el beneficio."
    },
    {
      "type": "header",
      "content": "Colores y letras (vacíos: los de la tienda)"
    },
    {
      "type": "color",
      "id": "color_fondo",
      "label": "Fondo"
    },
    {
      "type": "color",
      "id": "color_texto",
      "label": "Texto"
    },
    {
      "type": "color",
      "id": "color_acento",
      "label": "Acento (resaltados, sellos y cierre)"
    },
    {
      "type": "color",
      "id": "color_caja",
      "label": "Fondo de la animación"
    },
    {
      "type": "font_picker",
      "id": "letra_titulos",
      "label": "Letra de los títulos"
    },
    {
      "type": "font_picker",
      "id": "letra_texto",
      "label": "Letra del texto"
    }
  ],
  "blocks": [
    {
      "type": "sello",
      "name": "Sello",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "palabra",
          "label": "Palabra grande",
          "default": "PASO"
        },
        {
          "type": "text",
          "id": "texto",
          "label": "Línea corta",
          "default": "Un beneficio en pocas palabras."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Sellos animados",
      "blocks": [
        {
          "type": "sello",
          "settings": {
            "palabra": "UNO",
            "texto": "El primer paso o beneficio."
          }
        },
        {
          "type": "sello",
          "settings": {
            "palabra": "DOS",
            "texto": "El segundo paso o beneficio."
          }
        },
        {
          "type": "sello",
          "settings": {
            "palabra": "TRES",
            "texto": "El tercero, el resultado."
          }
        }
      ]
    }
  ]
}
{% endschema %}
